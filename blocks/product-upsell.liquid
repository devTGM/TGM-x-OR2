{% doc %}
  Product Upsell Block
  Renders an in-line upsell card ("Complete the Look" / "Pair It With") directly below buy buttons.
{% enddoc %}

{% render 'product-upsell', block: block %}

{% schema %}
{
  "name": "Product upsell",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "upsell_product_1",
      "label": "First upsell product",
      "info": "Leave blank to automatically recommend a complementary product"
    },
    {
      "type": "product",
      "id": "upsell_product_2",
      "label": "Second upsell product",
      "info": "Leave blank to automatically recommend a complementary product"
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Upsell collection",
      "info": "Optional: select a collection to pull products from"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair It With"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Complete the Look"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "+ Add"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Product upsell"
    }
  ]
}
{% endschema %}
