{% doc %}
  Collection Color Swatches Block
  Renders all colorways of the shirt in the same collection as interactive circular swatches.
  Places "COLOR: <COLOR_NAME>" with active concentric ring swatches matching the brand aesthetic.
{% enddoc %}

{% liquid
  assign product_resource = closest.product | default: product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% if product_resource != blank %}
  {% render 'collection-color-swatches', block: block, product: product_resource %}
{% endif %}

{% schema %}
{
  "name": "Color swatches (Collection)",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays all available colours of this shirt model from the same collection as circular swatches."
    },
    {
      "type": "text",
      "id": "label_prefix",
      "label": "Label Prefix",
      "default": "Color :"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Override",
      "info": "Optional: choose a specific collection to pull colorways from. If blank, auto-detects the shirt's collection."
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch Size (Desktop)",
      "min": 28,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "swatch_size_mobile",
      "label": "Swatch Size (Mobile)",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Color swatches (Collection)",
      "category": "Product"
    }
  ]
}
{% endschema %}
