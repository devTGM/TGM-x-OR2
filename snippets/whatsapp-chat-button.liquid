{% comment %}
  Floating WhatsApp Chat Button for ON REPEAT
  Complies with Modern Indian UX guidelines.
{% endcomment %}

<aside class="whatsapp-floating-container" aria-label="WhatsApp Support">
  <a
    href="https://wa.me/919999999999?text=Hi%20ON%20REPEAT%2C%20I%20have%20a%20question%20about%20your%20linen%20collection"
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-floating-btn"
    title="Chat with us on WhatsApp"
  >
    <svg
      class="whatsapp-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.45 0 .09 5.36.09 11.97c0 2.11.55 4.17 1.6 6L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-.12-6.22-3.52-8.43zM12.07 21.9a9.92 9.92 0 0 1-5.06-1.39l-.36-.22-3.76.99 1-3.66-.24-.38a9.9 9.9 0 0 1-1.52-5.27c0-5.48 4.46-9.94 9.95-9.94 2.66 0 5.16 1.03 7.03 2.91a9.9 9.9 0 0 1 2.91 7.04c0 5.48-4.46 9.92-9.95 9.92zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.18-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.59-.5-.51-.68-.52-.18-.01-.38-.01-.58-.01-.2 0-.53.07-.8.37-.28.3-1.07 1.05-1.07 2.56s1.1 2.97 1.25 3.17c.15.2 2.16 3.3 5.23 4.63.73.32 1.3.5 1.74.64.73.23 1.4.2 1.93.12.59-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"
      />
    </svg>
    <span class="whatsapp-label">Chat with us</span>
  </a>
</aside>

<style>
  .whatsapp-floating-container {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 990;
    pointer-events: none;
  }

  .whatsapp-floating-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background-color: #25D366;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 11px 18px 11px 15px;
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(37, 211, 102, 0.28);
    font-family: var(--font-body--family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .whatsapp-floating-btn:hover {
    background-color: #20BA56;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16), 0 3px 8px rgba(37, 211, 102, 0.35);
  }

  .whatsapp-floating-btn .whatsapp-icon {
    display: block;
    flex-shrink: 0;
  }

  .whatsapp-floating-btn .whatsapp-label {
    line-height: 1;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .whatsapp-floating-container {
      bottom: 84px;
      right: 18px;
    }

    .whatsapp-floating-btn {
      padding: 12px;
      border-radius: 50%;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    }

    .whatsapp-floating-btn .whatsapp-label {
      display: none;
    }
  }
</style>
