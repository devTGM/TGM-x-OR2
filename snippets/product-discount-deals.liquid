{% comment %}
  ON REPEAT — Minimal Luxury Linen Deals & Offers
  Aligned with brand guidelines: Warm ivory, sand borders, Cormorant Garamond headings,
  editorial typography, and understated modern DTC interactions.
{% endcomment %}

<product-deals class="luxury-deals-section" data-product-deals>
  <div class="luxury-deals__header">
    <div class="luxury-deals__label">
      <span class="luxury-deals__dot"></span>
      <span class="luxury-deals__title">EXCLUSIVE OFFERS</span>
    </div>
    <div class="luxury-deals__nav">
      <button
        type="button"
        class="luxury-deals__arrow"
        aria-label="Previous Offer"
        data-deals-prev
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        type="button"
        class="luxury-deals__arrow"
        aria-label="Next Offer"
        data-deals-next
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="luxury-deals__track" data-deals-track>
    <!-- Deal 1 -->
    <div class="luxury-deal-card">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">FIRST ORDER</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="THEFIRST10"
          aria-label="Copy code THEFIRST10"
        >
          <span class="luxury-deal-card__code-text">THEFIRST10</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Flat 10% Off</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Flat 10% off on your first order.
      </p>
    </div>

    <!-- Deal 2 -->
    <div class="luxury-deal-card">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">BUY ANY 2</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="SPECIAL10"
          aria-label="Copy code SPECIAL10"
        >
          <span class="luxury-deal-card__code-text">SPECIAL10</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Get for ₹2,519 Each</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Get it for ₹2519 when you buy any 2 items. Flat 10% off.
      </p>
    </div>

    <!-- Deal 3 -->
    <div class="luxury-deal-card">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">PREPAID ORDERS</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="FREESHIP"
          aria-label="Copy code FREESHIP"
        >
          <span class="luxury-deal-card__code-text">FREESHIP</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Free Shipping</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Free Shipping on prepaid orders.
      </p>
    </div>
  </div>

  <div class="luxury-deals__toast" data-deals-toast aria-live="polite">Code copied to clipboard!</div>
</product-deals>

<style>
  .luxury-deals-section {
    display: block;
    width: 100%;
    margin: 18px 0 20px 0;
    position: relative;
    box-sizing: border-box;
    font-family: var(--font-body--family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Duplicate suppression */
  .luxury-deals-section ~ .luxury-deals-section,
  .product-details .luxury-deals-section ~ .luxury-deals-section {
    display: none !important;
  }

  .luxury-deals__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding: 0 2px;
  }

  .luxury-deals__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .luxury-deals__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8C8275;
  }

  .luxury-deals__title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #736B63;
  }

  .luxury-deals__nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .luxury-deals__arrow {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #E6E1DA;
    color: #1C1C1C;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .luxury-deals__arrow:hover {
    border-color: #1C1C1C;
    background: #FAF8F5;
  }

  .luxury-deals__arrow:active {
    transform: scale(0.93);
  }

  .luxury-deals__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 2px 6px 2px;
  }

  .luxury-deals__track::-webkit-scrollbar {
    display: none;
  }

  .luxury-deal-card {
    flex: 0 0 240px;
    max-width: 240px;
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid #E6E1DA;
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .luxury-deal-card:hover {
    border-color: #C8C1B7;
  }

  @media screen and (max-width: 480px) {
    .luxury-deal-card {
      flex: 0 0 225px;
      max-width: 225px;
      padding: 12px 14px;
    }
  }

  .luxury-deal-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .luxury-deal-card__tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8C8275;
    line-height: 1;
  }

  .luxury-deal-card__code-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid #1C1C1C;
    background: #FAF8F5;
    color: #1C1C1C;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 4px;
    padding: 2.5px 7px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    outline: none;
    user-select: none;
    font-family: var(--font-body--family), sans-serif;
  }

  .luxury-deal-card__code-btn:hover {
    background: #1C1C1C;
    color: #FAF8F5;
  }

  .luxury-deal-card__code-btn.is-copied {
    background: #1C1C1C;
    color: #FAF8F5;
    border-color: #1C1C1C;
  }

  .luxury-deal-card__code-btn.is-copied .luxury-deal-card__copy-icon {
    display: none;
  }

  .luxury-deal-card__value {
    font-family: var(--font-heading--family), "Cormorant Garamond", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #1C1C1C;
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 2px 0 6px 0;
  }

  .luxury-deal-card__divider {
    border-top: 1px solid #EFECE6;
    margin: 6px 0 8px 0;
    width: 100%;
  }

  .luxury-deal-card__desc {
    font-size: 12px;
    color: #5C554E;
    line-height: 1.45;
    margin: 0;
    font-weight: 400;
  }

  .luxury-deals__toast {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: #1C1C1C;
    color: #FAF8F5;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 4px 12px;
    border-radius: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 10;
    white-space: nowrap;
  }

  .luxury-deals__toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(-2px);
  }
</style>

<script>
  if (!customElements.get('product-deals')) {
    class ProductDeals extends HTMLElement {
      connectedCallback() {
        const existingDeals = document.querySelectorAll('product-deals');
        if (existingDeals.length > 1 && this !== existingDeals[0]) {
          this.remove();
          return;
        }

        const track = this.querySelector('[data-deals-track]');
        const prevBtn = this.querySelector('[data-deals-prev]');
        const nextBtn = this.querySelector('[data-deals-next]');
        const toast = this.querySelector('[data-deals-toast]');

        if (prevBtn && nextBtn && track) {
          const updateArrows = () => {
            prevBtn.style.opacity = track.scrollLeft <= 5 ? '0.35' : '1';
            prevBtn.style.pointerEvents = track.scrollLeft <= 5 ? 'none' : 'auto';
            const maxScroll = track.scrollWidth - track.clientWidth - 5;
            nextBtn.style.opacity = track.scrollLeft >= maxScroll ? '0.35' : '1';
            nextBtn.style.pointerEvents = track.scrollLeft >= maxScroll ? 'none' : 'auto';
          };

          prevBtn.addEventListener('click', () => {
            track.scrollBy({ left: -240, behavior: 'smooth' });
          });
          nextBtn.addEventListener('click', () => {
            track.scrollBy({ left: 240, behavior: 'smooth' });
          });

          track.addEventListener('scroll', updateArrows, { passive: true });
          setTimeout(updateArrows, 100);
        }

        this.querySelectorAll('[data-coupon-code]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const code = btn.getAttribute('data-coupon-code');
            if (!code) return;

            const onCopied = () => {
              const originalHTML = btn.innerHTML;
              btn.classList.add('is-copied');
              btn.innerHTML = '<span>COPIED ✓</span>';

              if (toast) {
                toast.textContent = `Code ${code} copied!`;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2000);
              }

              setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.classList.remove('is-copied');
              }, 2000);
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(onCopied).catch(() => {
                fallbackCopy(code, onCopied);
              });
            } else {
              fallbackCopy(code, onCopied);
            }
          });
        });

        function fallbackCopy(text, callback) {
          const input = document.createElement('input');
          input.setAttribute('value', text);
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
          callback();
        }
      }
    }
    customElements.define('product-deals', ProductDeals);
  }
</script>
