{% comment %}
  ON REPEAT — Minimal Luxury Linen Deals & Offers
  Single-card slider: Only ONE card is visible at a time.
  Clean editorial aesthetic aligned with brand guidelines.
{% endcomment %}

<product-deals class="luxury-deals-section" data-product-deals>
  <div class="luxury-deals__header">
    <div class="luxury-deals__label">
      <span class="luxury-deals__dot"></span>
      <span class="luxury-deals__title">EXCLUSIVE OFFERS</span>
    </div>
    <div class="luxury-deals__nav">
      <div class="luxury-deals__dots" data-deals-dots>
        <button type="button" class="luxury-deals__dot-btn is-active" data-dot="0" aria-label="Offer 1 of 3"></button>
        <button type="button" class="luxury-deals__dot-btn" data-dot="1" aria-label="Offer 2 of 3"></button>
        <button type="button" class="luxury-deals__dot-btn" data-dot="2" aria-label="Offer 3 of 3"></button>
      </div>
      <div class="luxury-deals__arrows">
        <button
          type="button"
          class="luxury-deals__arrow"
          aria-label="Previous Offer"
          data-deals-prev
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="luxury-deals__arrow"
          aria-label="Next Offer"
          data-deals-next
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="luxury-deals__track" data-deals-track>
    <!-- Deal 1 -->
    <div class="luxury-deal-card" data-card-index="0">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">FIRST ORDER</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="THEFIRST10"
          aria-label="Copy code THEFIRST10"
        >
          <span class="luxury-deal-card__code-text">THEFIRST10</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Flat 10% Off</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Flat 10% off on your first order. Use code <strong>THEFIRST10</strong>.
      </p>
    </div>

    <!-- Deal 2 -->
    <div class="luxury-deal-card" data-card-index="1">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">BUY ANY 2</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="SPECIAL10"
          aria-label="Copy code SPECIAL10"
        >
          <span class="luxury-deal-card__code-text">SPECIAL10</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Get for ₹2,519 Each</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Get it for ₹2519 when you buy any 2 items. Flat 10% off with code <strong>SPECIAL10</strong>.
      </p>
    </div>

    <!-- Deal 3 -->
    <div class="luxury-deal-card" data-card-index="2">
      <div class="luxury-deal-card__header">
        <span class="luxury-deal-card__tag">PREPAID ORDERS</span>
        <button
          type="button"
          class="luxury-deal-card__code-btn"
          data-coupon-code="FREESHIP"
          aria-label="Copy code FREESHIP"
        >
          <span class="luxury-deal-card__code-text">FREESHIP</span>
          <svg class="luxury-deal-card__copy-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="luxury-deal-card__value">Free Shipping</div>
      <div class="luxury-deal-card__divider"></div>
      <p class="luxury-deal-card__desc">
        Free Shipping on prepaid orders. Use code <strong>FREESHIP</strong>.
      </p>
    </div>
  </div>

  <div class="luxury-deals__toast" data-deals-toast aria-live="polite">Code copied to clipboard!</div>
</product-deals>

<style>
  .luxury-deals-section {
    display: block;
    width: 100%;
    margin: 16px 0 18px 0;
    position: relative;
    box-sizing: border-box;
    font-family: var(--font-body--family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Duplicate suppression */
  .luxury-deals-section ~ .luxury-deals-section,
  .product-details .luxury-deals-section ~ .luxury-deals-section {
    display: none !important;
  }

  .luxury-deals__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding: 0 2px;
  }

  .luxury-deals__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .luxury-deals__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8C8275;
  }

  .luxury-deals__title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #736B63;
  }

  .luxury-deals__nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .luxury-deals__dots {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .luxury-deals__dot-btn {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D6D0C5;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .luxury-deals__dot-btn.is-active {
    background: #1C1C1C;
    width: 14px;
    border-radius: 3px;
  }

  .luxury-deals__arrows {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .luxury-deals__arrow {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #E6E1DA;
    color: #1C1C1C;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .luxury-deals__arrow:hover {
    border-color: #1C1C1C;
    background: #FAF8F5;
  }

  .luxury-deals__arrow:active {
    transform: scale(0.92);
  }

  /* Track: exactly 1 card visible */
  .luxury-deals__track {
    display: flex;
    width: 100%;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 1px 0;
  }

  .luxury-deals__track::-webkit-scrollbar {
    display: none;
  }

  /* Single Card: 100% full width */
  .luxury-deal-card {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100%;
    min-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #FFFFFF;
    border: 1px solid #E6E1DA;
    border-radius: 8px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .luxury-deal-card:hover {
    border-color: #C8C1B7;
  }

  @media screen and (max-width: 749px) {
    .luxury-deal-card {
      padding: 14px 16px;
    }
  }

  .luxury-deal-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .luxury-deal-card__tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8C8275;
    line-height: 1;
  }

  .luxury-deal-card__code-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid #1C1C1C;
    background: #FAF8F5;
    color: #1C1C1C;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 4px;
    padding: 3px 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    outline: none;
    user-select: none;
    font-family: var(--font-body--family), sans-serif;
  }

  .luxury-deal-card__code-btn:hover {
    background: #1C1C1C;
    color: #FAF8F5;
  }

  .luxury-deal-card__code-btn.is-copied {
    background: #1C1C1C;
    color: #FAF8F5;
    border-color: #1C1C1C;
  }

  .luxury-deal-card__code-btn.is-copied .luxury-deal-card__copy-icon {
    display: none;
  }

  .luxury-deal-card__value {
    font-family: var(--font-heading--family), "Cormorant Garamond", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: #1C1C1C;
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 2px 0 6px 0;
  }

  .luxury-deal-card__divider {
    border-top: 1px solid #EFECE6;
    margin: 6px 0 8px 0;
    width: 100%;
  }

  .luxury-deal-card__desc {
    font-size: 13px;
    color: #5C554E;
    line-height: 1.5;
    margin: 0;
    font-weight: 400;
  }

  .luxury-deals__toast {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: #1C1C1C;
    color: #FAF8F5;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 4px 12px;
    border-radius: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 10;
    white-space: nowrap;
  }

  .luxury-deals__toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(-2px);
  }
</style>

<script>
  if (!customElements.get('product-deals')) {
    class ProductDeals extends HTMLElement {
      connectedCallback() {
        const existingDeals = document.querySelectorAll('product-deals');
        if (existingDeals.length > 1 && this !== existingDeals[0]) {
          this.remove();
          return;
        }

        const track = this.querySelector('[data-deals-track]');
        const prevBtn = this.querySelector('[data-deals-prev]');
        const nextBtn = this.querySelector('[data-deals-next]');
        const dotBtns = this.querySelectorAll('[data-dot]');
        const toast = this.querySelector('[data-deals-toast]');
        const cards = this.querySelectorAll('.luxury-deal-card');
        const totalCards = cards.length;

        if (track && totalCards > 0) {
          const getCardWidth = () => track.clientWidth;

          const scrollToIndex = (index) => {
            const boundedIndex = Math.max(0, Math.min(index, totalCards - 1));
            track.scrollTo({
              left: boundedIndex * getCardWidth(),
              behavior: 'smooth'
            });
          };

          const updateActiveState = () => {
            const cardWidth = getCardWidth();
            if (!cardWidth) return;
            const currentIndex = Math.round(track.scrollLeft / cardWidth);

            dotBtns.forEach((dot, idx) => {
              if (idx === currentIndex) {
                dot.classList.add('is-active');
              } else {
                dot.classList.remove('is-active');
              }
            });

            if (prevBtn) {
              prevBtn.style.opacity = currentIndex === 0 ? '0.35' : '1';
              prevBtn.style.pointerEvents = currentIndex === 0 ? 'none' : 'auto';
            }
            if (nextBtn) {
              nextBtn.style.opacity = currentIndex >= totalCards - 1 ? '0.35' : '1';
              nextBtn.style.pointerEvents = currentIndex >= totalCards - 1 ? 'none' : 'auto';
            }
          };

          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              const currentIndex = Math.round(track.scrollLeft / getCardWidth());
              scrollToIndex(currentIndex - 1);
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              const currentIndex = Math.round(track.scrollLeft / getCardWidth());
              scrollToIndex(currentIndex + 1);
            });
          }

          dotBtns.forEach((dot) => {
            dot.addEventListener('click', () => {
              const targetIndex = parseInt(dot.getAttribute('data-dot'), 10);
              scrollToIndex(targetIndex);
            });
          });

          track.addEventListener('scroll', updateActiveState, { passive: true });
          setTimeout(updateActiveState, 150);
        }

        this.querySelectorAll('[data-coupon-code]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const code = btn.getAttribute('data-coupon-code');
            if (!code) return;

            const onCopied = () => {
              const originalHTML = btn.innerHTML;
              btn.classList.add('is-copied');
              btn.innerHTML = '<span>COPIED ✓</span>';

              if (toast) {
                toast.textContent = `Code ${code} copied!`;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2000);
              }

              setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.classList.remove('is-copied');
              }, 2000);
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(onCopied).catch(() => {
                fallbackCopy(code, onCopied);
              });
            } else {
              fallbackCopy(code, onCopied);
            }
          });
        });

        function fallbackCopy(text, callback) {
          const input = document.createElement('input');
          input.setAttribute('value', text);
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
          callback();
        }
      }
    }
    customElements.define('product-deals', ProductDeals);
  }
</script>
