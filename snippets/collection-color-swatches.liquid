{%- doc -%}
  Collection Color Swatches
  Renders all colorways of the shirt in the same collection as interactive circular swatches.
  Matches the quiet luxury design: "COLOR: <NAME>" with concentric active ring indicator
  and rich silk / linen draped fabric texture.

  @param {object} [block] - The block object with settings (optional)
  @param {object} [product] - The current product object
  @param {boolean} [is_embedded] - Whether rendered inside variant picker
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign current_prod = product | default: closest.product | default: product_resource
  if current_prod == blank and request.visual_preview_mode
    assign current_prod = collections.all.products.first
  endif
-%}

{%- if current_prod != blank -%}
  {%- liquid
    # 1. Parse current product title, handle, and color
    assign current_title = current_prod.title
    assign current_handle = current_prod.handle
    assign h_lower = current_handle | downcase
    assign base_title = current_title
    assign current_color = ''

    if current_title contains ' - '
      assign title_parts = current_title | split: ' - '
      assign base_title = title_parts[0] | strip
      assign current_color = title_parts[1] | strip
    elsif current_title contains ' — '
      assign title_parts = current_title | split: ' — '
      assign base_title = title_parts[0] | strip
      assign current_color = title_parts[1] | strip
    elsif current_title contains ' – '
      assign title_parts = current_title | split: ' – '
      assign base_title = title_parts[0] | strip
      assign current_color = title_parts[1] | strip
    elsif current_title contains ' : '
      assign title_parts = current_title | split: ' : '
      assign base_title = title_parts[0] | strip
      assign current_color = title_parts[1] | strip
    elsif current_title contains ' ('
      assign title_parts = current_title | split: ' ('
      assign base_title = title_parts[0] | strip
      assign current_color = title_parts[1] | remove: ')' | strip
    endif

    # Detect base prefix and color from handle
    assign base_handle_prefix = current_handle
    assign color_words = 'optic-white,aegean-blue,sunset-rose,raw-oat,midnight-breeze,dusty-olive,mist-green,solar-yellow,white,black,blue,navy,dune,beige,sand,rose,pink,oat,cream,cacao,brown,olive,green,terracotta,rust,sage,yellow,charcoal,grey,gray' | split: ','
    for cw in color_words
      assign check_suffix = '-' | append: cw
      if h_lower contains check_suffix
        assign base_handle_prefix = h_lower | remove: check_suffix
        break
      endif
    endfor

    if h_lower contains 'sunset-rose'
      assign current_color = 'Sunset Rose'
    elsif h_lower contains 'optic-white'
      assign current_color = 'Optic White'
    elsif h_lower contains 'aegean-blue'
      assign current_color = 'Aegean Blue'
    elsif h_lower contains 'raw-oat'
      assign current_color = 'Raw Oat'
    elsif h_lower contains 'midnight-breeze'
      assign current_color = 'Midnight Breeze'
    elsif h_lower contains 'dusty-olive'
      assign current_color = 'Dusty Olive'
    elsif h_lower contains 'mist-green'
      assign current_color = 'Mist Green'
    elsif h_lower contains 'solar-yellow'
      assign current_color = 'Solar Yellow'
    elsif h_lower contains 'dune'
      assign current_color = 'Dune'
    elsif h_lower contains 'cacao'
      assign current_color = 'Cacao'
    elsif h_lower contains 'terracotta'
      assign current_color = 'Terracotta'
    endif

    # Known ON REPEAT shirt family models
    if h_lower contains 'smart-casual'
      assign base_title = 'The Smart Casual Shirt'
      assign base_handle_prefix = 'the-smart-casual-shirt'
    elsif h_lower contains 'popover'
      assign base_title = 'The Popover Shirt'
      assign base_handle_prefix = 'the-popover-shirt'
    elsif h_lower contains 'cuban'
      assign base_title = 'The Cuban Collar Shirt'
      assign base_handle_prefix = 'the-cuban-collar-shirt'
    elsif h_lower contains 'classic'
      assign base_title = 'Classic Shirt'
      assign base_handle_prefix = 'classic-shirt'
      if h_lower contains 'the-classic'
        assign base_title = 'The Classic Shirt'
        assign base_handle_prefix = 'the-classic-shirt'
      endif
    endif

    # Check for single-product Color variant option
    assign has_color_variant_option = false
    assign color_variant_option = blank
    for opt in current_prod.options_with_values
      assign opt_name_lower = opt.name | downcase
      if opt_name_lower == 'color' or opt_name_lower == 'colour' or opt_name_lower == 'shade'
        if opt.values.size > 1
          assign has_color_variant_option = true
          assign color_variant_option = opt
        endif
        if current_color == blank
          assign current_color = opt.selected_value
        endif
        break
      endif
    endfor

    if current_color == blank and current_prod.metafields.custom.color != blank
      assign current_color = current_prod.metafields.custom.color
    endif
    if current_color == blank
      assign current_color = current_title
    endif

    # 2. Discover Sibling Products in the same collection
    assign target_collection = blank

    # From active collection URL
    if collection != blank and collection.products.size > 1
      assign target_collection = collection
    endif

    # From block settings override
    if target_collection == blank and block_settings.collection != blank
      assign target_collection = block_settings.collection
    endif

    # From product's own collections — prefer the most specific (smallest) collection
    if target_collection == blank and current_prod.collections.size > 0
      assign best_coll_size = 9999
      for coll in current_prod.collections
        if coll.handle != 'all' and coll.handle != 'frontpage'
          if coll.products.size >= 2 and coll.products.size < best_coll_size
            assign target_collection = coll
            assign best_coll_size = coll.products.size
          endif
        endif
      endfor
    endif

    # Collect sibling handles — STRICT matching: only products that share the base handle prefix
    assign siblings_list = ''

    if target_collection != blank and target_collection.products.size > 0
      for p in target_collection.products
        assign is_sibling = false
        # Primary match: handle must contain the base_handle_prefix
        if p.handle contains base_handle_prefix and base_handle_prefix != ''
          assign is_sibling = true
        # Secondary match: title must start with base_title (same product family)
        elsif p.title contains base_title and base_title != '' and base_title != p.title
          assign is_sibling = true
        # Tertiary match: same product.type AND current product has a recognised type
        elsif p.type == current_prod.type and current_prod.type != blank and p.type != blank
          assign is_sibling = true
        endif

        if is_sibling
          assign siblings_list = siblings_list | append: p.handle | append: ','
        endif
      endfor
    endif

    # Known catalog families for ON REPEAT shirts as fallback guarantee (only if no siblings found in collection)
    if siblings_list == blank
      if h_lower contains 'smart-casual'
        assign siblings_list = siblings_list | append: 'the-smart-casual-shirt-optic-white,the-smart-casual-shirt-aegean-blue,the-smart-casual-shirt-dune,the-smart-casual-shirt-sunset-rose,'
      elsif h_lower contains 'popover'
        assign siblings_list = siblings_list | append: 'the-popover-shirt-raw-oat,the-popover-shirt-cacao,the-popover-shirt-midnight-breeze,'
      elsif h_lower contains 'cuban'
        assign siblings_list = siblings_list | append: 'the-cuban-collar-shirt-dusty-olive,the-cuban-collar-shirt-terracotta,the-cuban-collar-shirt-mist-green,the-cuban-collar-shirt-solar-yellow,'
      endif
    endif

    # Search store collections if still only 1
    if siblings_list == blank
      assign fallback_colls = 'shirts,the-classic,the-modern,bestsellers,all' | split: ','
      for fc in fallback_colls
        assign f_coll = collections[fc]
        if f_coll != blank and f_coll.products.size > 0
          for p in f_coll.products
            if p.handle contains base_handle_prefix or p.title contains base_title
              assign siblings_list = siblings_list | append: p.handle | append: ','
            endif
          endfor
          if siblings_list != blank
            break
          endif
        endif
      endfor
    endif

    # Always prepend current product
    assign siblings_list = current_handle | append: ',' | append: siblings_list
    assign raw_handles = siblings_list | split: ','
    assign final_handles = ''
    for h in raw_handles
      assign h_clean = h | strip
      if h_clean != '' and h_clean != blank
        unless final_handles contains h_clean
          if final_handles == ''
            assign final_handles = h_clean
          else
            assign final_handles = final_handles | append: ',' | append: h_clean
          endif
        endunless
      endif
    endfor
    assign handles_arr = final_handles | split: ','

    # Proportions aligned with brand specifications
    assign swatch_size = block_settings.swatch_size | default: 34
    assign swatch_size_mobile = block_settings.swatch_size_mobile | default: 32
  -%}

  <div
    class="collection-color-swatches-block{% if is_embedded %} color-swatches--embedded{% endif %} variant-option"
    id="ColorSwatches-{% if is_embedded %}embedded-{% endif %}{{ block.id | default: section.id }}"
    style="
      --swatch-size: {{ swatch_size }}px;
      --swatch-size-mobile: {{ swatch_size_mobile }}px;
    "
    {% if block %} {{ block.shopify_attributes }} {% endif %}
  >
    <!-- Brand Option Header: Color : <Shade> -->
    <div class="variant-option__legend-row color-swatches__header">
      <span class="variant-option__legend-title color-swatches__label-title">
        {{- block_settings.label_prefix | default: 'Color :' }}
        <strong
          class="variant-option__selected-value color-swatches__label-name"
          data-active-color="{{ current_color | escape }}"
        >
          {{- current_color -}}
        </strong>
      </span>
    </div>

    <!-- Circular Fabric Color Swatches Row (Pure Fabric Colours, No Picture Thumbnails) -->
    <div
      class="color-swatches__list"
      role="list"
      aria-label="Available Colors"
    >
      {%- if handles_arr.size > 1 or has_color_variant_option == false -%}
        {%- for handle in handles_arr -%}
          {%- liquid
            if handle == current_prod.handle
              assign sibling = current_prod
            else
              assign sibling = all_products[handle]
            endif

            if sibling == blank and target_collection != blank
              for p in target_collection.products
                if p.handle == handle
                  assign sibling = p
                  break
                endif
              endfor
            endif
          -%}
          {%- if sibling != blank -%}
            {%- liquid
              assign s_title = sibling.title
              assign s_h_lower = sibling.handle | downcase
              assign s_color = ''

              if s_title contains ' - '
                assign s_color = s_title | split: ' - ' | last | strip
              elsif s_title contains ' — '
                assign s_color = s_title | split: ' — ' | last | strip
              elsif s_title contains ' – '
                assign s_color = s_title | split: ' – ' | last | strip
              elsif s_title contains ' : '
                assign s_color = s_title | split: ' : ' | last | strip
              elsif s_title contains ' ('
                assign s_color = s_title | split: ' (' | last | remove: ')' | strip
              endif

              if s_h_lower contains 'optic-white'
                assign s_color = 'Optic White'
              elsif s_h_lower contains 'aegean-blue'
                assign s_color = 'Aegean Blue'
              elsif s_h_lower contains 'dune'
                assign s_color = 'Dune'
              elsif s_h_lower contains 'sunset-rose'
                assign s_color = 'Sunset Rose'
              elsif s_h_lower contains 'raw-oat'
                assign s_color = 'Raw Oat'
              elsif s_h_lower contains 'cacao'
                assign s_color = 'Cacao'
              elsif s_h_lower contains 'midnight-breeze'
                assign s_color = 'Midnight Breeze'
              elsif s_h_lower contains 'dusty-olive'
                assign s_color = 'Dusty Olive'
              elsif s_h_lower contains 'terracotta'
                assign s_color = 'Terracotta'
              elsif s_h_lower contains 'mist-green'
                assign s_color = 'Mist Green'
              elsif s_h_lower contains 'solar-yellow'
                assign s_color = 'Solar Yellow'
              elsif s_color == blank or s_color == s_title
                assign s_color = s_title
              endif

              # Pure Fabric Colour Swatches (No Pictures)
              assign s_color_lower = s_color | downcase
              assign fabric_style = 'background: #F5F3EF linear-gradient(135deg, #FAF8F5 0%, #EAE7E1 100%);'

              if sibling.metafields.custom.color_hex != blank
                assign custom_hex = sibling.metafields.custom.color_hex
                assign fabric_style = 'background-color: ' | append: custom_hex | append: ';'
              elsif sibling.metafields.custom.hex != blank
                assign custom_hex = sibling.metafields.custom.hex
                assign fabric_style = 'background-color: ' | append: custom_hex | append: ';'
              else
                if s_color_lower contains 'pink' or s_color_lower contains 'rose' or s_color_lower contains 'sunset'
                  # Sunset Rose / Pink fabric
                  assign fabric_style = 'background: #BA9A91 linear-gradient(135deg, #CFADA0 0%, #BA998F 45%, #AA877D 100%);'
                elsif s_color_lower contains 'cacao' or s_color_lower contains 'brown' or s_color_lower contains 'espresso' or s_color_lower contains 'chocolate'
                  # Dark Cacao / Espresso fabric
                  assign fabric_style = 'background: #2B211B linear-gradient(135deg, #3D2F27 0%, #291E18 45%, #1B130E 100%);'
                elsif s_color_lower contains 'terracotta' or s_color_lower contains 'rust' or s_color_lower contains 'wine' or s_color_lower contains 'burgundy'
                  # Terracotta / Rust Wine fabric
                  assign fabric_style = 'background: #6D2C24 linear-gradient(135deg, #7F372E 0%, #682720 45%, #4F1B15 100%);'
                elsif s_color_lower contains 'silver' or s_color_lower contains 'grey' or s_color_lower contains 'gray' or s_color_lower contains 'charcoal'
                  # Silver / Heather Grey fabric
                  assign fabric_style = 'background: #A2A09E linear-gradient(135deg, #B5B3B1 0%, #9F9D9B 45%, #888684 100%);'
                elsif s_color_lower contains 'mist' or s_color_lower contains 'sage'
                  # Mist Green / Sage fabric
                  assign fabric_style = 'background: #A2B2A8 linear-gradient(135deg, #B5C4BB 0%, #9FB0A6 45%, #88998F 100%);'
                elsif s_color_lower contains 'olive' or s_color_lower contains 'dusty'
                  # Dusty Olive fabric
                  assign fabric_style = 'background: #474B32 linear-gradient(135deg, #595E40 0%, #44482F 45%, #30341F 100%);'
                elsif s_color_lower contains 'white' or s_color_lower contains 'optic'
                  # Optic White luxury linen fabric
                  assign fabric_style = 'background: #FFFFFF linear-gradient(135deg, #FFFFFF 0%, #F5F3EF 50%, #ECE9E3 100%);'
                elsif s_color_lower contains 'aegean' or s_color_lower contains 'blue'
                  # Aegean Blue slate fabric
                  assign fabric_style = 'background: #4A677E linear-gradient(135deg, #5C7A92 0%, #48657B 45%, #355065 100%);'
                elsif s_color_lower contains 'dune' or s_color_lower contains 'sand' or s_color_lower contains 'beige'
                  # Dune sand linen fabric
                  assign fabric_style = 'background: #C2B39F linear-gradient(135deg, #D4C6B3 0%, #C0B09C 45%, #A79783 100%);'
                elsif s_color_lower contains 'oat' or s_color_lower contains 'cream' or s_color_lower contains 'ecru'
                  # Raw Oat natural linen fabric
                  assign fabric_style = 'background: #DDD5C7 linear-gradient(135deg, #EBE4D8 0%, #DCD3C5 45%, #C8BEAF 100%);'
                elsif s_color_lower contains 'breeze' or s_color_lower contains 'navy' or s_color_lower contains 'midnight'
                  # Midnight Navy Breeze fabric
                  assign fabric_style = 'background: #222D3E linear-gradient(135deg, #303E54 0%, #1F2939 45%, #141B26 100%);'
                elsif s_color_lower contains 'yellow' or s_color_lower contains 'solar' or s_color_lower contains 'gold'
                  # Solar Yellow fabric
                  assign fabric_style = 'background: #DCA745 linear-gradient(135deg, #EAB756 0%, #D8A33F 45%, #BF8C2A 100%);'
                elsif s_color_lower contains 'black'
                  # Deep Black fabric
                  assign fabric_style = 'background: #1C1C1C linear-gradient(135deg, #2D2D2D 0%, #1A1A1A 45%, #0F0F0F 100%);'
                endif
              endif

              assign is_active = false
              if sibling.id == current_prod.id or sibling.handle == current_prod.handle
                assign is_active = true
              endif
            -%}

            <a
              href="{{ sibling.url }}"
              class="color-swatch-item{% if is_active %} is-selected{% endif %}"
              data-color-name="{{ s_color | escape }}"
              title="{{ s_color | escape }}"
              aria-label="{{ s_color | escape }}{% unless sibling.available %} - Sold Out{% endunless %}"
              role="listitem"
              {% if is_active %}aria-current="page"{% endif %}
            >
              <span class="color-swatch-ring">
                <span class="color-swatch-inner" style="{{ fabric_style }}"></span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif has_color_variant_option and color_variant_option != blank -%}
        {%- for val in color_variant_option.values -%}
          {%- liquid
            assign is_active = false
            if val == color_variant_option.selected_value
              assign is_active = true
            endif

            assign val_lower = val | downcase
            assign fabric_style = 'background: #F5F3EF linear-gradient(135deg, #FAF8F5 0%, #EAE7E1 100%);'
            if val_lower contains 'pink' or val_lower contains 'rose' or val_lower contains 'sunset'
              assign fabric_style = 'background: #BA9A91 linear-gradient(135deg, #CFADA0 0%, #BA998F 45%, #AA877D 100%);'
            elsif val_lower contains 'cacao' or val_lower contains 'brown' or val_lower contains 'espresso'
              assign fabric_style = 'background: #2B211B linear-gradient(135deg, #3D2F27 0%, #291E18 45%, #1B130E 100%);'
            elsif val_lower contains 'terracotta' or val_lower contains 'rust'
              assign fabric_style = 'background: #6D2C24 linear-gradient(135deg, #7F372E 0%, #682720 45%, #4F1B15 100%);'
            elsif val_lower contains 'blue' or val_lower contains 'aegean'
              assign fabric_style = 'background: #4A677E linear-gradient(135deg, #5C7A92 0%, #48657B 45%, #355065 100%);'
            elsif val_lower contains 'dune' or val_lower contains 'beige' or val_lower contains 'sand'
              assign fabric_style = 'background: #C2B39F linear-gradient(135deg, #D4C6B3 0%, #C0B09C 45%, #A79783 100%);'
            elsif val_lower contains 'oat' or val_lower contains 'cream'
              assign fabric_style = 'background: #DDD5C7 linear-gradient(135deg, #EBE4D8 0%, #DCD3C5 45%, #C8BEAF 100%);'
            elsif val_lower contains 'breeze' or val_lower contains 'navy'
              assign fabric_style = 'background: #222D3E linear-gradient(135deg, #303E54 0%, #1F2939 45%, #141B26 100%);'
            elsif val_lower contains 'olive' or val_lower contains 'dusty'
              assign fabric_style = 'background: #474B32 linear-gradient(135deg, #595E40 0%, #44482F 45%, #30341F 100%);'
            elsif val_lower contains 'mist' or val_lower contains 'sage'
              assign fabric_style = 'background: #A2B2A8 linear-gradient(135deg, #B5C4BB 0%, #9FB0A6 45%, #88998F 100%);'
            elsif val_lower contains 'yellow' or val_lower contains 'solar'
              assign fabric_style = 'background: #DCA745 linear-gradient(135deg, #EAB756 0%, #D8A33F 45%, #BF8C2A 100%);'
            elsif val_lower contains 'white' or val_lower contains 'optic'
              assign fabric_style = 'background: #FFFFFF linear-gradient(135deg, #FFFFFF 0%, #F5F3EF 50%, #ECE9E3 100%);'
            elsif val_lower contains 'black'
              assign fabric_style = 'background: #1C1C1C linear-gradient(135deg, #2D2D2D 0%, #1A1A1A 45%, #0F0F0F 100%);'
            endif
          -%}

          <button
            type="button"
            class="color-swatch-item{% if is_active %} is-selected{% endif %}"
            data-color-name="{{ val | escape }}"
            title="{{ val | escape }}"
            aria-label="{{ val | escape }}"
            role="listitem"
            {% if is_active %}aria-current="true"{% endif %}
            onclick="
              const picker = document.querySelector('variant-picker');
              if (picker) {
                const input = picker.querySelector('input[value={{ val | escape | json }}]');
                if (input) { input.click(); }
              }
            "
          >
            <span class="color-swatch-ring">
              <span class="color-swatch-inner" style="{{ fabric_style }}"></span>
            </span>
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <style>
    .collection-color-swatches-block {
      width: 100% !important;
      box-sizing: border-box !important;
      margin: 0 0 18px 0 !important;
      padding: 0 !important;
      border: none !important;
      border-top: none !important;
    }

    .collection-color-swatches-block * {
      box-sizing: border-box;
    }

    /* Prevent duplicate rendering if standalone block exists */
    .collection-color-swatches-block:not(.color-swatches--embedded) ~ variant-picker .color-swatches--embedded,
    .product-details > .collection-color-swatches-block ~ * .color-swatches--embedded {
      display: none !important;
    }

    /* Brand Header matching Size selector */
    .color-swatches__header.variant-option__legend-row {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin-bottom: 12px !important;
      padding: 0 !important;
      border: none !important;
    }

    .color-swatches__label-title.variant-option__legend-title {
      font-size: 14.5px !important;
      color: #374151 !important;
      font-weight: 400 !important;
      font-family: var(--font-body--family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif) !important;
      letter-spacing: -0.01em !important;
      line-height: 1.3 !important;
      text-transform: none !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 4px !important;
    }

    .color-swatches__label-name.variant-option__selected-value {
      font-weight: 600 !important;
      color: #111827 !important;
      text-transform: none !important;
      transition: opacity 0.12s ease;
    }

    /* Swatches Flex Row matching brand alignment */
    .color-swatches__list {
      display: flex !important;
      flex-wrap: wrap !important;
      align-items: center !important;
      gap: 10px !important;
      row-gap: 10px !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
    }

    /* Individual Swatch Item */
    .color-swatch-item {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      text-decoration: none !important;
      cursor: pointer !important;
      border-radius: 50% !important;
      padding: 0 !important;
      background: transparent !important;
      border: none !important;
      outline: none !important;
      transition: transform 0.15s ease !important;
      -webkit-tap-highlight-color: transparent !important;
      position: relative !important;
      flex-shrink: 0 !important;
    }

    .color-swatch-item:hover {
      transform: scale(1.06) !important;
    }

    .color-swatch-item:focus-visible {
      outline: 2px solid #111827 !important;
      outline-offset: 3px !important;
    }

    /* Concentric Swatch Ring matching brand specs:
       - Outer diameter: 34px on desktop, 32px on mobile
       - Inactive outer border: 1.5px solid #E5E7EB
       - Active outer border: 2px solid #111827
       - Concentric white gap: 2px
       - Inner circle: pure fabric colour
    */
    .color-swatch-ring {
      width: var(--swatch-size, 34px);
      height: var(--swatch-size, 34px);
      border-radius: 50%;
      padding: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #FFFFFF;
      border: 1.5px solid #E5E7EB;
      box-sizing: border-box;
      transition: border-color 0.15s ease;
    }

    .color-swatch-item:hover .color-swatch-ring {
      border-color: #9CA3AF;
    }

    /* Active / Selected Swatch with crisp black brand ring */
    .color-swatch-item.is-selected .color-swatch-ring {
      border: 2px solid #111827;
    }

    /* Inner circle holding pure fabric colour (NO IMAGES) */
    .color-swatch-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
      position: relative;
      box-sizing: border-box;
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12);
    }

    /* Luxury woven fabric subtle sheen */
    .color-swatch-inner::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.22) 0%,
        rgba(255, 255, 255, 0.04) 40%,
        rgba(0, 0, 0, 0.08) 100%
      );
      pointer-events: none;
    }

    /* Mobile view */
    @media screen and (max-width: 749px) {
      .color-swatch-ring {
        width: var(--swatch-size-mobile, 32px);
        height: var(--swatch-size-mobile, 32px);
        padding: 2px;
      }

      .color-swatches__list {
        gap: 8px;
      }
    }
  </style>

  <script>
    (function () {
      // Prevent duplicate instances if both block and embedded exist
      const allInstances = document.querySelectorAll('.collection-color-swatches-block');
      if (allInstances.length > 1) {
        const embeddedInstances = document.querySelectorAll('.color-swatches--embedded');
        embeddedInstances.forEach(el => el.remove());
      }

      const container = document.getElementById('ColorSwatches-{% if is_embedded %}embedded-{% endif %}{{ block.id | default: section.id }}');
      if (!container) return;

      const labelName = container.querySelector('.color-swatches__label-name');
      const swatches = container.querySelectorAll('.color-swatch-item');
      if (!labelName || !swatches.length) return;

      const activeColor = labelName.getAttribute('data-active-color') || '';

      swatches.forEach((swatch) => {
        const colorName = swatch.getAttribute('data-color-name');
        if (!colorName) return;

        swatch.addEventListener('mouseenter', function () {
          labelName.textContent = colorName;
        });

        swatch.addEventListener('mouseleave', function () {
          labelName.textContent = activeColor;
        });
      });
    })();
  </script>
{%- endif -%}
