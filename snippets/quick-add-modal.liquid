<script
  src="{{ 'gift-card-recipient-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'dialog-styles' %}

<quick-add-dialog id="quick-add-dialog">
  <dialog
    class="quick-add-modal dialog-modal color-custom-popover"
    ref="dialog"
    scroll-lock
  >
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button quick-add-modal__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <product-component
      id="quick-add-modal-content"
      class="quick-add-modal__content"
      view-event-trigger="dialog"
    ></product-component>

    <p class="quick-add-modal__trust-strip">
      Free Shipping &bull; 60-Day Returns &amp; Exchanges &bull; Ships in 24 Hours
    </p>
    <div class="quick-add-modal__view-details">
      <a ref="viewDetailsLink" href="#" class="quick-add-modal__view-details-link">VIEW DETAILS &amp; OFFERS</a>
    </div>
  </dialog>
</quick-add-dialog>

{% render 'product-media-container-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'quick-add-custom-styles' %}
{% render 'product-media-gallery-content-styles' %}
{% render 'payment-terms-styles' %}

