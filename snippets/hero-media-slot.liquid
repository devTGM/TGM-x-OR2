{%- doc -%}
  Renders a single media item (image or video with mobile art direction support) for a hero section slot.
{%- enddoc -%}

{%- if media_type == 'image' and media_type_mobile == 'image' -%}
  <picture data-testid="hero-picture-{{ slot_num }}" class="hero__media">
    <source
      media="(max-width: 749px)"
      srcset="
        {%- for mobile_width in mobile_widths_array -%}
          {{ image_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      "
      sizes="{{ sizes_mobile }}"
      width="{{ image_mobile.width }}"
      height="{{ image_mobile.height }}"
    >
    {{
      image
      | image_url: width: 3840
      | image_tag:
        width: image.width,
        widths: widths,
        height: image.height,
        alt: image.alt,
        class: 'hero__media',
        sizes: sizes,
        fetchpriority: fetch_priority,
        data-testid: 'hero-desktop-image-' | append: slot_num
    }}
  </picture>
{%- elsif media_type == 'image' -%}
  <div class="{{ media_wrapper_desktop_class }}">
    {{
      image
      | image_url: width: 3840
      | image_tag:
        width: image.width,
        widths: widths,
        height: image.height,
        alt: image.alt,
        class: 'hero__media',
        sizes: sizes,
        fetchpriority: fetch_priority,
        data-testid: 'hero-desktop-image-' | append: slot_num
    }}
  </div>
{%- endif -%}

{%- if media_type == 'video' -%}
  <div class="{{ media_wrapper_desktop_class }}">
    {{
      video
      | video_tag:
        poster: nil,
        autoplay: true,
        loop: true,
        controls: false,
        muted: true,
        class: 'hero__media',
        data-testid: 'hero-desktop-video-' | append: slot_num
    }}
  </div>
{%- endif -%}

{%- comment -%} Mobile-only slot media (when desktop is different type) {%- endcomment -%}
{%- if media_count > 0 and media_count_mobile > 0 -%}
  {%- if media_type_mobile == 'image' and media_type != 'image' -%}
    <div class="{{ media_wrapper_mobile_class }}">
      {{
        image_mobile
        | image_url: width: 1600
        | image_tag:
          width: image_mobile.width,
          widths: mobile_widths,
          height: image_mobile.height,
          alt: image_mobile.alt,
          class: 'hero__media',
          sizes: sizes_mobile,
          fetchpriority: fetch_priority,
          data-testid: 'hero-mobile-image-' | append: slot_num
      }}
    </div>
  {%- endif -%}

  {%- if media_type_mobile == 'video' -%}
    <div class="{{ media_wrapper_mobile_class }}">
      {{
        video_mobile
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'hero__media',
          data-testid: 'hero-mobile-video-' | append: slot_num
      }}
    </div>
  {%- endif -%}
{%- endif -%}
