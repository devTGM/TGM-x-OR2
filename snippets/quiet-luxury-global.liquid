  /* ------------------------------------------------------------------
     15. MOBILE HERO GAP — DEFINITIVE FIX
     Override --hero-height-offset directly at the point of consumption
     in hero.liquid.
     When header is transparent: hero takes full viewport (0px offset).
     When header is solid: hero takes calc(100svh - 44px).
  ------------------------------------------------------------------ */
  @media screen and (max-width: 749px) {
    /* For solid headers, offset hero by 44px mobile header height */
    body:not(:has(#header-component[transparent])) .hero-wrapper:first-child {
      --hero-height-offset: 44px !important;
    }
    body:not(:has(#header-component[transparent])) .hero-wrapper:first-child > .hero,
    body:not(:has(#header-component[transparent])) .hero-wrapper:first-child .hero {
      min-height: calc(100svh - 44px) !important;
    }

    /* For transparent headers, hero goes full height behind the floating header */
    body:has(#header-component[transparent]) .hero-wrapper:first-child {
      --hero-height-offset: 0px !important;
    }
    body:has(#header-component[transparent]) .hero-wrapper:first-child > .hero,
    body:has(#header-component[transparent]) .hero-wrapper:first-child .hero {
      min-height: 100svh !important;
    }
  }

{% endstyle %}

{% comment %} HEADER OFFSET & HEIGHT CLAMP — intercept JS header height & offset variables {% endcomment %}
<script>
(function() {
  if (typeof window === 'undefined') return;

  var MOBILE_HEADER_HEIGHT = '44px';

  // 1. Intercept ALL future body.style.setProperty calls for header height variables and offset boolean
  var _origSet = CSSStyleDeclaration.prototype.setProperty;
  CSSStyleDeclaration.prototype.setProperty = function(prop, value, priority) {
    if (prop === '--transparent-header-offset-boolean') {
      value = '0';
    }
    if ((prop === '--header-group-height' || prop === '--header-height') && window.innerWidth < 750) {
      value = MOBILE_HEADER_HEIGHT;
    }
    return _origSet.call(this, prop, value, priority);
  };

  // 2. Clamp body CSS custom properties, header group flow, and hero-wrapper inline style
  function clampHeaderHeights() {
    var header = document.querySelector('#header-component');
    var isHome = (document.body && document.body.classList.contains('template-index')) || window.location.pathname === '/' || window.location.pathname === '';
    var isTransparent = (header && header.hasAttribute('transparent')) || isHome;

    // Always ensure skip-to-content-link never displaces page wrapper
    var skipLink = document.querySelector('.skip-to-content-link');
    if (skipLink && document.activeElement !== skipLink) {
      skipLink.style.display = 'none';
      skipLink.style.position = 'fixed';
      skipLink.style.top = '-9999px';
      skipLink.style.left = '-9999px';
    }

    if (document.body) {
      if (isTransparent) {
        _origSet.call(document.body.style, '--transparent-header-offset-boolean', '0');
        _origSet.call(document.body.style, '--section-top-offset', '0px');
      }
      if (window.innerWidth < 750) {
        _origSet.call(document.body.style, '--header-group-height', MOBILE_HEADER_HEIGHT);
        _origSet.call(document.body.style, '--header-height', MOBILE_HEADER_HEIGHT);
      }
    }

    if (isTransparent) {
      var headerGroup = document.querySelector('#header-group');
      if (headerGroup) {
        headerGroup.style.margin = '0px';
        headerGroup.style.padding = '0px';
      }
      var mainContent = document.querySelector('#MainContent');
      if (mainContent) {
        mainContent.style.marginTop = '0px';
        mainContent.style.paddingTop = '0px';
        mainContent.style.setProperty('--margin-block-start', '0px');
        mainContent.style.setProperty('--padding-block-start', '0px');
      }
      var heroWrapper = document.querySelector('#MainContent > .shopify-section:first-child') || document.querySelector('.hero-wrapper');
      if (heroWrapper) {
        heroWrapper.style.setProperty('--hero-height-offset', '0px');
        heroWrapper.style.setProperty('--margin-block-start', '0px');
        heroWrapper.style.setProperty('--padding-block-start', '0px');
        heroWrapper.style.marginTop = '0px';
        heroWrapper.style.paddingTop = '0px';
      }
    }
  }

  // Restore skip link on keyboard tab navigation for accessibility
  window.addEventListener('keydown', function(e) {
    if (e.key === 'Tab') {
      var skipLink = document.querySelector('.skip-to-content-link');
      if (skipLink) skipLink.style.display = '';
    }
  });

  // Run immediately and on animation frames
  clampHeaderHeights();
  if (typeof requestAnimationFrame !== 'undefined') {
    requestAnimationFrame(clampHeaderHeights);
  }

  // Run after DOM is ready (catches the mid-parse measureHeaderHeights call)
  document.addEventListener('DOMContentLoaded', clampHeaderHeights);
  // Run after full page load (catches ResizeObserver-based updates from header.js)
  window.addEventListener('load', clampHeaderHeights);
  // Also run on resize
  window.addEventListener('resize', clampHeaderHeights);
})();
</script>
