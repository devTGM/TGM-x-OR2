{% style %}
  /* ==========================================================================
     ON REPEAT — QUIET LUXURY GLOBAL STYLES
     Inspired by linendebeaumont.com
     Parchment palette · Editorial typography · Minimal spacing
     ========================================================================== */

  /* ------------------------------------------------------------------
     1. GLOBAL RESET & BACKGROUND
     ------------------------------------------------------------------ */
  body,
  .page-wrapper {
    background-color: #F2EFE9 !important;
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 400 !important;
    font-size: 16.5px !important;
    line-height: 1.75 !important;
    color: #1C1C1C !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
  }

  /* Warm background across all panels */
  .cart-drawer,
  .popover,
  [data-menu-drawer],
  .drawer,
  .search-modal,
  .quick-add-modal,
  .predictive-search {
    background-color: #F2EFE9 !important;
  }

  /* Ensure page top is flush — zero margins and paddings on root containers */
  html,
  body,
  .page-wrapper {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Header group & header components strictly flush with zero extra space */
  #header-group,
  .header-section,
  #header-component,
  .header,
  .header__row {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }

  #header-group,
  .header-section,
  #header-component,
  .header {
    height: auto !important;
    min-height: 0 !important;
    max-height: max-content !important;
  }

  /* Prevent mobile drawer wrapper from imposing 60px min-height on header row */
  @media screen and (min-width: 750px) {
    .header__drawer {
      display: none !important;
      min-height: 0 !important;
      height: 0 !important;
    }
  }

  @media screen and (max-width: 749px) {
    .header__drawer {
      min-height: 44px !important;
      height: 44px !important;
    }
  }

  /* Hide any disabled or phantom announcement bar in header-group */
  #header-group:has(.announcement-bar[aria-hidden="true"]) .shopify-section:has(.announcement-bar),
  #header-group .shopify-section:has(.announcement-bar[aria-hidden="true"]),
  #header-group .header-announcements[aria-hidden="true"],
  #header-group .shopify-section:empty {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Ensure transparent header sits flush at top: 0 */
  .header[transparent] {
    top: 0 !important;
  }

  #MainContent,
  .content-for-layout {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* Collapse any empty or disabled shopify sections in DOM / Theme Editor */
  .shopify-section:empty,
  .shopify-section[style*="display: none"],
  .shopify-section[aria-hidden="true"],
  .shopify-section:has(.hero[style*="display: none"]),
  .shopify-section:has(.divider[aria-hidden="true"]) {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 0 !important;
    min-height: 0 !important;
  }

  /* Universal flush hero & banner rules — applies to ALL heroes across the site */
  .hero-wrapper,
  .hero-wrapper .hero,
  .hero-wrapper .hero__container,
  .hero-wrapper .hero__media-grid,
  .hero,
  .hero__container,
  .hero__media-grid,
  .brand-banners-section,
  .layered-slideshow-section {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-block-start: 0 !important;
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
  }

  .hero .hero__container.spacing-style,
  .hero-wrapper .hero__container.spacing-style,
  .hero__container.spacing-style {
    padding-block-start: 0 !important;
    margin-block-start: 0 !important;
    --padding-block-start: 0px !important;
    --margin-block-start: 0px !important;
    --section-top-offset: 0px !important;
  }

  /* First visible section in #MainContent sits directly flush against header bottom border */
  #MainContent > .shopify-section:first-child,
  main > .shopify-section:first-child,
  .main-content > .shopify-section:first-child,
  #MainContent > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  .content-for-layout > .shopify-section:first-child,
  .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  #MainContent > .shopify-section:first-child > *:first-child,
  main > .shopify-section:first-child > *:first-child {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-block-start: 0 !important;
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
  }

  /* When transparent header is active, ensure the first visible hero/section is flush under header */
  body:has(#header-component[transparent]) #MainContent,
  body:has(#header-component[transparent]) .content-for-layout {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  body:has(#header-component[transparent]) #MainContent > .shopify-section:first-child,
  body:has(#header-component[transparent]) .content-for-layout > .shopify-section:first-child,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type .hero {
    margin-top: calc(var(--header-group-height) * -1) !important;
    padding-top: 0 !important;
  }

  /* If a disabled section sits at :first-child, also target the first visible hero */
  body:has(#header-component[transparent]) .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  body:has(#header-component[transparent]) .hero-wrapper:not([style*="display: none"]):first-of-type {
    margin-top: calc(var(--header-group-height) * -1) !important;
  }

  /* ------------------------------------------------------------------
     2. TYPOGRAPHY — BODY & PARAGRAPH
     ------------------------------------------------------------------ */
  p,
  li,
  .rte,
  .rte p {
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 400 !important;
    font-size: 16.5px !important;
    line-height: 1.75 !important;
    color: #2B2723 !important;
  }

  /* ------------------------------------------------------------------
     3. TYPOGRAPHY — HEADINGS (EDITORIAL)
     ------------------------------------------------------------------ */

  /* Large display headings — Mango Serif (Clean & Aesthetic) */
  .hero h1,
  .hero .hero__title,
  .slideshow__slide h2,
  .banner h1,
  .banner h2,
  [class*="hero"] h1,
  [class*="hero"] h2 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem) !important;
    line-height: 1.15 !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
  }

  /* Section headings, collection titles — Mango Serif */
  h1, .h1 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.85rem, 3vw, 2.5rem) !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.18 !important;
  }

  h2, .h2, .section-heading {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem) !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.22 !important;
  }

  h3, .h3 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem) !important;
    letter-spacing: 0em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.25 !important;
  }

  /* Block-level custom text color override (from Shopify block settings) */
  .text-block[style*="--color:"] :is(h1, h2, h3, h4, h5, h6, p, span, strong, em, b, i),
  .text-block[style*="--color:"] {
    color: var(--color) !important;
  }

  /* Layered slideshow — white headings & accents over media slides */
  .layered-slideshow-section :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow-section :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__container :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__container :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__panel :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__panel :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__content :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__content :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__content .text-block,
  .layered-slideshow__content .text-block * {
    color: #ffffff !important;
  }

  /* Brand banners — white headlines over dark banner photos */
  .brand-banners-section .brand-banner-headline,
  .brand-banner-headline {
    color: #ffffff !important;
  }

  /* ------------------------------------------------------------------
     EDITORIAL STORY SECTION (Everyday Clothes Worth Repeating)
     ------------------------------------------------------------------ */
  [id*="section_AbGcQX"],
  [class*="section_AbGcQX"] {
    background-color: #F2EFE9 !important;
  }

  [id*="section_AbGcQX"] [class*="text_HEgnzz"],
  [class*="section_AbGcQX"] [class*="text_HEgnzz"],
  .text-block--text_HEgnzz,
  [class*="text_HEgnzz"] {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #8F8171 !important;
    margin-bottom: 2px !important;
  }

  [id*="section_AbGcQX"] [class*="text_HEgnzz"] *,
  [class*="section_AbGcQX"] [class*="text_HEgnzz"] *,
  [class*="text_HEgnzz"] * {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #8F8171 !important;
  }

  [id*="section_AbGcQX"] [class*="text_WVMRUt"] h1,
  [class*="section_AbGcQX"] [class*="text_WVMRUt"] h1,
  [id*="section_AbGcQX"] [class*="text_zP3KQK"] h1,
  [class*="section_AbGcQX"] [class*="text_zP3KQK"] h1,
  [class*="text_WVMRUt"] h1,
  [class*="text_zP3KQK"] h1 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(2.4rem, 4vw, 3.4rem) !important;
    line-height: 1.08 !important;
    letter-spacing: -0.015em !important;
    color: #1C1C1C !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  [id*="section_AbGcQX"] [class*="text_tHzFNN"] p,
  [id*="section_AbGcQX"] [class*="text_LN44KT"] p,
  [class*="section_AbGcQX"] [class*="text_tHzFNN"] p,
  [class*="section_AbGcQX"] [class*="text_LN44KT"] p,
  [class*="text_tHzFNN"] p,
  [class*="text_LN44KT"] p {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 16px !important;
    line-height: 1.8 !important;
    color: #2B2723 !important;
    font-weight: 400 !important;
  }

  /* Editorial pull quote with gold accent line — pure charcoal, high contrast */
  [id*="section_AbGcQX"] [class*="text_3FLB3H"],
  [class*="section_AbGcQX"] [class*="text_3FLB3H"],
  [class*="text_3FLB3H"] {
    margin-block: 8px !important;
  }

  [id*="section_AbGcQX"] [class*="text_3FLB3H"] :is(h1, h2, h3, h4, p, span, em, strong, *),
  [class*="section_AbGcQX"] [class*="text_3FLB3H"] :is(h1, h2, h3, h4, p, span, em, strong, *),
  [class*="text_3FLB3H"] :is(h1, h2, h3, h4, p, span, em, strong, *) {
    font-family: 'Mango Serif', 'La Mango', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: clamp(1.25rem, 1.85vw, 1.6rem) !important;
    line-height: 1.45 !important;
    letter-spacing: -0.01em !important;
    color: #1C1C1C !important;
  }

  [id*="section_AbGcQX"] .button,
  [class*="section_AbGcQX"] .button,
  [class*="section_AbGcQX"] [class*="button_NbgGTT"] a,
  [class*="section_AbGcQX"] [class*="button_NbgGTT"] button {
    background-color: #1C1C1C !important;
    color: #F2EFE9 !important;
    border-color: #1C1C1C !important;
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 11px !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    font-weight: 600 !important;
    margin-top: 6px !important;
  }

  /* Small uppercase labels — clean sans-serif */
  h4, h5, h6,
  .h4, .h5, .h6,
  .announcement-bar__message,
  .collection-filters__heading {
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 600 !important;
    font-style: normal !important;
    font-size: 12.5px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #3D3935 !important;
  }

  /* ------------------------------------------------------------------
     4. HEADER — MINIMAL PARCHMENT BAR
     ------------------------------------------------------------------ */
  .header-section,
  #header-component,
  .header,
  .header-wrapper,
  .section-header {
    background-color: #ffffff !important;
    border-bottom: none !important;
  }

  #header-component .header__underlay-closed,
  #header-component .header__underlay-open {
    height: 100% !important;
    background: #ffffff !important;
  }

  /* When transparent header is explicitly active, respect transparency */
  #header-component[transparent],
  .header-section:has(#header-component[transparent]),
  .header[transparent] {
    background-color: transparent !important;
  }

  #header-component[transparent] .header__underlay-closed {
    background: transparent !important;
  }

  .header__row {
    background-color: #ffffff !important;
    border-bottom: 1px solid #E2DDD6 !important;
  }

  /* Nav links */
  .header__menu-item,
  .header__menu-item a,
  .header__menu-item span,
  .header__active-menu-item {
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 600 !important;
    font-size: 13px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #1C1C1C !important;
  }

  .header__menu-item:hover a,
  .header__menu-item:hover span {
    opacity: 0.5 !important;
  }

  /* ------------------------------------------------------------------
     5. BUTTONS — SHARP ARCHITECTURAL EDGES
     ------------------------------------------------------------------ */
  .button,
  .btn,
  button[type="submit"],
  .shopify-payment-button__button--unbranded {
    border-radius: 0 !important;
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 600 !important;
    font-size: 12.5px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    padding: 14px 34px !important;
  }

  /* Primary: flat black */
  .button--primary {
    background-color: #1C1C1C !important;
    color: #F2EFE9 !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .button--primary:hover {
    background-color: #3D3935 !important;
    color: #F2EFE9 !important;
  }

  /* Secondary: outlined */
  .button--secondary {
    background-color: transparent !important;
    color: #1C1C1C !important;
    border: 1px solid #1C1C1C !important;
    border-radius: 0 !important;
  }

  .button--secondary:hover {
    background-color: #1C1C1C !important;
    color: #F2EFE9 !important;
  }

  /* ------------------------------------------------------------------
     6. PRODUCT CARDS — EDITORIAL MINIMAL
     ------------------------------------------------------------------ */
  .card,
  .product-card,
  .card-wrapper,
  .product-card-wrapper {
    background: transparent !important;
    border-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .card__media,
  .card__image {
    border-radius: 0 !important;
    transition: opacity 0.35s ease !important;
  }

  .card:hover .card__media {
    opacity: 0.88 !important;
  }

  /* Card title — Mango Serif */
  .card__heading,
  .card__heading a,
  .card-information__text,
  .tabbed-product-card__title,
  .tabbed-product-card__title a {
    font-family: var(--font-editorial--family) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.05rem, 1.3vw, 1.22rem) !important;
    letter-spacing: 0em !important;
    color: #1C1C1C !important;
    text-transform: none !important;
    line-height: 1.35 !important;
  }

  /* Card price — restrained, clear */
  .card-information .price,
  .price__regular,
  .price-item,
  .tabbed-product-card__current-price {
    font-family: var(--font-body-custom--family) !important;
    font-weight: 500 !important;
    font-size: 15.5px !important;
    letter-spacing: 0.02em !important;
    color: #1C1C1C !important;
  }

  /* Card vendor/edition meta */
  .card__vendor,
  .card-information__subtitle {
    font-family: var(--font-body-custom--family) !important;
    font-weight: 500 !important;
    font-size: 12px !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #8A8580 !important;
  }

  /* Card info padding */
  .card-information,
  .card__content {
    padding: 14px 0 0 0 !important;
    background: transparent !important;
  }

  /* ------------------------------------------------------------------
     7. QUICK ADD BUTTON — MINIMAL
     ------------------------------------------------------------------ */
  .quick-add__submit,
  .card .button {
    background-color: #1C1C1C !important;
    color: #F2EFE9 !important;
    border-radius: 0 !important;
    font-family: var(--font-body-custom--family) !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    border: none !important;
    padding: 12px 24px !important;
  }

  /* ------------------------------------------------------------------
     8. COLLECTION BANNER / PAGE HEADER
     ------------------------------------------------------------------ */
  .collection-hero,
  .collection-hero__inner,
  .page-header {
    background-color: #F2EFE9 !important;
  }

  .collection-hero__title,
  .collection__title,
  .page-header__title {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 300 !important;
    font-style: normal !important;
    font-size: clamp(2.3rem, 4.2vw, 3.4rem) !important;
    line-height: 1.15 !important;
    color: #1C1C1C !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
  }

  .collection-hero__description,
  .page-header__description {
    font-family: var(--font-body-custom--family) !important;
    font-weight: 400 !important;
    font-size: 18px !important;
    line-height: 1.75 !important;
    color: #5C5751 !important;
    max-width: 55ch !important;
  }

  /* ------------------------------------------------------------------
     9. FOOTER — WARM AND MINIMAL
     ------------------------------------------------------------------ */
  .footer,
  .footer-section {
    background-color: #EAE6DF !important;
    border-top: 1px solid #D8D3CC !important;
  }

  .footer a,
  .footer li,
  .footer p {
    font-family: var(--font-body-custom--family) !important;
    font-weight: 400 !important;
    font-size: 14.5px !important;
    letter-spacing: 0.02em !important;
    color: #3D3935 !important;
  }

  .footer__heading,
  .footer h2,
  .footer h3 {
    font-family: var(--font-body-custom--family) !important;
    font-weight: 600 !important;
    font-size: 12.5px !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #1C1C1C !important;
    font-style: normal !important;
  }

  /* ------------------------------------------------------------------
     10. INPUTS & FORM FIELDS
     ------------------------------------------------------------------ */
  input[type="text"],
  input[type="email"],
  input[type="tel"],
  input[type="number"],
  input[type="search"],
  select,
  textarea {
    background-color: #F2EFE9 !important;
    border: 1px solid #D8D3CC !important;
    border-radius: 0 !important;
    font-family: var(--font-body-custom--family) !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    color: #1C1C1C !important;
    padding: 12px 16px !important;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #1C1C1C !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* ------------------------------------------------------------------
     11. ANNOUNCEMENT BAR
     ------------------------------------------------------------------ */
  .announcement-bar,
  .header-announcements {
    background-color: #1C1C1C !important;
  }

  .announcement-bar__message,
  .announcement-bar a {
    font-family: var(--font-body-custom--family) !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    letter-spacing: 0.12em !important;
    color: #F2EFE9 !important;
    text-transform: uppercase !important;
  }

  /* ------------------------------------------------------------------
     12. DIVIDERS
     ------------------------------------------------------------------ */
  .divider,
  hr {
    border-color: #D8D3CC !important;
    opacity: 1 !important;
  }

  /* ------------------------------------------------------------------
     13. BADGES
     ------------------------------------------------------------------ */
  .badge {
    border-radius: 0 !important;
    font-family: var(--font-body-custom--family) !important;
    font-size: 11px !important;
