{% style %}
  /* ==========================================================================
     ON REPEAT — QUIET LUXURY GLOBAL STYLES
     Inspired by linendebeaumont.com
     Parchment palette · Editorial typography · Minimal spacing
     ========================================================================== */

  /* ------------------------------------------------------------------
     1. GLOBAL RESET & BACKGROUND
     ------------------------------------------------------------------ */
  body,
  .page-wrapper,
  main,
  #MainContent,
  .content-for-layout {
    background-color: #ffffff !important;
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 400 !important;
    font-size: 16.5px !important;
    line-height: 1.75 !important;
    color: #1C1C1C !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
  }

  /* Clean white background across all panels */
  .cart-drawer,
  .popover,
  [data-menu-drawer],
  .drawer,
  .search-modal,
  .quick-add-modal,
  .predictive-search {
    background-color: #ffffff !important;
  }

  /* Ensure page top is flush — zero margins and paddings on root containers */
  html,
  body,
  .page-wrapper {
    margin: 0 !important;
    padding: 0 !important;
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    gap: 0 !important;
    row-gap: 0 !important;
  }

  /* Accessibility skip link and drawers must never introduce top spacing or flow displacement */
  .skip-to-content-link:not(:focus) {
    display: none !important;
    position: fixed !important;
    top: -9999px !important;
    left: -9999px !important;
    width: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 0 !important;
    line-height: 0 !important;
    overflow: hidden !important;
  }

  theme-drawer,
  theme-drawer#chat-drawer {
    display: contents !important;
  }

  /* Global reset for transparent header offset variables across all viewports */
  :root,
  body,
  html body {
    --transparent-header-offset-boolean: 0 !important;
    --section-top-offset: 0px !important;
  }

  /* Header group & header components strictly flush with zero extra space */
  #header-group,
  .header-section,
  #header-component,
  .header,
  .header__row {
    margin: 0 !important;
    padding: 0 !important;
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    margin-block-end: 0 !important;
    padding-block-end: 0 !important;
  }

  #header-group,
  .header-section,
  #header-component,
  .header {
    height: auto !important;
    min-height: 0 !important;
    max-height: max-content !important;
  }

  /* Prevent mobile drawer wrapper from imposing 60px min-height on header row */
  @media screen and (min-width: 750px) {
    .header__drawer {
      display: none !important;
      min-height: 0 !important;
      height: 0 !important;
    }
  }

  /* Mobile: lock header height strictly to 44px, eliminate drop shadow & hero gap */
  @media screen and (max-width: 749px) {
    :root,
    body,
    html body {
      --header-height: 44px !important;
      --header-group-height: 44px !important;
      --header-drawer-min-height: 44px !important;
      --header-mobile-bookend: 44px !important;
      --transparent-header-offset-boolean: 0 !important;
      --section-top-offset: 0px !important;
      --margin-block-start: 0px !important;
      --padding-block-start: 0px !important;
    }

    #header-group,
    .header-section,
    #header-component,
    .header {
      height: 44px !important;
      min-height: 44px !important;
      max-height: 44px !important;
      margin: 0 !important;
      padding: 0 !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
      margin-block-end: 0 !important;
      padding-block-end: 0 !important;
      overflow: visible !important;
    }

    #header-component:not([transparent]),
    .header:not([transparent]) {
      background-color: #ffffff !important;
    }

    .header__row,
    .header__row--top {
      height: 44px !important;
      min-height: 44px !important;
      max-height: 44px !important;
      margin: 0 !important;
      padding: 0 !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
      margin-block-end: 0 !important;
      padding-block-end: 0 !important;
      box-sizing: border-box !important;
    }

    #header-component:not([transparent]) .header__row,
    #header-component:not([transparent]) .header__row--top {
      background-color: #ffffff !important;
      border-bottom: 1px solid #EAEAEA !important;
    }

    .header__columns {
      height: 44px !important;
      min-height: 44px !important;
      max-height: 44px !important;
      padding-block: 0 !important;
      margin-block: 0 !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
      box-sizing: border-box !important;
    }

    .header__drawer,
    #header-component[data-menu-style='drawer'] .header__drawer {
      min-height: 44px !important;
      height: 44px !important;
      max-height: 44px !important;
      padding: 0 !important;
      margin: 0 !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }

    /* Completely eliminate any drop shadow or open underlay rogue height on mobile */
    #header-component .header__underlay-open,
    #header-component .header__underlay-open::after,
    .header__underlay-open,
    .header__underlay-open::after {
      display: none !important;
      box-shadow: none !important;
      height: 0 !important;
      min-height: 0 !important;
      max-height: 0 !important;
    }

    #header-component .header__underlay-closed {
      height: 100% !important;
      max-height: 44px !important;
      background: #ffffff !important;
    }

    /* ------------------------------------------------------------------
       MOBILE HERO & LAYOUT: FLUSH AT 0PX UNDER 44PX HEADER (NO 32PX GAP)
       ------------------------------------------------------------------ */

    /* Reset MainContent & layout container top spacing */
    .page-wrapper {
      gap: 0 !important;
      row-gap: 0 !important;
    }

    #MainContent,
    .content-for-layout,
    .page-wrapper > main,
    main#MainContent,
    main.content-for-layout {
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
      --margin-block-start: 0px !important;
      --padding-block-start: 0px !important;
    }

    /* Reset all section wrappers, hero wrappers, hero elements, and media grids on mobile */
    .shopify-section,
    .hero-wrapper,
    .section-wrapper,
    .hero,
    .hero__container,
    .hero__media-grid,
    .hero__media-item,
    .hero__media-wrapper {
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
      --margin-block-start: 0px !important;
      --padding-block-start: 0px !important;
      --section-top-offset: 0px !important;
    }

    /* Force hero container spacing-style to 0 on mobile */
    .hero .hero__container.spacing-style,
    .hero-wrapper .hero__container.spacing-style,
    .hero__container.spacing-style {
      padding-block-start: 0 !important;
      margin-block-start: 0 !important;
      padding-top: 0 !important;
      margin-top: 0 !important;
      --padding-block-start: 0px !important;
      --margin-block-start: 0px !important;
      --section-top-offset: 0px !important;
    }

    /* First visible section in #MainContent sits directly flush against header bottom border */
    #MainContent > *:first-child,
    #MainContent > .shopify-section:first-of-type,
    #MainContent > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
    #MainContent > .hero-wrapper:first-of-type,
    #MainContent > .shopify-section:has(.hero):first-of-type,
    #MainContent > .shopify-section:has(.hero):first-child,
    #MainContent > .shopify-section:first-child > *:first-child,
    #MainContent > .shopify-section:first-of-type > .hero,
    .content-for-layout > *:first-child,
    .content-for-layout > .shopify-section:first-of-type,
    .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
    .content-for-layout > .hero-wrapper:first-of-type,
    .shopify-section:has(.hero):first-of-type,
    .hero-wrapper:has(.hero):first-of-type,
    .hero-wrapper:first-of-type,
    .hero-wrapper:first-child {
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
      --margin-block-start: 0px !important;
      --padding-block-start: 0px !important;
      --section-top-offset: 0px !important;
    }

    #MainContent > *:first-child > *:first-child,
    #MainContent > .shopify-section:first-of-type > *:first-child,
    #MainContent > .shopify-section:first-of-type > .hero,
    .hero-wrapper:first-of-type > .hero,
    .hero-wrapper:first-of-type .hero__container {
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-block-start: 0 !important;
      padding-block-start: 0 !important;
      --margin-block-start: 0px !important;
      --padding-block-start: 0px !important;
    }
  }

  /* Hide any disabled or phantom announcement bar in header-group */
  #header-group:has(.announcement-bar[aria-hidden="true"]) .shopify-section:has(.announcement-bar),
  #header-group .shopify-section:has(.announcement-bar[aria-hidden="true"]),
  #header-group .header-announcements[aria-hidden="true"],
  #header-group .shopify-section:empty {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Ensure transparent header sits flush at top: 0 */
  .header[transparent] {
    top: 0 !important;
  }

  #MainContent,
  .content-for-layout,
  .page-wrapper > main,
  main#MainContent {
    padding-top: 0 !important;
    margin-top: 0 !important;
    padding-block-start: 0 !important;
    margin-block-start: 0 !important;
    --margin-block-start: 0px !important;
    --padding-block-start: 0px !important;
  }

  /* Collapse any empty or disabled shopify sections in DOM / Theme Editor */
  .shopify-section:empty,
  .shopify-section[style*="display: none"],
  .shopify-section[aria-hidden="true"],
  .shopify-section:has(.hero[style*="display: none"]),
  .shopify-section:has(.divider[aria-hidden="true"]) {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 0 !important;
    min-height: 0 !important;
  }

  /* Universal flush hero & banner rules — applies to ALL heroes across the site */
  .hero-wrapper,
  .hero-wrapper .hero,
  .hero-wrapper .hero__container,
  .hero-wrapper .hero__media-grid,
  .hero,
  .hero__container,
  .hero__media-grid,
  .brand-banners-section,
  .layered-slideshow-section {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
    --margin-block-start: 0px !important;
  }

  .hero .hero__container.spacing-style,
  .hero-wrapper .hero__container.spacing-style,
  .hero__container.spacing-style {
    padding-block-start: 0 !important;
    margin-block-start: 0 !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    --padding-block-start: 0px !important;
    --margin-block-start: 0px !important;
    --section-top-offset: 0px !important;
  }

  /* First visible section in #MainContent sits directly flush against header bottom border */
  #MainContent > *:first-child,
  #MainContent > .shopify-section:first-child,
  main > .shopify-section:first-child,
  .main-content > .shopify-section:first-child,
  #MainContent > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  #MainContent > .hero-wrapper:first-of-type,
  #MainContent > .shopify-section:has(.hero):first-of-type,
  .content-for-layout > *:first-child,
  .content-for-layout > .shopify-section:first-child,
  .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  .content-for-layout > .hero-wrapper:first-of-type,
  .shopify-section:has(.hero):first-of-type,
  .hero-wrapper:first-of-type,
  #MainContent > .shopify-section:first-child > *:first-child,
  #MainContent > .shopify-section:first-of-type > .hero,
  main > .shopify-section:first-child > *:first-child {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    --section-top-offset: 0px !important;
    --padding-block-start: 0px !important;
    --margin-block-start: 0px !important;
  }

  /* When transparent header is active:
     1. #header-group and .header-section use display: contents so they take 0px vertical flow height and hero starts at y = 0
     2. #header-component floats seamlessly at top: 0 with pointer-events and full size
     3. Sticky scroll activates solid white background and fixed positioning */
  body.template-index #header-group,
  body.template-index .header-section,
  body:has(#header-component[transparent]) #header-group,
  body:has(#header-component[transparent]) .header-section,
  #header-group:has(#header-component[transparent]),
  .header-section:has(#header-component[transparent]),
  .header-section:has(> #header-component[transparent]),
  .header-section:has(.header[transparent]) {
    display: contents !important;
  }

  body.template-index #header-group > *,
  body.template-index #header-component,
  body:has(#header-component[transparent]) #header-group > *,
  body:has(#header-component[transparent]) #header-component,
  #header-group:has(#header-component[transparent]) #header-component {
    pointer-events: auto !important;
  }

  body.template-index #header-component,
  body:has(#header-component[transparent]) #header-component,
  #header-component[transparent] {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    pointer-events: auto !important;
    z-index: 100 !important;
  }

  body.template-index #header-component[data-sticky-state='active'],
  body:has(#header-component[transparent]) #header-component[data-sticky-state='active'],
  #header-component[transparent][data-sticky-state='active'] {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    background-color: #ffffff !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
    pointer-events: auto !important;
    z-index: var(--layer-menu-drawer, 50) !important;
  }

  body.template-index #MainContent,
  body.template-index .content-for-layout,
  body:has(#header-component[transparent]) #MainContent,
  body:has(#header-component[transparent]) .content-for-layout {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    --margin-block-start: 0px !important;
    --padding-block-start: 0px !important;
  }

  body.template-index #MainContent > .shopify-section:first-child,
  body.template-index .content-for-layout > .shopify-section:first-child,
  body.template-index .hero-wrapper:first-of-type,
  body.template-index .hero-wrapper:first-child,
  body.template-index .hero-wrapper:first-of-type .hero,
  body.template-index .hero-wrapper:first-of-type .hero__container,
  body.template-index .hero-wrapper:first-of-type .hero__media-grid,
  body.template-index .hero-wrapper:first-child .hero,
  body.template-index .hero-wrapper:first-child .hero__container,
  body.template-index .hero-wrapper:first-child .hero__media-grid,
  body:has(#header-component[transparent]) #MainContent > .shopify-section:first-child,
  body:has(#header-component[transparent]) .content-for-layout > .shopify-section:first-child,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type,
  body:has(#header-component[transparent]) .hero-wrapper:first-child,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type .hero,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type .hero__container,
  body:has(#header-component[transparent]) .hero-wrapper:first-of-type .hero__media-grid,
  body:has(#header-component[transparent]) .hero-wrapper:first-child .hero,
  body:has(#header-component[transparent]) .hero-wrapper:first-child .hero__container,
  body:has(#header-component[transparent]) .hero-wrapper:first-child .hero__media-grid {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    --margin-block-start: 0px !important;
    --padding-block-start: 0px !important;
    --section-top-offset: 0px !important;
    --hero-height-offset: 0px !important;
    top: 0 !important;
  }

  /* If a disabled section sits at :first-child, also target the first visible hero */
  body.template-index .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  body.template-index .hero-wrapper:not([style*="display: none"]):first-of-type,
  body:has(#header-component[transparent]) .content-for-layout > .shopify-section:not([style*="display: none"]):not(:empty):first-of-type,
  body:has(#header-component[transparent]) .hero-wrapper:not([style*="display: none"]):first-of-type {
    margin-top: 0 !important;
    padding-top: 0 !important;
    margin-block-start: 0 !important;
    padding-block-start: 0 !important;
    --margin-block-start: 0px !important;
    --padding-block-start: 0px !important;
    --section-top-offset: 0px !important;
    --hero-height-offset: 0px !important;
  }

  /* ------------------------------------------------------------------
     2. TYPOGRAPHY — BODY & PARAGRAPH
     ------------------------------------------------------------------ */
  p,
  li,
  .rte,
  .rte p {
    font-family: var(--font-body-custom--family, 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif) !important;
    font-weight: 400 !important;
    font-size: 16.5px !important;
    line-height: 1.75 !important;
    color: #2B2723 !important;
  }

  /* ------------------------------------------------------------------
     3. TYPOGRAPHY — HEADINGS (EDITORIAL)
     ------------------------------------------------------------------ */

  /* Large display headings — Mango Serif (Clean & Aesthetic) */
  .hero h1,
  .hero .hero__title,
  .slideshow__slide h2,
  .banner h1,
  .banner h2,
  [class*="hero"] h1,
  [class*="hero"] h2 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem) !important;
    line-height: 1.15 !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
  }

  /* Section headings, collection titles — Mango Serif */
  h1, .h1 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.85rem, 3vw, 2.5rem) !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.18 !important;
  }

  h2, .h2, .section-heading {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem) !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.22 !important;
  }

  h3, .h3 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem) !important;
    letter-spacing: 0em !important;
    text-transform: none !important;
    color: #1C1C1C;
    line-height: 1.25 !important;
  }

  /* Block-level custom text color override (from Shopify block settings) */
  .text-block[style*="--color:"] :is(h1, h2, h3, h4, h5, h6, p, span, strong, em, b, i),
  .text-block[style*="--color:"] {
    color: var(--color) !important;
  }

  /* Layered slideshow — white headings & accents over media slides */
  .layered-slideshow-section :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow-section :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__container :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__container :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__panel :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__panel :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__content :is(h1, h2, h3, h4, h5, h6),
  .layered-slideshow__content :is(h1, h2, h3, h4, h5, h6) :is(strong, em, span, b, i),
  .layered-slideshow__content .text-block,
  .layered-slideshow__content .text-block * {
    color: #ffffff !important;
  }

  /* Brand banners — white headlines over dark banner photos */
  .brand-banners-section .brand-banner-headline,
  .brand-banner-headline {
    color: #ffffff !important;
  }

  /* ------------------------------------------------------------------
     EDITORIAL STORY SECTION (Everyday Clothes Worth Repeating)
     ------------------------------------------------------------------ */
  [id*="section_AbGcQX"],
  [class*="section_AbGcQX"] {
    background-color: #ffffff !important;
  }

  [id*="section_AbGcQX"] [class*="text_HEgnzz"],
  [class*="section_AbGcQX"] [class*="text_HEgnzz"],
  .text-block--text_HEgnzz,
  [class*="text_HEgnzz"] {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #8F8171 !important;
    margin-bottom: 2px !important;
  }

  [id*="section_AbGcQX"] [class*="text_HEgnzz"] *,
  [class*="section_AbGcQX"] [class*="text_HEgnzz"] *,
  [class*="text_HEgnzz"] * {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #8F8171 !important;
  }

  [id*="section_AbGcQX"] [class*="text_WVMRUt"] h1,
  [class*="section_AbGcQX"] [class*="text_WVMRUt"] h1,
  [id*="section_AbGcQX"] [class*="text_zP3KQK"] h1,
  [class*="section_AbGcQX"] [class*="text_zP3KQK"] h1,
  [class*="text_WVMRUt"] h1,
  [class*="text_zP3KQK"] h1 {
    font-family: 'Mango Serif', 'La Mango', serif !important;
