{% stylesheet %}
  /* ==========================================================================
     QUICK-ADD MODAL — PREMIUM BRAND STYLING
     ========================================================================== */

  /* Show quick-add button on mobile (triggers custom bottom sheet) */
  @media screen and (max-width: 749px) {
    button.quick-add__button {
      --quick-add-mobile-display: flex !important;
      --quick-add-mobile-opacity: 1 !important;
      opacity: 1 !important;
    }
    .quick-add {
      pointer-events: auto;
    }
  }

  /* ==========================================================================
     DESKTOP
     ========================================================================== */

  @media screen and (min-width: 750px) {

    .quick-add-modal__trust-strip,
    .quick-add-modal__view-details {
      display: none !important;
    }

    .quick-add-modal__content .view-product-title a {
      -webkit-line-clamp: 3;
      font-size: clamp(17px, 2vw, 22px) !important;
      font-weight: 600 !important;
      line-height: 1.25 !important;
      letter-spacing: -0.02em !important;
      color: #111 !important;
    }

    .quick-add-modal__content .view-product-title {
      padding-block: 0 !important;
      margin-block-end: 10px !important;
    }

    .quick-add-modal__content .product-details product-price .price-item--regular,
    .quick-add-modal__content .product-details product-price .price-item--sale {
      font-size: 17px !important;
      font-weight: 500 !important;
      color: #1C1C1C !important;
    }

    .quick-add-modal__content .variant-option__legend-title {
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      color: #6b7280 !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
      min-width: 58px !important;
      height: 40px !important;
      border-radius: 0 !important;
      border: 1.5px solid #d1cbc3 !important;
      background: #fff !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.07em !important;
      text-transform: uppercase !important;
      color: #1C1C1C !important;
      transition: all 0.15s ease !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(:checked) {
      background: #1C1C1C !important;
      color: #fff !important;
      border-color: #1C1C1C !important;
    }

    .quick-add-modal__content .product-details .add-to-cart-button {
      height: 48px !important;
      border-radius: 0 !important;
      background: #1C1C1C !important;
      color: #fff !important;
      border: 1.5px solid #1C1C1C !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
    }

    .quick-add-modal__content .product-details .shopify-payment-button__button {
      height: 46px !important;
      border-radius: 0 !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
    }

    .quick-add-modal__content .quantity-selector {
      height: 44px !important;
    }

    .quick-add-modal__content .variant-option--swatches {
      gap: 10px !important;
    }

    .quick-add-modal__content .product-details > .group-block {
      padding-block: 28px 0 !important;
    }

    .quick-add-modal__content :where(.product-details > .group-block > .group-block-content > *) {
      padding-inline: 28px !important;
    }
  }

  /* ==========================================================================
     MOBILE — clean 2-column sheet
     ========================================================================== */

  @media screen and (max-width: 749px) {

    /* ── Sheet ────────────────────────────────────────────────────────── */
    .quick-add-modal {
      border-top-left-radius: 20px !important;
      border-top-right-radius: 20px !important;
      background: #fff !important;
      max-height: 90svh !important;
      /* Do NOT add overflow:hidden — it clips the abs-positioned close button */
    }

    /* Drag handle pill */
    .quick-add-modal::before {
      content: '' !important;
      display: block !important;
      width: 40px !important;
      height: 4px !important;
      border-radius: 99px !important;
      background: #E5E7EB !important;
      margin: 10px auto 0 !important;
      flex-shrink: 0 !important;
    }

    /* ── Grid: image col (40%) | content col (60%) ────────────────────
       Row 1: portrait image  |  title + price
       Row 2: (full width)      variant picker (color, size)
       Row 3: (full width)      buy buttons + trust + details
    ─────────────────────────────────────────────────────────────────── */
    .quick-add-modal__content {
      display: grid !important;
      grid-template-columns: 40% 1fr !important;
      grid-template-rows: auto !important;
      padding: 0 !important;
      gap: 0 !important;
      overflow-y: auto !important;
      max-height: calc(90svh - 24px) !important;
    }

    /* ── Col 1: portrait image ────────────────────────────────────────── */
    .quick-add-modal__content .product-information__media {
      grid-column: 1 !important;
      grid-row: 1 !important;
      width: 100% !important;
      aspect-ratio: 3 / 4 !important;
      height: auto !important;
      min-height: 0 !important;
      overflow: hidden !important;
      border-radius: 0 !important;
      align-self: stretch !important;
    }

    .quick-add-modal__content .product-information__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    /* ── Col 2: title + price (row 1 only) ───────────────────────────── */
    .quick-add-modal__content .product-details {
      grid-column: 2 !important;
      grid-row: 1 !important;
      align-self: start !important;
      padding: 20px 52px 16px 16px !important;
      overflow: visible !important;
      max-height: none !important;
      display: flex !important;
      flex-direction: column !important;
    }

    .quick-add-modal__content .product-details > .group-block {
      padding-block: 0 !important;
      flex: none !important;
    }

    .quick-add-modal__content :where(.product-details > .group-block > .group-block-content > *) {
      padding-inline: 0 !important;
    }

    /* ── Title ────────────────────────────────────────────────────────── */
    .quick-add-modal__content .view-product-title {
      padding: 0 !important;
      margin: 0 0 10px 0 !important;
    }

    .quick-add-modal__content .view-product-title a {
      font-size: 16px !important;
      font-weight: 400 !important;
      color: #111 !important;
      line-height: 1.3 !important;
      letter-spacing: -0.02em !important;
      -webkit-line-clamp: 4 !important;
    }

    /* ── Price ────────────────────────────────────────────────────────── */
    .quick-add-modal__content product-price .price-item--regular,
    .quick-add-modal__content product-price .price-item--sale {
      font-size: 17px !important;
      font-weight: 600 !important;
      color: #111 !important;
    }

    /* ── Full-width sections (row 2+): variant picker ─────────────────── */
    .quick-add-modal__content variant-picker,
    .quick-add-modal__content .product-details .variant-picker {
      grid-column: 1 / -1 !important;
      padding: 16px 20px 4px !important;
      border-top: 1px solid #F3F0EC !important;
    }

    /* Option legend row */
    .quick-add-modal__content .variant-option__legend-row {
      display: flex !important;
      align-items: center !important;
      margin-bottom: 10px !important;
      padding: 0 !important;
    }

    .quick-add-modal__content .variant-option__legend-title {
      font-size: 10px !important;
      font-weight: 700 !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
      color: #6B7280 !important;
    }

    /* Color swatches */
    .quick-add-modal__content .variant-option--swatches {
      gap: 8px !important;
      padding-inline-start: 0 !important;
      margin-bottom: 14px !important;
    }

    /* Size buttons */
    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 8px !important;
      padding: 0 !important;
      margin: 0 0 14px 0 !important;
      border: none !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
      min-width: 56px !important;
      height: 42px !important;
      border-radius: 0 !important;
      border: 1.5px solid #D1CBC3 !important;
      background-color: #fff !important;
      color: #1C1C1C !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 12px !important;
      cursor: pointer !important;
      white-space: nowrap !important;
      transition: background 0.15s ease, color 0.15s ease !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(:checked) {
      background-color: #1C1C1C !important;
      color: #fff !important;
      border-color: #1C1C1C !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has([data-option-available='false']) {
      background-color: #FAFAFA !important;
      border-color: #E5E7EB !important;
      color: #C0BDB8 !important;
      text-decoration: line-through !important;
    }

    /* ── Full-width: buy buttons ──────────────────────────────────────── */
    .quick-add-modal__content product-form-component {
      grid-column: 1 / -1 !important;
    }

    /* Hide quantity */
    .quick-add-modal__content .quantity-selector-wrapper {
      display: none !important;
    }

    .quick-add-modal__content .product-details .buy-buttons-block {
      position: sticky !important;
      bottom: 0 !important;
      background: #fff !important;
      padding: 14px 20px 18px !important;
      margin-top: 0 !important;
      z-index: 10 !important;
      border-top: 1px solid #F3F0EC !important;
    }

    .quick-add-modal__content .product-details .buy-buttons-block::before {
      display: none !important;
    }

    .quick-add-modal__content .product-details .add-to-cart-button {
      height: 50px !important;
      border-radius: 0 !important;
      background-color: #111 !important;
      color: #fff !important;
      border: none !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      letter-spacing: 0.16em !important;
      text-transform: uppercase !important;
      width: 100% !important;
    }

    .quick-add-modal__content .product-details .shopify-payment-button__button {
      height: 46px !important;
      border-radius: 0 !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      margin-top: 8px !important;
    }

    /* ── Trust strip ──────────────────────────────────────────────────── */
    .quick-add-modal__trust-strip {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      padding: 10px 20px 4px !important;
      font-size: 10.5px !important;
      color: #9CA3AF !important;
      font-weight: 400 !important;
      text-align: center !important;
      letter-spacing: 0.01em !important;
      background: #fff !important;
    }

    /* ── View Details link ────────────────────────────────────────────── */
    .quick-add-modal__view-details {
      display: flex !important;
      justify-content: flex-start !important;
      padding: 6px 20px 18px !important;
      background: #fff !important;
    }

    .quick-add-modal__view-details a {
      font-size: 11px !important;
      font-weight: 500 !important;
      letter-spacing: 0.07em !important;
      text-transform: uppercase !important;
      text-decoration: underline !important;
      text-underline-offset: 3px !important;
      color: #1C1C1C !important;
    }

    /* ── Close button ─────────────────────────────────────────────────── */
    .quick-add-modal .quick-add-modal__close {
      position: absolute !important;
      top: 12px !important;
      right: 12px !important;
      z-index: 9999 !important;
      width: 32px !important;
      height: 32px !important;
      background: rgba(255, 255, 255, 0.95) !important;
      border-radius: 50% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.12) !important;
      border: none !important;
    }
  }
{% endstylesheet %}
