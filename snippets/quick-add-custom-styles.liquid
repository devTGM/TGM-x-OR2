{% stylesheet %}
  /* ==========================================================================
     QUICK-ADD MODAL — CUSTOM BRAND STYLING
     Matches the reference design: bottom sheet on mobile with
     thumbnail + title/price header, flat size buttons, trust strip.
     ========================================================================== */

  /* ── Always show quick-add button on mobile (triggers custom bottom sheet) ── */
  @media screen and (max-width: 749px) {
    /* Override the theme's default hidden state for the quick-add button */
    button.quick-add__button {
      --quick-add-mobile-display: flex !important;
      --quick-add-mobile-opacity: 1 !important;
      opacity: 1 !important;
    }

    /* Make sure the card's quick-add overlay is pointer-interactive on mobile */
    .quick-add {
      pointer-events: auto;
    }
  }

  /* ── Mobile bottom sheet overrides ─────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .quick-add-modal {
      border-top-left-radius: 20px !important;
      border-top-right-radius: 20px !important;
      background: #ffffff !important;
      max-height: 92svh !important;
    }

    /* The scrollable content area */
    .quick-add-modal__content {
      display: flex !important;
      flex-direction: column !important;
      padding: 0 !important;
      gap: 0 !important;
      overflow-y: auto !important;
    }

    /* ── Product header row (image + title/price) ────────────────────── */
    .quick-add-modal__content .product-header {
      display: flex !important;
      flex-direction: row !important;
      align-items: flex-start !important;
      gap: 14px !important;
      padding: 20px 20px 14px 20px !important;
      grid-column: unset !important;
      grid-row: unset !important;
      border-bottom: 1px solid #f0ebe4 !important;
    }

    /* Thumbnail */
    .quick-add-modal__content .product-header .product-media-container,
    .quick-add-modal__content .product-information__media {
      width: 90px !important;
      height: 90px !important;
      min-width: 90px !important;
      flex-shrink: 0 !important;
      border-radius: 8px !important;
      overflow: hidden !important;
      grid-column: unset !important;
      grid-row: unset !important;
    }

    .quick-add-modal__content .product-information__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    /* Title / price column */
    .quick-add-modal__content .product-header .product-header-info {
      display: flex !important;
      flex-direction: column !important;
      gap: 4px !important;
      flex: 1 !important;
    }

    .quick-add-modal__content .view-product-title {
      padding: 0 !important;
      margin: 0 0 4px 0 !important;
    }

    .quick-add-modal__content .view-product-title a {
      font-size: 16px !important;
      font-weight: 500 !important;
      color: #1C1C1C !important;
      line-height: 1.3 !important;
      letter-spacing: -0.01em !important;
    }

    /* Price */
    .quick-add-modal__content product-price .price,
    .quick-add-modal__content .price-item {
      font-size: 16px !important;
      font-weight: 600 !important;
      color: #111827 !important;
    }

    /* ── "NEW" badge / metadata ─────────────────────────────────────── */
    .quick-add-modal__quick-meta {
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.1em !important;
      text-transform: uppercase !important;
      color: #6b7280 !important;
      margin-bottom: 2px !important;
    }

    /* ── Variant picker section ─────────────────────────────────────── */
    .quick-add-modal__content variant-picker,
    .quick-add-modal__content .product-details .variant-picker {
      grid-column: unset !important;
      padding: 18px 20px 0 20px !important;
    }

    /* "SELECT SIZE & FIT" section label */
    .quick-add-modal__content .variant-option__legend-row {
      display: flex !important;
      align-items: center !important;
      margin-bottom: 12px !important;
      padding: 0 !important;
    }

    .quick-add-modal__content .variant-option__legend-title {
      font-size: 11px !important;
      font-weight: 600 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      color: #374151 !important;
    }

    /* ── Size option buttons ─────────────────────────────────────────── */
    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 8px !important;
      padding: 0 !important;
      margin: 0 0 16px 0 !important;
      border: none !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
      min-width: 60px !important;
      height: 42px !important;
      border-radius: 0 !important;
      border: 1px solid #D8D3CC !important;
      background-color: #ffffff !important;
      color: #1C1C1C !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 12px !important;
      cursor: pointer !important;
      white-space: nowrap !important;
      transition: all 0.15s ease !important;
    }

    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(:checked) {
      background-color: #1C1C1C !important;
      color: #ffffff !important;
      border-color: #1C1C1C !important;
    }

    /* Unavailable (sold out) size */
    .quick-add-modal__content .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has([data-option-available='false']) {
      background-color: #fafafa !important;
      border-color: #e5e7eb !important;
      color: #9ca3af !important;
    }

    /* ── Buy buttons ─────────────────────────────────────────────────── */
    .quick-add-modal__content .product-details .buy-buttons-block {
      position: sticky !important;
      bottom: 0 !important;
      background: #ffffff !important;
      padding: 12px 20px 0 20px !important;
      margin-top: 0 !important;
      z-index: 10 !important;
    }

    .quick-add-modal__content .product-details .buy-buttons-block::before {
      display: none !important;
    }

    .quick-add-modal__content .product-details .add-to-cart-button {
      height: 50px !important;
      border-radius: 0 !important;
      background-color: #1C1C1C !important;
      color: #ffffff !important;
      border: 1px solid #1C1C1C !important;
      font-size: 12px !important;
      font-weight: 600 !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
      width: 100% !important;
    }

    .quick-add-modal__content .product-details .add-to-cart-button:hover {
      background-color: #000000 !important;
    }

    /* ── Trust badge strip ───────────────────────────────────────────── */
    .quick-add-modal__trust-strip {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 0 !important;
      padding: 10px 20px 6px !important;
      font-size: 11.5px !important;
      color: #6b7280 !important;
      font-weight: 400 !important;
      text-align: center !important;
      letter-spacing: 0.01em !important;
      background: #ffffff !important;
    }

    /* ── View Details link ───────────────────────────────────────────── */
    .quick-add-modal__view-details {
      display: flex !important;
      justify-content: flex-start !important;
      padding: 8px 20px 20px !important;
      background: #ffffff !important;
    }

    .quick-add-modal__view-details a {
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      text-decoration: underline !important;
      text-underline-offset: 3px !important;
      color: #1C1C1C !important;
    }

    /* ── Close button positioning ────────────────────────────────────── */
    .quick-add-modal .quick-add-modal__close {
      top: 16px !important;
      right: 16px !important;
    }

    /* ── Price sub-text (MRP incl. taxes) ───────────────────────────── */
    .quick-add-modal__price-note {
      font-size: 11px !important;
      color: #9ca3af !important;
      margin-top: 2px !important;
    }
  }
{% endstylesheet %}
