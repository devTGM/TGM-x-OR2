{% comment %}
  Linen Feature Cards Section for ON REPEAT
  Displays the 4 quiet luxury feature cards from reference:
  1. 3× Softer Than Ordinary Linen
  2. Featherlight & Naturally Breathable
  3. Designed For Effortless Wear
  4. Tailored With Intention
{% endcomment %}

{% render 'linen-feature-cards', section: section, is_embedded: false %}

{% schema %}
{
  "name": "Linen Feature Cards",
  "tag": "section",
  "class": "section-linen-features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional title above the feature cards"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image",
          "info": "Leave blank to use the default linen feature asset."
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Filename",
          "default": "linen-feature-softer.png"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "3× Softer Than Ordinary Linen"
        },
        {
          "type": "checkbox",
          "id": "show_overlay_title",
          "label": "Show Overlay Title Badge",
          "default": false,
          "info": "Enable if using custom images that don't already have text baked in."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Linen Feature Cards",
      "category": "Product",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "3× Softer Than Ordinary Linen",
            "default_asset": "linen-feature-softer.png",
            "show_overlay_title": false
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Featherlight & Naturally Breathable",
            "default_asset": "linen-feature-breathable.png",
            "show_overlay_title": false
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Designed For Effortless Wear",
            "default_asset": "linen-feature-effortless.png",
            "show_overlay_title": false
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Tailored With Intention",
            "default_asset": "linen-feature-tailored.png",
            "show_overlay_title": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
