{% comment %}
  PREMIUM EDITORIAL IMAGE GRID

  Layout:
  - Card 1 = Large editorial feature
  - Cards 2-5 = Four smaller image cards

  Card 1:
  - Image
  - Logo
  - Rich text
  - CTA

  Cards 2-5:
  - Image
  - Heading
  - Description
  - CTA
  - Overlay
{% endcomment %}

<section
  id="premium-editorial-{{ section.id }}"
  class="premium-editorial-section"
>
  <div class="premium-editorial-grid">

    {% for block in section.blocks %}

      {% if forloop.first %}

        <!-- =========================================
             LARGE FIRST CARD
        ========================================== -->

        <div
          class="premium-editorial-card premium-editorial-card--large"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '800,1200,1600,2000,2400',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'premium-editorial-image'
            }}

          {% else %}

            <div class="premium-editorial-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>

          {% endif %}


          <div
            class="
              premium-editorial-large-content
              premium-editorial-large-content--{{ block.settings.large_text_alignment }}
            "
          >

            {% if block.settings.logo != blank %}

              <div class="premium-editorial-logo">

                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'premium-editorial-logo-image'
                }}

              </div>

            {% endif %}


            {% if block.settings.rich_text != blank %}

              <div class="premium-editorial-rich-text">
                {{ block.settings.rich_text }}
              </div>

            {% endif %}


            {% if block.settings.large_button_text != blank %}

              <a
                href="{{ block.settings.large_button_link }}"
                class="premium-editorial-large-button"
              >
                {{ block.settings.large_button_text }}
              </a>

            {% endif %}

          </div>

        </div>


      {% else %}

        <!-- =========================================
             SMALL CARDS
        ========================================== -->

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="
            premium-editorial-card
            premium-editorial-card--small
            premium-editorial-card--{{ forloop.index }}
          "
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '600,900,1200,1600,1800',
                sizes: '(min-width: 750px) 25vw, 50vw',
                class: 'premium-editorial-image'
            }}

          {% else %}

            <div class="premium-editorial-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>

          {% endif %}


          <div
            class="premium-editorial-overlay"
            style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>


          <div
            class="
              premium-editorial-small-content
              premium-editorial-small-content--{{ block.settings.text_alignment }}
            "
          >

            {% if block.settings.heading != blank %}

              <h2 class="premium-editorial-small-heading">
                {{ block.settings.heading }}
              </h2>

            {% endif %}


            {% if block.settings.description != blank %}

              <div class="premium-editorial-small-description">
                {{ block.settings.description }}
              </div>

            {% endif %}


            {% if block.settings.button_text != blank %}

              <span class="premium-editorial-small-button">
                {{ block.settings.button_text }}
              </span>

            {% endif %}

          </div>

        </a>

      {% endif %}

    {% endfor %}

  </div>
</section>


<style>

  /* ================================================
     SECTION
  ================================================ */

  #premium-editorial-{{ section.id }} {

    width: 100%;

    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;

    padding-left: {{ section.settings.section_padding_horizontal }}px;
    padding-right: {{ section.settings.section_padding_horizontal }}px;

    background: {{ section.settings.background_color }};

  }


  /* ================================================
     MAIN GRID
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-grid {

    display: grid;

    grid-template-columns:
      {{ section.settings.large_column_width }}fr
      1fr
      1fr;

    grid-template-rows:
      1fr
      1fr;

    gap: {{ section.settings.grid_gap }}px;

    width: 100%;

    max-width: {{ section.settings.max_width }}px;

    height: {{ section.settings.desktop_height }}px;

    margin: 0 auto;

  }


  /* ================================================
     ALL CARDS
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-card {

    position: relative;

    display: block;

    overflow: hidden;

    min-width: 0;

    text-decoration: none;

    {% if section.settings.border_radius > 0 %}
      border-radius: {{ section.settings.border_radius }}px;
    {% endif %}

  }


  /* ================================================
     LARGE CARD
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-card--large {

    grid-column: 1;

    grid-row: 1 / 3;

    background: #eeeeee;

  }


  /* ================================================
     SMALL CARDS
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-card--2 {

    grid-column: 2;

    grid-row: 1;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-card--3 {

    grid-column: 3;

    grid-row: 1;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-card--4 {

    grid-column: 2;

    grid-row: 2;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-card--5 {

    grid-column: 3;

    grid-row: 2;

  }


  /* ================================================
     IMAGE
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-image {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center;

    transition:
      transform 0.8s cubic-bezier(0.2, 0.65, 0.3, 1);

  }


  /* ================================================
     IMAGE HOVER
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-card--small:hover
  .premium-editorial-image {

    transform: scale(1.045);

  }


  /* ================================================
     PLACEHOLDER
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-placeholder {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    background: #eeeeee;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-placeholder svg {

    width: 100%;

    height: 100%;

  }


  /* ================================================
     LARGE CARD CONTENT
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-large-content {

    position: absolute;

    z-index: 3;

    width: {{ section.settings.large_content_width }}%;

    left: {{ section.settings.large_content_left }}%;

    top: {{ section.settings.large_content_top }}%;

    color: {{ section.settings.large_text_color }};

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-large-content--center {

    text-align: center;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-large-content--left {

    text-align: left;

  }


  /* ================================================
     LARGE CARD LOGO
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-logo {

    width: {{ section.settings.logo_width }}px;

    margin-bottom: {{ section.settings.logo_spacing }}px;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-logo-image {

    display: block;

    width: 100%;

    height: auto;

    object-fit: contain;

  }


  /* ================================================
     LARGE CARD RICH TEXT
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-rich-text {

    font-size: {{ section.settings.large_text_size }}px;

    line-height: {{ section.settings.large_line_height }};

    font-weight: {{ section.settings.large_font_weight }};

    letter-spacing: {{ section.settings.large_letter_spacing }}px;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-rich-text p {

    margin-top: 0;

    margin-bottom: {{ section.settings.paragraph_spacing }}px;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-rich-text p:last-child {

    margin-bottom: 0;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-rich-text strong {

    font-weight: 600;

  }


  /* ================================================
     LARGE CARD BUTTON
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-large-button {

    display: inline-block;

    margin-top: {{ section.settings.large_button_spacing }}px;

    padding-bottom: 5px;

    color: {{ section.settings.large_text_color }};

    border-bottom: 1px solid currentColor;

    text-decoration: none;

    font-size: {{ section.settings.button_font_size }}px;

    letter-spacing: 0.22em;

    text-transform: uppercase;

    transition:
      opacity 0.3s ease,
      letter-spacing 0.3s ease;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-large-button:hover {

    opacity: 0.65;

    letter-spacing: 0.27em;

  }


  /* ================================================
     SMALL CARD OVERLAY
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background: #000000;

    opacity: var(--overlay-opacity);

    transition: opacity 0.4s ease;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-card--small:hover
  .premium-editorial-overlay {

    opacity: calc(var(--overlay-opacity) + 0.08);

  }


  /* ================================================
     SMALL CARD CONTENT
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-small-content {

    position: absolute;

    z-index: 2;

    left: 0;

    right: 0;

    bottom: 0;

    padding: {{ section.settings.small_content_padding }}px;

    color: {{ section.settings.small_text_color }};

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-small-content--center {

    text-align: center;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-small-content--left {

    text-align: left;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-small-content--right {

    text-align: right;

  }


  /* ================================================
     SMALL CARD HEADING
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-small-heading {

    margin: 0 0 10px;

    color: inherit;

    font-size: {{ section.settings.small_heading_size }}px;

    line-height: 1.2;

    font-weight: 400;

    letter-spacing: -0.01em;

  }


  /* ================================================
     SMALL CARD DESCRIPTION
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-small-description {

    margin-bottom: 17px;

    color: inherit;

    font-size: {{ section.settings.small_text_size }}px;

    line-height: 1.45;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-small-description p {

    margin: 0;

  }


  /* ================================================
     SMALL CARD BUTTON
  ================================================ */

  #premium-editorial-{{ section.id }}
  .premium-editorial-small-button {

    display: inline-block;

    padding-bottom: 5px;

    border-bottom: 1px solid currentColor;

    color: inherit;

    font-size: {{ section.settings.button_font_size }}px;

    line-height: 1;

    letter-spacing: 0.2em;

    text-transform: uppercase;

    transition:
      opacity 0.3s ease,
      letter-spacing 0.3s ease;

  }


  #premium-editorial-{{ section.id }}
  .premium-editorial-card--small:hover
  .premium-editorial-small-button {

    opacity: 0.7;

    letter-spacing: 0.25em;

  }


  /* ================================================
     MOBILE
  ================================================ */

  @media screen and (max-width: 749px) {

    #premium-editorial-{{ section.id }} {

      padding-left: {{ section.settings.mobile_horizontal_padding }}px;

      padding-right: {{ section.settings.mobile_horizontal_padding }}px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-grid {

      grid-template-columns: 1fr 1fr;

      grid-template-rows:
        {{ section.settings.mobile_large_height }}px
        {{ section.settings.mobile_small_height }}px
        {{ section.settings.mobile_small_height }}px;

      height: auto;

      gap: {{ section.settings.mobile_grid_gap }}px;

    }


    /* Large card */

    #premium-editorial-{{ section.id }}
    .premium-editorial-card--large {

      grid-column: 1 / 3;

      grid-row: 1;

    }


    /* Small cards */

    #premium-editorial-{{ section.id }}
    .premium-editorial-card--2 {

      grid-column: 1;

      grid-row: 2;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-card--3 {

      grid-column: 2;

      grid-row: 2;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-card--4 {

      grid-column: 1;

      grid-row: 3;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-card--5 {

      grid-column: 2;

      grid-row: 3;

    }


    /* Large card content */

    #premium-editorial-{{ section.id }}
    .premium-editorial-large-content {

      width: {{ section.settings.mobile_content_width }}%;

      left: {{ section.settings.mobile_content_left }}%;

      top: {{ section.settings.mobile_content_top }}%;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-logo {

      width: {{ section.settings.mobile_logo_width }}px;

      margin-bottom: 22px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-rich-text {

      font-size: {{ section.settings.mobile_large_text_size }}px;

      line-height: 1.45;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-rich-text p {

      margin-bottom: 16px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-large-button {

      margin-top: 25px;

      font-size: 10px;

    }


    /* Small cards */

    #premium-editorial-{{ section.id }}
    .premium-editorial-small-content {

      padding: 20px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-small-heading {

      font-size: 18px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-small-description {

      font-size: 12px;

    }


    #premium-editorial-{{ section.id }}
    .premium-editorial-small-button {

      font-size: 9px;

    }

  }

</style>


{% schema %}

{
  "name": "Premium Editorial Grid",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 2200,
      "step": 20,
      "default": 1800,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 500,
      "max": 1100,
      "step": 10,
      "default": 800,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "large_column_width",
      "label": "Large image width",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.5
    },

    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Desktop side spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_horizontal_padding",
      "label": "Mobile side spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "Large card typography"
    },

    {
      "type": "color",
      "id": "large_text_color",
      "label": "Text color",
      "default": "#3C281D"
    },

    {
      "type": "range",
      "id": "large_text_size",
      "label": "Text size",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_large_text_size",
      "label": "Mobile text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "large_line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },

    {
      "type": "select",
      "id": "large_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        }
      ],
      "default": "400"
    },

    {
      "type": "range",
      "id": "large_letter_spacing",
      "label": "Letter spacing",
      "min": -1,
      "max": 2,
      "step": 0.1,
      "default": 0,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 18,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Large card position"
    },

    {
      "type": "range",
      "id": "large_content_width",
      "label": "Content width",
      "min": 30,
      "max": 80,
      "step": 1,
      "default": 50,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "large_content_left",
      "label": "Content left position",
      "min": 3,
      "max": 40,
      "step": 1,
      "default": 8,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "large_content_top",
      "label": "Content top position",
      "min": 5,
      "max": 70,
      "step": 1,
      "default": 16,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 250,
      "step": 5,
      "default": 130,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Logo spacing",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 50,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Large card button"
    },

    {
      "type": "range",
      "id": "large_button_spacing",
      "label": "Button spacing",
      "min": 15,
      "max": 80,
      "step": 5,
      "default": 45,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 8,
      "max": 16,
      "step": 1,
      "default": 11,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Small cards"
    },

    {
      "type": "color",
      "id": "small_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "small_heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "small_text_size",
      "label": "Description size",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "small_content_padding",
      "label": "Content padding",
      "min": 15,
      "max": 60,
      "step": 1,
      "default": 30,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_large_height",
      "label": "Large card height",
      "min": 400,
      "max": 800,
      "step": 10,
      "default": 580,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_small_height",
      "label": "Small card height",
      "min": 180,
      "max": 400,
      "step": 10,
      "default": 260,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 3,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_content_width",
      "label": "Mobile content width",
      "min": 50,
      "max": 90,
      "step": 1,
      "default": 78,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "mobile_content_left",
      "label": "Mobile content left",
      "min": 5,
      "max": 25,
      "step": 1,
      "default": 8,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "mobile_content_top",
      "label": "Mobile content top",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 10,
      "unit": "%"
    },

    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 40,
      "max": 180,
