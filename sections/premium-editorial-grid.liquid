{% comment %}
  Editorial Image Grid
  1 large card + 4 smaller cards
{% endcomment %}

<section
  class="editorial-grid-section"
  id="editorial-grid-{{ section.id }}"
>
  <div class="editorial-grid">

    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="editorial-card editorial-card--{{ forloop.index }}"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '100vw',
              class: 'editorial-card__image'
          }}
        {% else %}
          <div class="editorial-card__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div
          class="editorial-card__overlay"
          style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
        ></div>

        <div class="editorial-card__content editorial-card__content--{{ block.settings.text_alignment }}">

          {% if block.settings.heading != blank %}
            <h2 class="editorial-card__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="editorial-card__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <span class="editorial-card__button">
              {{ block.settings.button_text }}
            </span>
          {% endif %}

        </div>

      </a>
    {% endfor %}

  </div>
</section>


<style>

  #editorial-grid-{{ section.id }} {
    --grid-gap: {{ section.settings.grid_gap }}px;
    --desktop-height: {{ section.settings.desktop_height }}px;
    --mobile-height: {{ section.settings.mobile_height }}px;
  }

  #editorial-grid-{{ section.id }} .editorial-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--grid-gap);

    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    height: var(--desktop-height);

    margin: 0 auto;
  }

  #editorial-grid-{{ section.id }} .editorial-card {
    position: relative;
    display: block;

    overflow: hidden;
    min-width: 0;

    text-decoration: none;
    color: {{ section.settings.text_color }};

    {% if section.settings.border_radius > 0 %}
      border-radius: {{ section.settings.border_radius }}px;
    {% endif %}
  }

  /*
    First card:
    Large card occupying the entire left side
  */

  #editorial-grid-{{ section.id }} .editorial-card--1 {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  /*
    Remaining cards:
    2 x 2 grid on the right
  */

  #editorial-grid-{{ section.id }} .editorial-card--2 {
    grid-column: 2;
    grid-row: 1;
  }

  #editorial-grid-{{ section.id }} .editorial-card--3 {
    grid-column: 3;
    grid-row: 1;
  }

  #editorial-grid-{{ section.id }} .editorial-card--4 {
    grid-column: 2;
    grid-row: 2;
  }

  #editorial-grid-{{ section.id }} .editorial-card--5 {
    grid-column: 3;
    grid-row: 2;
  }

  /*
    We actually need 3 columns:
    Large left + two smaller right columns
  */

  #editorial-grid-{{ section.id }} .editorial-grid {
    grid-template-columns: 1.5fr 1fr 1fr;
  }


  /* Image */

  #editorial-grid-{{ section.id }} .editorial-card__image,
  #editorial-grid-{{ section.id }} .editorial-card__placeholder {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform 0.7s cubic-bezier(.2,.65,.3,1);
  }

  #editorial-grid-{{ section.id }} .editorial-card__placeholder {
    background: #e9e9e9;
  }

  #editorial-grid-{{ section.id }} .editorial-card:hover .editorial-card__image {
    transform: scale(1.04);
  }


  /* Overlay */

  #editorial-grid-{{ section.id }} .editorial-card__overlay {
    position: absolute;

    inset: 0;

    background: #000;

    opacity: var(--overlay-opacity);

    pointer-events: none;

    transition: opacity 0.4s ease;
  }

  #editorial-grid-{{ section.id }} .editorial-card:hover .editorial-card__overlay {
    opacity: calc(var(--overlay-opacity) + 0.05);
  }


  /* Content */

  #editorial-grid-{{ section.id }} .editorial-card__content {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 2;

    padding: 40px;
  }

  #editorial-grid-{{ section.id }} .editorial-card__content--center {
    text-align: center;
  }

  #editorial-grid-{{ section.id }} .editorial-card__content--left {
    text-align: left;
  }

  #editorial-grid-{{ section.id }} .editorial-card__content--right {
    text-align: right;
  }


  /* Heading */

  #editorial-grid-{{ section.id }} .editorial-card__heading {
    margin: 0 0 10px;

    color: inherit;

    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;

    font-weight: 400;

    letter-spacing: -0.02em;
  }


  /* Text */

  #editorial-grid-{{ section.id }} .editorial-card__text {
    margin-bottom: 18px;

    color: inherit;

    font-size: {{ section.settings.text_size }}px;
    line-height: 1.55;

    max-width: 500px;
  }


  /* Button */

  #editorial-grid-{{ section.id }} .editorial-card__button {
    display: inline-block;

    padding-bottom: 5px;

    border-bottom: 1px solid currentColor;

    font-size: 12px;

    letter-spacing: 0.18em;

    text-transform: uppercase;

    transition:
      opacity 0.3s ease,
      letter-spacing 0.3s ease;
  }

  #editorial-grid-{{ section.id }} .editorial-card:hover .editorial-card__button {
    opacity: 0.75;
    letter-spacing: 0.22em;
  }


  /* Mobile */

  @media screen and (max-width: 749px) {

    #editorial-grid-{{ section.id }} {
      padding-left: 15px;
      padding-right: 15px;
    }

    #editorial-grid-{{ section.id }} .editorial-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      grid-template-rows:
        var(--mobile-height)
        var(--mobile-height)
        var(--mobile-height);

      height: auto;

      gap: var(--grid-gap);
    }

    /*
      First card spans both columns
    */

    #editorial-grid-{{ section.id }} .editorial-card--1 {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    #editorial-grid-{{ section.id }} .editorial-card--2 {
      grid-column: 1;
      grid-row: 2;
    }

    #editorial-grid-{{ section.id }} .editorial-card--3 {
      grid-column: 2;
      grid-row: 2;
    }

    #editorial-grid-{{ section.id }} .editorial-card--4 {
      grid-column: 1;
      grid-row: 3;
    }

    #editorial-grid-{{ section.id }} .editorial-card--5 {
      grid-column: 2;
      grid-row: 3;
    }

    #editorial-grid-{{ section.id }} .editorial-card__content {
      padding: 22px;
    }

    #editorial-grid-{{ section.id }} .editorial-card__heading {
      font-size: 20px;
    }

    #editorial-grid-{{ section.id }} .editorial-card__text {
      font-size: 13px;
    }

    #editorial-grid-{{ section.id }} .editorial-card__button {
      font-size: 10px;
    }

  }

</style>


{% schema %}

{
  "name": "Editorial Image Grid",

  "settings": [

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "default": 1600,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 700,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile card height",
      "min": 180,
      "max": 500,
      "step": 10,
      "default": 300,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 4,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 15,
      "unit": "px"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }

  ],

  "blocks": [

    {
      "type": "card",

      "name": "Image Card",

      "limit": 5,

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover more"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Explore"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },

        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",

          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],

          "default": "left"
        },

        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30,
          "unit": "%"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Editorial Image Grid",

      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }

  ]

}

{% endschema %}