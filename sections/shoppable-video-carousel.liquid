{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_alignment = section.settings.heading_alignment | default: 'left'
  assign aspect_ratio = section.settings.aspect_ratio | default: '9/16'
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign card_radius = section.settings.card_radius | default: 16
  assign section_width = section.settings.section_width | default: 'page-width'
%}

{% style %}
  .shoppable-video-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  .shoppable-video-section-{{ section.id }} .shoppable-video-carousel__card {
    border-radius: {{ card_radius }}px;
  }
{% endstyle %}

<div class="shoppable-video-section shoppable-video-section-{{ section.id }} section--{{ section_width }}">
  <shoppable-video-carousel class="shoppable-video-carousel" data-columns-desktop="{{ columns_desktop }}">
    <div class="shoppable-video-carousel__header shoppable-video-carousel__header--{{ heading_alignment }}">
      <div class="shoppable-video-carousel__header-text">
        {% if heading != blank %}
          <h2 class="shoppable-video-carousel__title">{{ heading }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="shoppable-video-carousel__subheading">{{ subheading }}</p>
        {% endif %}
      </div>

      <div class="shoppable-video-carousel__controls">
        {% if section.settings.view_all_link != blank and section.settings.view_all_text != blank %}
          <a href="{{ section.settings.view_all_link }}" class="shoppable-video-carousel__view-all">
            {{ section.settings.view_all_text }}
          </a>
        {% endif %}
        <div class="shoppable-video-carousel__nav-buttons">
          <button
            type="button"
            class="shoppable-video-carousel__arrow shoppable-video-carousel__arrow--prev"
            aria-label="Previous slide"
            disabled
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button
            type="button"
            class="shoppable-video-carousel__arrow shoppable-video-carousel__arrow--next"
            aria-label="Next slide"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div
      class="shoppable-video-carousel__track"
      style="
        --desktop-cols: {{ columns_desktop }};
        --card-aspect-ratio: {{ aspect_ratio }};
        --card-radius: {{ card_radius }}px;
      "
    >
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign title = block.settings.custom_title | default: product.title
          assign badge = block.settings.badge_text
          assign button_label = block.settings.button_label | default: 'Shop Now'
          assign poster_image = block.settings.cover_image | default: block.settings.video.preview_image | default: product.featured_image
        %}

        <div class="shoppable-video-carousel__card" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
          <div class="shoppable-video-carousel__media-wrapper">
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  image_size: '720x',
                  class: 'shoppable-video-carousel__video'
              }}
            {% elsif block.settings.video_url != blank %}
              <video
                class="shoppable-video-carousel__video"
                src="{{ block.settings.video_url }}"
                autoplay
                loop
                muted
                playsinline
                {% if poster_image != blank %}
                  poster="{{ poster_image | image_url: width: 720 }}"
                {% endif %}
              ></video>
            {% elsif poster_image != blank %}
              {{
                poster_image
                | image_url: width: 800
                | image_tag: class: 'shoppable-video-carousel__image', loading: 'lazy'
              }}
            {% else %}
              <div class="shoppable-video-carousel__placeholder">
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'shoppable-video-carousel__svg' }}
              </div>
            {% endif %}

            {% if badge != blank %}
              <span class="shoppable-video-carousel__badge">{{ badge }}</span>
            {% endif %}

            {% if block.settings.video != blank or block.settings.video_url != blank %}
              <button
                type="button"
                class="shoppable-video-carousel__sound-btn"
                aria-label="Toggle mute"
                title="Mute / Unmute"
              >
                <!-- Sound Off (Muted) -->
                <svg class="icon-sound-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
                <!-- Sound On -->
                <svg class="icon-sound-on hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
              </button>

              <div class="shoppable-video-carousel__play-indicator" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if product != blank %}
            <a href="{{ product.url }}" class="shoppable-video-carousel__product-pill" aria-label="{{ title | escape }}">
              <div class="shoppable-video-carousel__product-thumb">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 120, height: 120, crop: 'center'
                    | image_tag: class: 'shoppable-video-carousel__thumb-img', loading: 'lazy'
                  }}
                {% else %}
                  <div class="shoppable-video-carousel__thumb-fallback"></div>
                {% endif %}
              </div>
              <div class="shoppable-video-carousel__product-info">
                <span class="shoppable-video-carousel__product-title">{{ title }}</span>
                <div class="shoppable-video-carousel__product-price-row">
                  <span class="shoppable-video-carousel__product-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="shoppable-video-carousel__product-compare-price">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>
              <div class="shoppable-video-carousel__product-btn" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          {% elsif block.settings.custom_title != blank %}
            <div class="shoppable-video-carousel__product-pill">
              <div class="shoppable-video-carousel__product-info">
                <span class="shoppable-video-carousel__product-title">{{ title }}</span>
              </div>
            </div>
          {% else %}
            <div class="shoppable-video-carousel__product-pill shoppable-video-carousel__product-pill--placeholder">
              <div class="shoppable-video-carousel__product-thumb">
                <div class="shoppable-video-carousel__thumb-fallback"></div>
              </div>
              <div class="shoppable-video-carousel__product-info">
                <span class="shoppable-video-carousel__product-title">Select a Product</span>
                <span class="shoppable-video-carousel__product-price">Rs. 0.00</span>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </shoppable-video-carousel>
</div>

{% stylesheet %}
  .shoppable-video-section {
    position: relative;
    box-sizing: border-box;
  }

  .shoppable-video-carousel {
    display: block;
    position: relative;
    width: 100%;
  }

  .shoppable-video-carousel__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding: 0 16px;
  }

  @media screen and (min-width: 750px) {
    .shoppable-video-carousel__header {
      padding: 0;
    }
  }

  .shoppable-video-carousel__header--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .shoppable-video-carousel__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: currentColor;
  }

  @media screen and (min-width: 750px) {
    .shoppable-video-carousel__title {
      font-size: 1.85rem;
    }
  }

  .shoppable-video-carousel__subheading {
    margin: 6px 0 0;
    font-size: 0.95rem;
    color: rgba(0, 0, 0, 0.65);
  }

  .shoppable-video-carousel__controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .shoppable-video-carousel__view-all {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: currentColor;
    white-space: nowrap;
  }

  .shoppable-video-carousel__nav-buttons {
    display: none;
    align-items: center;
    gap: 8px;
  }

  @media screen and (min-width: 750px) {
    .shoppable-video-carousel__nav-buttons {
      display: flex;
    }
  }

  .shoppable-video-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #ffffff;
    color: #111111;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .shoppable-video-carousel__arrow:hover:not(:disabled) {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  .shoppable-video-carousel__arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Track & Grid */
  .shoppable-video-carousel__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 16px 16px;
    -webkit-overflow-scrolling: touch;
  }

  .shoppable-video-carousel__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .shoppable-video-carousel__track {
      gap: 16px;
      padding: 0 0 16px;
    }
  }

  /* Card */
  .shoppable-video-carousel__card {
    position: relative;
    flex: 0 0 calc(76vw - 20px);
    max-width: 340px;
    scroll-snap-align: start;
    aspect-ratio: var(--card-aspect-ratio, 9 / 16);
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    user-select: none;
  }

  @media screen and (min-width: 600px) {
    .shoppable-video-carousel__card {
      flex: 0 0 calc(45vw - 16px);
    }
  }

  @media screen and (min-width: 750px) {
    .shoppable-video-carousel__card {
      flex: 0 0 calc((100% - ((var(--desktop-cols, 4) - 1) * 16px)) / var(--desktop-cols, 4));
      max-width: none;
    }
  }

  .shoppable-video-carousel__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.16);
  }

  .shoppable-video-carousel__media-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .shoppable-video-carousel__video,
  .shoppable-video-carousel__image,
  .shoppable-video-carousel__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shoppable-video-carousel__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9ecef;
  }

  .shoppable-video-carousel__svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  /* Badge */
  .shoppable-video-carousel__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 20px;
    z-index: 2;
  }

  /* Sound Button */
  .shoppable-video-carousel__sound-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .shoppable-video-carousel__sound-btn:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: scale(1.08);
  }

  .shoppable-video-carousel__sound-btn .hidden {
    display: none !important;
  }

  /* Play/Pause Indicator Animation */
  .shoppable-video-carousel__play-indicator {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 3;
  }

  .shoppable-video-carousel__play-indicator.active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Product Floating Pill */
  .shoppable-video-carousel__product-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #111111;
    z-index: 4;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .shoppable-video-carousel__product-pill:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  .shoppable-video-carousel__product-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f1f1f1;
  }

  .shoppable-video-carousel__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shoppable-video-carousel__thumb-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0e0e0, #c8c8c8);
  }

  .shoppable-video-carousel__product-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shoppable-video-carousel__product-title {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #111111;
  }

  .shoppable-video-carousel__product-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .shoppable-video-carousel__product-price {
    font-size: 0.8rem;
    font-weight: 700;
    color: #111111;
  }

  .shoppable-video-carousel__product-compare-price {
    font-size: 0.72rem;
    text-decoration: line-through;
    color: rgba(0, 0, 0, 0.45);
  }

  .shoppable-video-carousel__product-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #111111;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .shoppable-video-carousel__product-pill:hover .shoppable-video-carousel__product-btn {
    transform: translateX(2px);
    background: #000000;
  }
{% endstylesheet %}

<script>
  if (!customElements.get('shoppable-video-carousel')) {
    class ShoppableVideoCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.shoppable-video-carousel__track');
        this.prevBtn = this.querySelector('.shoppable-video-carousel__arrow--prev');
        this.nextBtn = this.querySelector('.shoppable-video-carousel__arrow--next');
        this.cards = this.querySelectorAll('.shoppable-video-carousel__card');

        if (!this.track) return;

        this.initArrows();
        this.initVideos();
        this.initIntersectionObserver();
      }

      initArrows() {
        if (this.prevBtn && this.nextBtn) {
          this.prevBtn.addEventListener('click', () => this.scrollByDirection(-1));
          this.nextBtn.addEventListener('click', () => this.scrollByDirection(1));

          this.track.addEventListener('scroll', () => this.updateArrowStates(), { passive: true });
          this.updateArrowStates();
        }
      }

      scrollByDirection(direction) {
        const card = this.track.querySelector('.shoppable-video-carousel__card');
        if (!card) return;

        const cardWidth = card.offsetWidth;
        const gap = 16;
        const scrollAmount = (cardWidth + gap) * direction;

        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }

      updateArrowStates() {
        if (!this.prevBtn || !this.nextBtn) return;
        const tolerance = 4;
        const atStart = this.track.scrollLeft <= tolerance;
        const atEnd = this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - tolerance;

        this.prevBtn.disabled = atStart;
        this.nextBtn.disabled = atEnd;
      }

      initVideos() {
        this.cards.forEach((card) => {
          const video = card.querySelector('video');
          const soundBtn = card.querySelector('.shoppable-video-carousel__sound-btn');
          const mediaWrapper = card.querySelector('.shoppable-video-carousel__media-wrapper');
          const playIndicator = card.querySelector('.shoppable-video-carousel__play-indicator');

          if (!video) return;

          // Sound toggle
          if (soundBtn) {
            soundBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              e.preventDefault();

              const willBeMuted = !video.muted;
              if (!willBeMuted) {
                // Mute all other videos when one is unmuted
                this.querySelectorAll('video').forEach((v) => {
                  if (v !== video) {
                    v.muted = true;
                    const otherBtn = v.closest('.shoppable-video-carousel__card')?.querySelector('.shoppable-video-carousel__sound-btn');
                    if (otherBtn) this.updateSoundIcon(otherBtn, true);
                  }
                });
              }

              video.muted = willBeMuted;
              this.updateSoundIcon(soundBtn, willBeMuted);
            });
          }

          // Click video area to play/pause
          if (mediaWrapper) {
            mediaWrapper.addEventListener('click', (e) => {
              if (e.target.closest('.shoppable-video-carousel__sound-btn')) return;

              if (video.paused) {
                video.play();
                this.flashIndicator(playIndicator, false);
              } else {
                video.pause();
                this.flashIndicator(playIndicator, true);
              }
            });
          }
        });
      }

      updateSoundIcon(btn, isMuted) {
        const mutedIcon = btn.querySelector('.icon-sound-muted');
        const onIcon = btn.querySelector('.icon-sound-on');
        if (mutedIcon && onIcon) {
          if (isMuted) {
            mutedIcon.classList.remove('hidden');
            onIcon.classList.add('hidden');
          } else {
            mutedIcon.classList.add('hidden');
            onIcon.classList.remove('hidden');
          }
        }
      }

      flashIndicator(indicator, isPaused) {
        if (!indicator) return;
        indicator.classList.add('active');
        setTimeout(() => {
          indicator.classList.remove('active');
        }, 400);
      }

      initIntersectionObserver() {
        if (!('IntersectionObserver' in window)) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target.querySelector('video');
              if (!video) return;

              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.35 }
        );

        this.cards.forEach((card) => observer.observe(card));
      }
    }

    customElements.define('shoppable-video-carousel', ShoppableVideoCarousel);
  }
</script>

{% schema %}
{
  "name": "Shoppable video carousel",
  "tag": "section",
  "class": "shopify-section-shoppable-video-carousel",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch & Shop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap any video to play, explore, and shop the look"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
