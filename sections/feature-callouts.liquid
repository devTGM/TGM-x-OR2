            "detail_body": "<p>Stone-washed at 60 degrees for pre-shrinking and that naturally relaxed drape. Breathable in summer, insulating in winter.</p>"
          }
        },
        {
          "type": "callout",
          "settings": {
            "pin_x": 54,
            "pin_y": 68,
            "label": "Buttons",
            "detail_heading": "Corozo nut buttons",
            "detail_body": "<p>Carved from the tagua nut — a sustainable alternative to plastic. Naturally matte, no two are identical.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
