      "max": 7,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F5F0EC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Pin and accent colour",
      "default": "#1C1C1C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        {
          "type": "header",
          "content": "Pin position"
        },
        {
          "type": "paragraph",
          "content": "Set X (left to right) and Y (top to bottom) as a percentage within the image."
        },
        {
          "type": "range",
          "id": "pin_x",
          "label": "Horizontal position (X %)",
          "min": 2,
          "max": 98,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "pin_y",
          "label": "Vertical position (Y %)",
          "min": 2,
          "max": 98,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "header",
          "content": "Detail write-up"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Feature label",
          "default": "Collar",
          "info": "Short all-caps label shown beside the pin number"
        },
        {
          "type": "text",
          "id": "detail_heading",
          "label": "Heading",
          "default": "Italian poplin collar"
        },
        {
          "type": "richtext",
          "id": "detail_body",
          "label": "Write-up",
          "default": "<p>Crafted from 100-thread-count European flax, the collar holds its shape through dozens of washes — no starch required. The inner lining is hand-fused for a crisp, flat appearance that relaxes beautifully over time.</p>"
