{%- liquid
  assign section_bg   = section.settings.background_color | default: '#F5F0EC'
  assign accent_color = section.settings.accent_color | default: '#1C1C1C'
-%}

<section
  class="fcs-section section-wrapper"
  id="FeatureCallouts-{{ section.id }}"
  style="background-color: {{ section_bg }};"
>

  {{- '<!-- Feature Callouts — ON REPEAT -->' -}}

  {%- if section.settings.overline != blank or section.settings.heading != blank or section.settings.writeup != blank -%}
    <div class="fcs__intro">
      {%- if section.settings.overline != blank -%}
        <p class="fcs__overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fcs__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.writeup != blank -%}
        <div class="fcs__writeup rte">{{ section.settings.writeup }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fcs__layout">

    <!-- LEFT: Image + pins -->
    <div class="fcs__image-col">
      <div class="fcs__image-wrap" id="FcsImageWrap-{{ section.id }}">

        {%- if section.settings.product_image != blank -%}
          {{
            section.settings.product_image
            | image_url: width: 1200
            | image_tag:
              class: 'fcs__product-img',
              loading: 'lazy',
              widths: '400,600,800,1000,1200',
              sizes: '(max-width: 749px) 100vw, 55vw'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'fcs__product-img fcs__product-img--placeholder' }}
        {%- endif -%}

        {%- for block in section.blocks -%}
          <button
            class="fcs__pin{% if forloop.first %} is-active{% endif %}"
            data-fcs-pin="{{ forloop.index }}"
            data-section="{{ section.id }}"
            style="left:{{ block.settings.pin_x | default: 50 }}%;top:{{ block.settings.pin_y | default: 30 }}%;--pin-accent:{{ accent_color }};"
            aria-label="{{ block.settings.label | default: 'Feature' }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="fcs__pin-ring"></span>
            <span class="fcs__pin-number">{{ forloop.index }}</span>
          </button>
        {%- endfor -%}

      </div>
    </div>

    <!-- RIGHT: Detail panel -->
    <div class="fcs__detail-col" id="FcsDetailCol-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="fcs__detail{% if forloop.first %} is-active{% endif %}"
          data-fcs-detail="{{ forloop.index }}"
          data-section="{{ section.id }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="fcs__detail-inner">

            <div class="fcs__detail-header">
              <span class="fcs__detail-num" style="--pin-accent:{{ accent_color }};">{{ forloop.index }}</span>
              <span class="fcs__detail-label">{{ block.settings.label | default: 'Feature' }}</span>
            </div>

            {%- if block.settings.detail_heading != blank -%}
              <h3 class="fcs__detail-heading">{{ block.settings.detail_heading }}</h3>
            {%- endif -%}

            {%- if block.settings.detail_body != blank -%}
              <div class="fcs__detail-body rte">{{ block.settings.detail_body }}</div>
            {%- endif -%}

            {%- if block.settings.detail_image != blank -%}
              <div class="fcs__detail-img-wrap">
                {{
                  block.settings.detail_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'fcs__detail-img',
                    loading: 'lazy',
                    widths: '280,400,600',
                    sizes: '(max-width: 749px) 80vw, 280px'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.cta_text != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}" class="fcs__detail-cta">
                {{ block.settings.cta_text }}<span class="fcs__cta-arrow" aria-hidden="true">&#8594;</span>
              </a>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* ─── Layout ────────────────────────────────────────────── */
  .fcs-section {
    padding: {{ section.settings.padding_top }}px var(--page-margin, 24px) {{ section.settings.padding_bottom }}px;
  }

  /* ─── Intro block ───────────────────────────────────────── */
  .fcs__intro {
    text-align: {{ section.settings.intro_alignment }};
    margin: 0 auto clamp(36px, 5vw, 60px);
    max-width: 720px;
  }

  .fcs__overline {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8580;
    margin: 0 0 12px;
  }

  .fcs__heading {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #1C1C1C;
    margin: 0 0 20px;
  }

  /* ── Write-up paragraph ─────────────────────────────────── */
  .fcs__writeup {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 16px;
    line-height: 1.8;
    color: #4A4540;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .fcs__writeup p { margin: 0 0 12px; }
  .fcs__writeup p:last-child { margin-bottom: 0; }

  /* ─── Two-column layout ────────────────────────────────── */
  .fcs__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .fcs__layout {
      grid-template-columns: {{ section.settings.image_width }}fr {{ 10 | minus: section.settings.image_width }}fr;
      gap: clamp(40px, 6vw, 88px);
    }
  }

  /* ─── Image wrap ────────────────────────────────────────── */
  .fcs__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #EAE6DF;
  }

  .fcs__product-img,
  .fcs__product-img--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fcs__product-img--placeholder { opacity: 0.4; }

  /* ─── Pins ──────────────────────────────────────────────── */
  .fcs__pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.25s ease;
  }
  .fcs__pin:hover { transform: translate(-50%, -50%) scale(1.12); }

  .fcs__pin-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.22);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 2px 14px rgba(0,0,0,0.22);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .fcs__pin.is-active .fcs__pin-ring,
  .fcs__pin:hover .fcs__pin-ring {
    background: var(--pin-accent, #1C1C1C);
    border-color: var(--pin-accent, #1C1C1C);
  }

  .fcs__pin-number {
    position: relative;
    z-index: 1;
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #1C1C1C;
    transition: color 0.25s ease;
    line-height: 1;
  }
  .fcs__pin.is-active .fcs__pin-number,
  .fcs__pin:hover .fcs__pin-number { color: #fff; }

  /* Pulse on inactive pins */
  .fcs__pin:not(.is-active) .fcs__pin-ring::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.55);
    animation: fcs-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes fcs-pulse {
    0%   { opacity: 0.85; transform: scale(1); }
    70%  { opacity: 0;    transform: scale(1.55); }
    100% { opacity: 0;    transform: scale(1.55); }
  }

  @media screen and (max-width: 749px) {
    .fcs__pin { width: 30px; height: 30px; }
    .fcs__pin-number { font-size: 11px; }
  }

  /* ─── Detail column ─────────────────────────────────────── */
  .fcs__detail-col {
    position: relative;
    min-height: 260px;
  }

  /* Desktop: absolute-stacked, fade/slide */
  @media screen and (min-width: 750px) {
    .fcs__detail {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .fcs__detail.is-active {
      position: relative;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  /* Mobile: show/hide */
  @media screen and (max-width: 749px) {
    .fcs__detail-col { min-height: unset; }
    .fcs__detail { display: none; }
    .fcs__detail.is-active { display: block; }
  }

  .fcs__detail-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Number + label row */
  .fcs__detail-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .fcs__detail-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--pin-accent, #1C1C1C);
    color: #fff;
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
  }

  .fcs__detail-label {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8A8580;
  }

  .fcs__detail-heading {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #1C1C1C;
    margin: 0;
  }

  .fcs__detail-body {
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 15.5px;
    line-height: 1.75;
    color: #4A4540;
  }
  .fcs__detail-body p { margin: 0 0 10px; }
  .fcs__detail-body p:last-child { margin-bottom: 0; }

  .fcs__detail-img-wrap {
    overflow: hidden;
    border-radius: 4px;
    max-width: 320px;
  }
  .fcs__detail-img {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  .fcs__detail-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body-custom--family, 'Red Hat Text', sans-serif);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1C1C1C;
    text-decoration: none;
    border-bottom: 1px solid #1C1C1C;
    padding-bottom: 2px;
    width: fit-content;
    transition: opacity 0.2s ease;
  }
  .fcs__detail-cta:hover { opacity: 0.55; }
  .fcs__cta-arrow { display: inline-block; transition: transform 0.2s ease; }
  .fcs__detail-cta:hover .fcs__cta-arrow { transform: translateX(4px); }
</style>

<script>
  (function () {
    var sid     = '{{ section.id }}';
    var imgWrap = document.getElementById('FcsImageWrap-' + sid);
    var detCol  = document.getElementById('FcsDetailCol-' + sid);
    if (!imgWrap || !detCol) return;

    var pins    = Array.from(imgWrap.querySelectorAll('[data-fcs-pin][data-section="' + sid + '"]'));
    var details = Array.from(detCol.querySelectorAll('[data-fcs-detail][data-section="' + sid + '"]'));

    function activate(idx) {
      pins.forEach(function (p, i) {
        var on = (i === idx);
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      details.forEach(function (d, i) {
        var on = (i === idx);
        d.classList.toggle('is-active', on);
        d.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
    }

    pins.forEach(function (pin, i) {
      pin.addEventListener('click', function () { activate(i); });
    });
  })();
</script>

{% schema %}
{
  "name": "Feature Callouts",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "Intro alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline (small caps label)",
      "default": "Craftsmanship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made with intention"
    },
    {
      "type": "richtext",
      "id": "writeup",
      "label": "Write-up / intro paragraph",
      "info": "Optional editorial paragraph shown below the heading, above the image and details.",
      "default": "<p>Every detail of this shirt has been considered from the ground up — from the stone-washed European flax to the hand-finished corozo buttons. Here is what sets it apart.</p>"
    },
    {
      "type": "header",
      "content": "Product image"
