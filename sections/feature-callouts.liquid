          "label": "Close-up image (optional)"
        },
        {
          "type": "header",
          "content": "Optional link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Link text",
          "placeholder": "Learn more"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Callouts",
      "blocks": [
        {
          "type": "callout",
          "settings": {
            "pin_x": 50,
            "pin_y": 16,
            "label": "Collar",
            "detail_heading": "Italian poplin collar",
            "detail_body": "<p>The collar is fused with a hair-canvas interlining — holds its shape wash after wash, no starch needed.</p>"
