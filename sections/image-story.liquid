{% comment %}
  Image Story Section — ON REPEAT
  Asymmetric overlapping dual-image collage with editorial narrative.
  Quiet luxury aesthetic: warm neutrals, refined serif + sans-serif typography,
  pull-quote with gold accent bar, dark CTA with arrow glide.
{% endcomment %}

{%- liquid
  assign bg      = section.settings.background_color | default: '#F4F0EB'
  assign txt     = section.settings.text_color       | default: '#1C1C1C'
  assign accent  = section.settings.accent_color     | default: '#8F8171'
  assign qbar    = section.settings.quote_bar_color  | default: '#C5A880'
  assign frame   = section.settings.frame_color      | default: '#EAE6DF'
  assign dir     = section.settings.layout_direction  | default: 'media_first'
-%}

<section
  class="imgstory section-wrapper"
  id="ImageStory-{{ section.id }}"
  style="
    --is-bg: {{ bg }};
    --is-txt: {{ txt }};
    --is-accent: {{ accent }};
    --is-qbar: {{ qbar }};
    --is-frame: {{ frame }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  "
>
  <div class="page-width">
    <div class="imgstory__grid layout--{{ dir }}">

      <!-- ═══ Image Column ═══ -->
      <div class="imgstory__media">
        <!-- Back (Main) Image -->
        <div class="imgstory__main-wrap">
          {%- if section.settings.main_image != blank -%}
            {%- assign m_alt = section.settings.heading_main | default: 'Image Story' | escape -%}
            {{ section.settings.main_image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1000',
                class: 'imgstory__img imgstory__img--main',
                alt: m_alt
            }}
          {%- else -%}
            <div class="imgstory__placeholder imgstory__placeholder--main">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Main Image</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Front Overlapping Detail Image -->
        <div class="imgstory__detail-wrap">
          {%- if section.settings.detail_image != blank -%}
            {%- assign d_alt = section.settings.heading_italic | default: 'Detail' | escape -%}
            {{ section.settings.detail_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '300, 500, 700, 800',
                class: 'imgstory__img imgstory__img--detail',
                alt: d_alt
            }}
          {%- else -%}
            <div class="imgstory__placeholder imgstory__placeholder--detail">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Detail Image</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- ═══ Narrative Column ═══ -->
      <div class="imgstory__text">

        {%- if section.settings.overline != blank -%}
          <div class="imgstory__overline-row">
            <span class="imgstory__overline">{{ section.settings.overline | escape }}</span>
            {%- if section.settings.show_overline_line -%}
              <span class="imgstory__overline-line" aria-hidden="true"></span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.heading_main != blank or section.settings.heading_italic != blank -%}
          <h2 class="imgstory__heading">
            {%- if section.settings.heading_main != blank -%}
              <span class="imgstory__heading-main">{{ section.settings.heading_main | escape }}</span>
            {%- endif -%}
            {%- if section.settings.heading_italic != blank -%}
              <span class="imgstory__heading-italic">{{ section.settings.heading_italic | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.lead_paragraph != blank -%}
          <div class="imgstory__lead">{{ section.settings.lead_paragraph }}</div>
        {%- endif -%}

        {%- if section.settings.quote_text != blank -%}
          <blockquote class="imgstory__quote">{{ section.settings.quote_text }}</blockquote>
        {%- endif -%}

        {%- if section.settings.body_paragraph != blank -%}
          <div class="imgstory__body">{{ section.settings.body_paragraph }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="imgstory__action">
            <a href="{{ section.settings.button_link }}" class="imgstory__btn">
              <span>{{ section.settings.button_label | escape }}</span>
              <span class="imgstory__btn-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ Styles ═══════════════ -->
<style>
  /* ── Base ── */
  .imgstory {
    background-color: var(--is-bg, #F4F0EB);
    color: var(--is-txt, #1C1C1C);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
  }
  .imgstory *, .imgstory *::before, .imgstory *::after { box-sizing: border-box; }

  /* ── Grid ── */
  .imgstory__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(3.5rem, 6.5vw, 7rem);
    align-items: center;
  }
  .imgstory__grid.layout--text_first {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  }
  .imgstory__grid.layout--text_first .imgstory__media { order: 2; }
  .imgstory__grid.layout--text_first .imgstory__text  { order: 1; }

  /* ── Media Column ── */
  .imgstory__media {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding-bottom: 50px;   /* room for the overlapping detail */
  }

  /* Back / Main Image */
  .imgstory__main-wrap {
    position: relative;
    width: 76%;
    aspect-ratio: 1 / 1.14;
    background-color: #E2DDD5;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .imgstory__main-wrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }
  .imgstory__media:hover .imgstory__main-wrap img { transform: scale(1.02); }

  /* Front Detail Image */
  .imgstory__detail-wrap {
    position: absolute;
    right: 0; bottom: 0;
    width: 58%;
    aspect-ratio: 1 / 1.08;
    background-color: var(--is-frame, #EAE6DF);
    border: 10px solid var(--is-frame, #EAE6DF);
    box-shadow: 0 16px 40px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.06);
    overflow: hidden;
    z-index: 2;
  }
  .imgstory__detail-wrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }
  .imgstory__media:hover .imgstory__detail-wrap img { transform: scale(1.03); }

  /* Placeholders (visible in editor when no image is set) */
  .imgstory__placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 100%; height: 100%;
    background-color: #E8E3DC;
    color: #9C9082;
    gap: 8px;
  }
  .imgstory__placeholder svg { width: 36px; height: 36px; opacity: 0.45; }
  .imgstory__placeholder span {
    font-family: var(--font-body-custom--family, system-ui, sans-serif);
    font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }

  /* ── Text Column ── */
  .imgstory__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 560px;
  }

  /* Overline */
  .imgstory__overline-row {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 24px; width: 100%;
  }
  .imgstory__overline {
    font-family: var(--font-body-custom--family, 'Red Hat Text', system-ui, sans-serif);
    font-size: 11px; font-weight: 600; letter-spacing: 0.22em;
    text-transform: uppercase; color: #9C9082;
    white-space: nowrap; line-height: 1;
  }
  .imgstory__overline-line {
    flex-grow: 1; height: 1px; background-color: #DED7CD;
  }

  /* Heading */
  .imgstory__heading {
    font-family: var(--font-heading-custom--family, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2.4rem, 4.2vw, 3.85rem);
    font-weight: 300; line-height: 1.12; letter-spacing: -0.01em;
    color: var(--is-txt, #1C1C1C);
    margin: 0 0 24px 0;
  }
  .imgstory__heading-main  { display: block; }
  .imgstory__heading-italic {
    display: block; font-style: italic; font-weight: 300;
    color: var(--is-accent, #8F8171); margin-top: 4px;
  }

  /* Lead */
  .imgstory__lead {
    font-family: var(--font-body-custom--family, 'Red Hat Text', system-ui, sans-serif);
    font-size: 14.5px; font-weight: 400; line-height: 1.75;
    color: #585149; margin: 0 0 24px 0;
  }
  .imgstory__lead p { margin: 0; }

  /* Pull Quote */
  .imgstory__quote {
    border-left: 2px solid var(--is-qbar, #C5A880);
    padding-left: 22px; margin: 26px 0;
    font-family: var(--font-heading-custom--family, 'Cormorant Garamond', Georgia, serif);
    font-style: italic; font-size: clamp(1.22rem, 1.65vw, 1.48rem);
    font-weight: 400; line-height: 1.48; color: #38312B;
    quotes: none;
  }
  .imgstory__quote p { margin: 0; }

  /* Body */
  .imgstory__body {
    font-family: var(--font-body-custom--family, 'Red Hat Text', system-ui, sans-serif);
    font-size: 13.5px; font-weight: 400; line-height: 1.75;
    color: #6C655E; margin: 0 0 34px 0;
  }
  .imgstory__body p { margin: 0; }

  /* CTA Button */
  .imgstory__action { display: flex; align-items: center; }
  .imgstory__btn {
    display: inline-flex; align-items: center; gap: 12px;
    background-color: #1C1C1C; color: #FFFFFF;
    border: 1px solid #1C1C1C; border-radius: 0;
    padding: 15px 34px;
    font-family: var(--font-body-custom--family, 'Red Hat Text', system-ui, sans-serif);
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; text-decoration: none; cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .imgstory__btn:hover {
    background-color: #38312B; border-color: #38312B;
    color: #FFFFFF; transform: translateY(-1px);
  }
  .imgstory__btn-arrow {
    display: inline-block; font-size: 13px; line-height: 1;
    transition: transform 0.2s ease;
  }
  .imgstory__btn:hover .imgstory__btn-arrow { transform: translateX(4px); }

  /* ── Responsive ── */
  @media screen and (max-width: 860px) {
    .imgstory__grid {
      grid-template-columns: 1fr; gap: 3.5rem;
    }
    .imgstory__grid.layout--text_first .imgstory__media { order: 1; }
    .imgstory__grid.layout--text_first .imgstory__text  { order: 2; }
    .imgstory__media { max-width: 420px; padding-bottom: 30px; }
    .imgstory__main-wrap { width: 78%; }
    .imgstory__detail-wrap { width: 58%; border-width: 8px; }
    .imgstory__text { max-width: 100%; }
    .imgstory__heading { font-size: 2.35rem; }
    .imgstory__quote { font-size: 1.25rem; }
  }

  @media screen and (max-width: 480px) {
    .imgstory__media { max-width: 320px; }
    .imgstory__detail-wrap { border-width: 6px; }
    .imgstory__btn { padding: 14px 28px; width: 100%; justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Image Story",
  "tag": "section",
  "class": "section-image-story",
  "settings": [
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Back Image",
      "info": "Large editorial portrait or lifestyle shot."
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Overlapping Detail Image",
      "info": "Close-up craft or embroidery detail with frame border."
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Detail Frame Color",
      "default": "#EAE6DF"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout Direction",
      "options": [
        { "value": "media_first", "label": "Images Left / Text Right" },
        { "value": "text_first",  "label": "Text Left / Images Right" }
      ],
      "default": "media_first"
    },
    {
      "type": "header",
      "content": "Narrative"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "HERITAGE"
    },
    {
      "type": "checkbox",
      "id": "show_overline_line",
      "label": "Show Hairline Next to Overline",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Heading — Main Line",
      "default": "A Story"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading — Italic Line",
      "default": "Worth Wearing"
    },
    {
      "type": "richtext",
      "id": "lead_paragraph",
      "label": "Lead Paragraph",
      "default": "<p>ON REPEAT was born from a conviction — that everyday clothing could carry the weight of tradition while moving effortlessly through the modern world.</p>"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Pull Quote",
      "default": "\"Not just clothing, but a collectible statement of refined taste.\""
    },
    {
      "type": "richtext",
      "id": "body_paragraph",
      "label": "Body Paragraph",
      "default": "<p>We believe in the permanence of quality over the transience of trends. Each Edition is a chapter — deliberate, considered, and made to outlast the season it arrives in.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/pages/our-story"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F4F0EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Italic Heading Color",
      "default": "#8F8171"
    },
    {
      "type": "color",
      "id": "quote_bar_color",
      "label": "Quote Accent Bar Color",
      "default": "#C5A880"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Image Story"
    }
  ]
}
{% endschema %}
