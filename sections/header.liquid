/* =========================================================
   ON REPEAT
   TRANSPARENT HEADER
   ========================================================= */

/* Transparent header layout */
body:has(#header-component[transparent])
  .content-for-layout
  > .shopify-section:first-child {
  margin-top: 0 !important;
}

/* Header itself must not create any additional vertical space */
body:has(#header-component[transparent]) #header-group {
  margin: 0 !important;
  padding: 0 !important;
}

/* Header section sits over the first section */
body:has(#header-component[transparent])
  #header-group
  > .header-section {
  margin: 0 !important;
  padding: 0 !important;
  z-index: var(--layer-menu-drawer);
}

/* Transparent header is already positioned absolutely by
   .header[transparent]. Keep it at the very top. */
body:has(#header-component[transparent]) #header-component {
  margin: 0 !important;
  padding: 0 !important;
}

/* Do not add the header height back to the Hero */
.header-section:has(.header[transparent]) + .shopify-section {
  margin-top: 0 !important;
}

/* Make sure the first page section starts at the viewport top */
body:has(#header-component[transparent])
  .content-for-layout
  > .shopify-section:first-child {
  margin-block-start: 0 !important;
  padding-block-start: 0 !important;
}