{% comment %}
  ON REPEAT
  Automatic Recommended Collection

  Recommendation:
  The Classic -> The Modern
  The Modern  -> The Classic
  The Resort  -> The Classic

  No collection selection required.
{% endcomment %}

{% assign current_handle = collection.handle %}
{% assign recommended_handle = '' %}

{% if current_handle == 'the-classic' %}

  {% assign recommended_handle = 'the-modern' %}

{% elsif current_handle == 'the-modern' %}

  {% assign recommended_handle = 'the-classic' %}

{% elsif current_handle == 'the-resort' %}

  {% assign recommended_handle = 'the-classic' %}

{% endif %}

{% assign recommended_collection = collections[recommended_handle] %}


{% if recommended_collection != blank and recommended_collection.products_count > 0 %}

<section
  id="recommended-collection-{{ section.id }}"
  class="recommended-collection"
>

  <div class="recommended-collection__container">

    <!-- HEADER -->

    <div class="recommended-collection__header">

      <div class="recommended-collection__heading">

        {% if section.settings.eyebrow != blank %}
          <div class="recommended-collection__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h2 class="recommended-collection__title">

          {% if current_handle == 'the-classic' %}

            {{ section.settings.classic_heading }}

          {% elsif current_handle == 'the-modern' %}

            {{ section.settings.modern_heading }}

          {% elsif current_handle == 'the-resort' %}

            {{ section.settings.resort_heading }}

          {% else %}

            {{ section.settings.default_heading }}

          {% endif %}

        </h2>

        {% if current_handle == 'the-classic' %}

          {% if section.settings.classic_description != blank %}
            <div class="recommended-collection__description">
              {{ section.settings.classic_description }}
            </div>
          {% endif %}

        {% elsif current_handle == 'the-modern' %}

          {% if section.settings.modern_description != blank %}
            <div class="recommended-collection__description">
              {{ section.settings.modern_description }}
            </div>
          {% endif %}

        {% elsif current_handle == 'the-resort' %}

          {% if section.settings.resort_description != blank %}
            <div class="recommended-collection__description">
              {{ section.settings.resort_description }}
            </div>
          {% endif %}

        {% endif %}

      </div>


      <!-- DESKTOP LINK -->

      <a
        href="{{ recommended_collection.url }}"
        class="recommended-collection__link"
      >
        <span>{{ section.settings.button_text }}</span>
        <span class="recommended-collection__arrow">→</span>
      </a>

    </div>


    <!-- PRODUCTS -->

    <div class="recommended-collection__grid">

      {% for product in recommended_collection.products limit: section.settings.products_to_show %}

        <article class="recommended-product">

          <a
            href="{{ product.url }}"
            class="recommended-product__image"
          >

            {% if product.featured_image %}

              <div class="recommended-product__image-primary">

                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                    alt: product.featured_image.alt | default: product.title
                }}

              </div>


              {% if product.images.size > 1 %}

                <div class="recommended-product__image-hover">

                  {{
                    product.images[1]
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                      alt: product.images[1].alt | default: product.title
                  }}

                </div>

              {% endif %}

            {% else %}

              {{ 'product-1' | placeholder_svg_tag }}

            {% endif %}


            {% if product.available == false %}

              <span class="recommended-product__badge">
                Sold Out
              </span>

            {% elsif product.compare_at_price > product.price %}

              <span class="recommended-product__badge">
                Sale
              </span>

            {% endif %}

          </a>


          <div class="recommended-product__details">

            <a
              href="{{ product.url }}"
              class="recommended-product__title"
            >
              {{ product.title }}
            </a>


            <div class="recommended-product__price">

              {% if product.compare_at_price > product.price %}

                <span>
                  {{ product.price | money }}
                </span>

                <span class="recommended-product__compare">
                  {{ product.compare_at_price | money }}
                </span>

              {% else %}

                <span>
                  {{ product.price | money }}
                </span>

              {% endif %}

            </div>

          </div>

        </article>

      {% endfor %}

    </div>


    <!-- MOBILE LINK -->

    <a
      href="{{ recommended_collection.url }}"
      class="recommended-collection__mobile-link"
    >
      <span>{{ section.settings.button_text }}</span>
      <span>→</span>
    </a>

  </div>

</section>

{% endif %}


<style>

  /* =====================================================
     CONTAINER
     ===================================================== */

  #recommended-collection-{{ section.id }} {

    width: 100%;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__container {

    width: 100%;

    max-width: 1440px;

    margin: 0 auto;

    padding:
      {{ section.settings.padding_top }}px
      clamp(24px, 4vw, 64px)
      {{ section.settings.padding_bottom }}px;

  }


  /* =====================================================
     HEADER
     ===================================================== */

  #recommended-collection-{{ section.id }} .recommended-collection__header {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 40px;

    margin-bottom: 42px;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__heading {

    max-width: 700px;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__eyebrow {

    margin-bottom: 12px;

    font-size: 11px;

    font-weight: 500;

    letter-spacing: 0.16em;

    line-height: 1.2;

    text-transform: uppercase;

    opacity: 0.6;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__title {

    margin: 0;

    font-size: clamp(30px, 3.5vw, 52px);

    font-weight: 400;

    line-height: 1.08;

    letter-spacing: -0.02em;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__description {

    max-width: 560px;

    margin-top: 14px;

    font-size: 14px;

    line-height: 1.6;

    opacity: 0.65;

  }


  /* =====================================================
     DESKTOP BUTTON
     ===================================================== */

  #recommended-collection-{{ section.id }} .recommended-collection__link {

    display: inline-flex;

    align-items: center;

    gap: 18px;

    padding-bottom: 8px;

    border-bottom: 1px solid currentColor;

    color: inherit;

    font-size: 11px;

    font-weight: 500;

    letter-spacing: 0.14em;

    line-height: 1;

    text-decoration: none;

    text-transform: uppercase;

    white-space: nowrap;

  }


  #recommended-collection-{{ section.id }} .recommended-collection__arrow {

    font-size: 17px;

    transition: transform 0.25s ease;

  }


  #recommended-collection-{{ section.id }}
  .recommended-collection__link:hover
  .recommended-collection__arrow {

    transform: translateX(5px);

  }


  /* =====================================================
     PRODUCT GRID
     ===================================================== */

  #recommended-collection-{{ section.id }} .recommended-collection__grid {

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 18px;

  }


  /* =====================================================
     PRODUCT
     ===================================================== */

  #recommended-collection-{{ section.id }} .recommended-product {

    min-width: 0;

  }


  /* =====================================================
     IMAGE
     ===================================================== */

  #recommended-collection-{{ section.id }} .recommended-product__image {

    position: relative;

    display: block;

    width: 100%;

    aspect-ratio: 3 / 4;

    overflow: hidden;

    text-decoration: none;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__image-primary,

  #recommended-collection-{{ section.id }}
  .recommended-product__image-hover {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__image img {

    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position: center;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__image-primary {

    z-index: 1;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__image-hover {

    z-index: 2;

    opacity: 0;

    transition: opacity 0.4s ease;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__image:hover
  .recommended-product__image-hover {

    opacity: 1;

  }


  /* =====================================================
     BADGE
     ===================================================== */

  #recommended-collection-{{ section.id }}
  .recommended-product__badge {

    position: absolute;

    top: 12px;

    left: 12px;

    z-index: 5;

    padding: 7px 9px;

    background: rgb(255 255 255 / 90%);

    color: #222;

    font-size: 9px;

    letter-spacing: 0.1em;

    line-height: 1;

    text-transform: uppercase;

  }


  /* =====================================================
     PRODUCT DETAILS
     ===================================================== */

  #recommended-collection-{{ section.id }}
  .recommended-product__details {

    padding-top: 13px;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__title {

    display: inline-block;

    color: inherit;

    font-size: 14px;

    font-weight: 400;

    line-height: 1.4;

    text-decoration: none;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__price {

    display: flex;

    gap: 8px;

    margin-top: 5px;

    font-size: 12px;

    line-height: 1.4;

  }


  #recommended-collection-{{ section.id }}
  .recommended-product__compare {

    opacity: 0.5;

    text-decoration: line-through;

  }


  /* =====================================================
     MOBILE LINK
     ===================================================== */

  #recommended-collection-{{ section.id }}
  .recommended-collection__mobile-link {

    display: none;

  }


  /* =====================================================
     TABLET
     ===================================================== */

  @media screen and (max-width: 1000px) {

    #recommended-collection-{{ section.id }}
    .recommended-collection__grid {

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

    }

  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media screen and (max-width: 749px) {

    #recommended-collection-{{ section.id }}
    .recommended-collection__container {

      padding:
        {{ section.settings.mobile_padding_top }}px
        18px
        {{ section.settings.mobile_padding_bottom }}px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__header {

      display: block;

      margin-bottom: 26px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__eyebrow {

      font-size: 10px;

      margin-bottom: 10px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__title {

      font-size: 32px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__description {

      margin-top: 12px;

      font-size: 13px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__link {

      display: none;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__grid {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 28px 10px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-product__image {

      aspect-ratio: 3 / 4;

    }


    #recommended-collection-{{ section.id }}
    .recommended-product__details {

      padding-top: 10px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-product__title {

      font-size: 12px;

      line-height: 1.35;

    }


    #recommended-collection-{{ section.id }}
    .recommended-product__price {

      margin-top: 4px;

      font-size: 11px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-product__badge {

      top: 8px;

      left: 8px;

      padding: 6px 7px;

      font-size: 8px;

    }


    #recommended-collection-{{ section.id }}
    .recommended-collection__mobile-link {

      display: flex;

      align-items: center;

      justify-content: space-between;

      min-height: 50px;

      margin-top: 30px;

      padding: 0 16px;

      border: 1px solid currentColor;

      color: inherit;

      font-size: 10px;

      font-weight: 500;

      letter-spacing: 0.14em;

      text-decoration: none;

      text-transform: uppercase;

    }

  }

</style>


{% schema %}

{
  "name": "Recommended Collection",
  "tag": "section",
  "class": "section-recommended-collection",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "You May Also Like"
    },

    {
      "type": "text",
      "id": "classic_heading",
      "label": "The Classic Heading",
      "default": "Explore The Modern"
    },

    {
      "type": "textarea",
      "id": "classic_description",
      "label": "The Classic Description",
      "default": "A contemporary edit of considered pieces, designed for a modern wardrobe."
    },

    {
      "type": "text",
      "id": "modern_heading",
      "label": "The Modern Heading",
      "default": "Explore The Classic"
    },

    {
      "type": "textarea",
      "id": "modern_description",
      "label": "The Modern Description",
      "default": "Timeless pieces made to stay in rotation, season after season."
    },

    {
      "type": "text",
      "id": "resort_heading",
      "label": "The Resort Heading",
      "default": "Discover The Classic"
    },

    {
      "type": "textarea",
      "id": "resort_description",
      "label": "The Resort Description",
      "default": "Refined essentials that bring effortless ease to everyday dressing."
    },

    {
      "type": "text",
      "id": "default_heading",
      "label": "Default Heading",
      "default": "Explore More"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View Collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Top Padding",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 80,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Bottom Padding",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 90,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Top Padding",
      "min": 15,
      "max": 100,
      "step": 5,
      "default": 55,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Bottom Padding",
      "min": 15,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "px"
    }

  ],

  "presets": [
    {
      "name": "Recommended Collection"
    }
  ]

}

{% endschema %}