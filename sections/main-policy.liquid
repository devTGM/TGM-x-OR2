{% comment %}
  ON REPEAT — Main Policy Section (System Policy Pages)
  Renders system policy pages (/policies/*) with quiet luxury typography.
  For Shipping Policy, renders the complete ON REPEAT Shipping Policy.
{% endcomment %}

{% liquid
  assign is_shipping = false
  if request.path contains 'shipping'
    assign is_shipping = true
  elsif policy.title contains 'Shipping' or policy.title contains 'shipping'
    assign is_shipping = true
  endif
%}

{% if is_shipping %}
  {% render 'shipping-policy-content' %}
{% else %}
  <div class="shopify-policy__container or-policy-system-container">
    <div class="or-policy-system-wrapper">
      <header class="or-policy-system-header">
        <span class="or-policy-system-eyebrow">ON REPEAT · LEGAL & POLICIES</span>
        <h1 class="shopify-policy__title or-policy-system-title">{{ policy.title }}</h1>
        <div class="or-policy-system-divider" aria-hidden="true"></div>
      </header>

      <div class="shopify-policy__body rte or-policy-system-body">
        {% if policy.body != blank %}
          {{ policy.body }}
        {% else %}
          <p>This policy is currently being updated. Please contact our concierge team at <a href="mailto:linenonrepeat@gmail.com">linenonrepeat@gmail.com</a> for any questions.</p>
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    .or-policy-system-container {
      background-color: #FAF9F6;
      color: #1C1C1C;
      padding: clamp(48px, 6vw, 84px) clamp(16px, 4vw, 32px);
      min-height: 50vh;
      font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    }
    .or-policy-system-wrapper {
      max-width: 860px;
      margin: 0 auto;
      background: #FFFFFF;
      border: 1px solid rgba(28, 28, 28, 0.08);
      border-radius: 6px;
      padding: clamp(28px, 5vw, 48px);
      box-shadow: 0 2px 16px rgba(0, 0, 0, 0.02);
    }
    .or-policy-system-header {
      text-align: center;
      margin-bottom: clamp(28px, 4vw, 44px);
    }
    .or-policy-system-eyebrow {
      display: inline-block;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8C827A;
      margin-bottom: 12px;
    }
    .or-policy-system-title {
      font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
      font-size: clamp(2.25rem, 4.5vw, 3.25rem);
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #1C1C1C;
      margin: 0 0 16px 0;
    }
    .or-policy-system-divider {
      width: 48px;
      height: 1px;
      background-color: #C5A880;
      margin: 0 auto;
    }
    .or-policy-system-body {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: #3F3D39;
    }
    .or-policy-system-body p {
      margin-bottom: 1.25em;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Main Policy",
  "tag": "section",
  "class": "section-main-policy",
  "settings": []
}
{% endschema %}
