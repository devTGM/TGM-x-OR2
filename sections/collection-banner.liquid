{%- liquid
  assign desktop_image = blank
  if section.settings.image_desktop != blank
    assign desktop_image = section.settings.image_desktop
  elsif section.settings.image != blank
    assign desktop_image = section.settings.image
  elsif section.settings.show_collection_image and collection.image != blank
    assign desktop_image = collection.image
  elsif collection.image != blank
    assign desktop_image = collection.image
  endif

  assign mobile_image = blank
  if section.settings.image_mobile != blank
    assign mobile_image = section.settings.image_mobile
  elsif collection.metafields.custom.mobile_image != blank
    assign mobile_image = collection.metafields.custom.mobile_image
  elsif collection.metafields.custom.mobile_banner != blank
    assign mobile_image = collection.metafields.custom.mobile_banner
  endif

  assign banner_ratio_desktop = section.settings.banner_ratio_desktop | default: section.settings.banner_ratio | default: '2/1'
  assign banner_ratio_mobile = section.settings.banner_ratio_mobile | default: section.settings.banner_ratio | default: '2/1'

  assign d_parts = banner_ratio_desktop | split: '/'
  assign d_w = d_parts[0] | times: 1.0
  assign d_h = d_parts[1] | times: 1.0
  if banner_ratio_desktop == 'adapt' and desktop_image != blank
    assign desktop_ratio_css = desktop_image.aspect_ratio
  elsif d_w > 0 and d_h > 0
    assign desktop_ratio_css = d_parts[0] | append: ' / ' | append: d_parts[1]
  else
    assign desktop_ratio_css = '2 / 1'
  endif

  assign m_parts = banner_ratio_mobile | split: '/'
  assign m_w = m_parts[0] | times: 1.0
  assign m_h = m_parts[1] | times: 1.0
  if banner_ratio_mobile == 'adapt'
    if mobile_image != blank
      assign mobile_ratio_css = mobile_image.aspect_ratio
      assign mobile_pct = 1 | divided_by: mobile_image.aspect_ratio | times: 100
    elsif desktop_image != blank
      assign mobile_ratio_css = desktop_image.aspect_ratio
      assign mobile_pct = 1 | divided_by: desktop_image.aspect_ratio | times: 100
    else
      assign mobile_ratio_css = '2 / 1'
      assign mobile_pct = 50
    endif
  elsif m_w > 0 and m_h > 0
    assign mobile_ratio_css = m_parts[0] | append: ' / ' | append: m_parts[1]
    assign mobile_pct = m_h | divided_by: m_w | times: 100
  else
    assign mobile_ratio_css = '2 / 1'
    assign mobile_pct = 50
  endif

  assign desktop_pos = section.settings.image_position_desktop | default: section.settings.image_position | default: 'center'
  assign mobile_pos = section.settings.image_position_mobile | default: section.settings.image_position | default: 'center'
-%}

{%- style -%}
  .collection-banner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Ensure collection banner at page top sits completely flush at top: 0 with zero white gap */
  #MainContent > .shopify-section:first-child .collection-banner-{{ section.id }},
  #MainContent > .shopify-section:first-of-type .collection-banner-{{ section.id }},
  .content-for-layout > .shopify-section:first-child .collection-banner-{{ section.id }},
  .content-for-layout > .shopify-section:first-of-type .collection-banner-{{ section.id }},
  body:has(#header-component[transparent]) .collection-banner-{{ section.id }},
  body:has(#header-component[transparent]) .collection-banner__container,
  body:has(#header-component[transparent]) .collection-banner__media-wrapper,
  body.template-collection .collection-banner-{{ section.id }},
  body.template-collection .collection-banner__container,
  body.template-collection .collection-banner__media-wrapper,
  .collection-banner-{{ section.id }} .collection-banner__container,
  .collection-banner-{{ section.id }} .collection-banner__media-wrapper {
    margin-top: 0 !important;
    margin-block-start: 0 !important;
    --margin-block-start: 0px !important;
    --section-top-offset: 0px !important;
  }

  #MainContent > .shopify-section:first-child .collection-banner-{{ section.id }},
  #MainContent > .shopify-section:first-of-type .collection-banner-{{ section.id }},
  .content-for-layout > .shopify-section:first-child .collection-banner-{{ section.id }},
  body:has(#header-component[transparent]) .collection-banner-{{ section.id }},
  body.template-collection .collection-banner-{{ section.id }} {
    padding-top: 0 !important;
    padding-block-start: 0 !important;
    --padding-block-start: 0px !important;
  }

  .collection-banner-{{ section.id }}.page-width,
  .collection-banner-{{ section.id }} .page-width {
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding-inline: var(--page-margin, clamp(16px, 4vw, 40px));
    width: 100%;
    box-sizing: border-box;
  }

  .collection-banner-{{ section.id }} .collection-banner__container {
    width: 100%;
    margin-inline: auto;
  }

  .collection-banner-{{ section.id }} .collection-banner__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ mobile_ratio_css }};
    min-height: {{ mobile_pct }}vw;
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  @media screen and (min-width: 750px) {
    .collection-banner-{{ section.id }} .collection-banner__media-wrapper {
      aspect-ratio: {{ desktop_ratio_css }};
      min-height: unset;
      height: auto;
    }
  }

  .collection-banner-{{ section.id }} .collection-banner__picture,
  .collection-banner-{{ section.id }} .collection-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    object-position: {{ mobile_pos }};
    display: block;
  }

  @media screen and (min-width: 750px) {
    .collection-banner-{{ section.id }} .collection-banner__image {
      object-position: {{ desktop_pos }};
    }
  }

  .collection-banner-{{ section.id }} .collection-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    {%- if section.settings.toggle_overlay -%}
      background: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {%- else -%}
      display: none;
    {%- endif -%}
  }

  .collection-banner-{{ section.id }} .collection-banner__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: clamp(16px, 4vw, 40px);
    color: {{ section.settings.text_color | default: '#ffffff' }};
    pointer-events: none;
  }

  .collection-banner-{{ section.id }} .collection-banner__content--center {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .collection-banner-{{ section.id }} .collection-banner__content--bottom-left {
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
  }

  .collection-banner-{{ section.id }} .collection-banner__content--bottom-center {
    justify-content: flex-end;
    align-items: center;
    text-align: center;
  }

  .collection-banner-{{ section.id }} .collection-banner__content--top-left {
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
  }

  .collection-banner-{{ section.id }} .collection-banner__title {
    margin: 0;
    color: inherit;
    line-height: 1.15;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
    word-break: break-word;
  }

  .collection-banner-{{ section.id }} .collection-banner__description {
    margin: 8px 0 0 0;
    max-width: 680px;
    color: inherit;
    opacity: 0.92;
    line-height: 1.45;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    font-size: clamp(0.85rem, 2vw, 1.05rem);
  }

  .collection-banner-{{ section.id }} .collection-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #232323 0%, #111111 100%);
  }
{%- endstyle -%}

<div class="collection-banner-{{ section.id }} collection-banner disable-section-top-offset {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
  <div class="collection-banner__container">
    <div class="collection-banner__media-wrapper">
      {%- if desktop_image != blank or mobile_image != blank -%}
        {%- if mobile_image != blank and desktop_image != blank -%}
          <picture class="collection-banner__picture">
            <source
              media="(max-width: 749px)"
              srcset="
                {%- for width in '400,600,800,1000,1200,1600' | split: ',' -%}
                  {{ mobile_image | image_url: width: width }} {{ width }}w{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
            {{
              desktop_image
              | image_url: width: 3840
              | image_tag:
                class: 'collection-banner__image',
                widths: '600, 800, 1200, 1600, 2000, 2600, 3200, 3840',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: collection.title | escape
            }}
          </picture>
        {%- elsif mobile_image != blank -%}
          {{
            mobile_image
            | image_url: width: 2400
            | image_tag:
              class: 'collection-banner__image',
              widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: collection.title | escape
          }}
        {%- elsif desktop_image != blank -%}
          {{
            desktop_image
            | image_url: width: 3840
            | image_tag:
              class: 'collection-banner__image',
              widths: '600, 800, 1200, 1600, 2000, 2600, 3200, 3840',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: collection.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        <div class="collection-banner__placeholder"></div>
      {%- endif -%}

      <div class="collection-banner__overlay" aria-hidden="true"></div>

      {%- if section.settings.show_title or section.settings.show_description -%}
        <div class="collection-banner__content collection-banner__content--{{ section.settings.content_position | default: 'center' }}">
          {%- if section.settings.show_title and collection.title != blank -%}
            <{{ section.settings.heading_size | default: 'h1' }} class="collection-banner__title">
              {{ collection.title }}
            </{{ section.settings.heading_size | default: 'h1' }}>
          {%- endif -%}

          {%- if section.settings.show_description and collection.description != blank -%}
            <div class="collection-banner__description rte">
              {{ collection.description }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "class": "collection-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Upload an image specifically for desktop screens. Leave blank to use the collection's featured image."
    },
    {
      "type": "select",
      "id": "banner_ratio_desktop",
      "label": "Desktop aspect ratio",
      "options": [
        {
          "value": "2/1",
          "label": "2:1 (Recommended)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image ratio"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "3/1",
          "label": "3:1"
        }
      ],
      "default": "2/1",
      "info": "Aspect ratio of the banner on desktop screens (750px+)"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Desktop image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit style",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill entire banner)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit full image without crop)"
        }
      ],
      "default": "cover",
      "info": "For 2:1 images with 2:1 ratio, Cover displays 100% of the image perfectly."
    },
    {
      "type": "header",
      "content": "Mobile Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Upload a different image specifically for mobile screens. Leave blank to automatically use the desktop image."
    },
    {
      "type": "select",
      "id": "banner_ratio_mobile",
      "label": "Mobile aspect ratio",
      "options": [
        {
          "value": "2/1",
          "label": "2:1 (Recommended)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image ratio"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "1/1",
          "label": "1:1 (Square)"
        },
        {
          "value": "4/5",
          "label": "4:5 (Portrait)"
        }
      ],
      "default": "2/1",
      "info": "Aspect ratio of the banner on mobile screens"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Fallback & Legacy Options"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Use collection featured image as desktop fallback",
      "info": "When no custom desktop image is uploaded, use the featured image set in Products > Collections.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Legacy custom image",
      "info": "Kept for backwards compatibility"
    },
    {
      "type": "select",
      "id": "banner_ratio",
      "label": "Legacy aspect ratio fallback",
      "options": [
        {
          "value": "2/1",
          "label": "2:1"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "3/1",
          "label": "3:1"
        }
      ],
      "default": "2/1"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Legacy image position fallback",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content and text"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title heading size",
      "options": [
        {
          "value": "h1",
          "label": "Large (H1)"
        },
        {
          "value": "h2",
          "label": "Medium (H2)"
        },
        {
          "value": "h3",
          "label": "Small (H3)"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Enable readability overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout and sizing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
