{% doc %}
  Fabric Education Section ("Why Linen?") for ON REPEAT
  Complies with Notion brand guidelines for linen texture, air, and softness.
{% enddoc %}

{% liquid
  assign bg_color = section.settings.background_color | default: settings.color_palette.background | default: '#FAF8F5'
  assign text_color = section.settings.text_color | default: settings.color_palette.foreground | default: '#1C1C1C'
  assign card_bg = section.settings.card_background | default: '#FFFFFF'
%}

<section
  class="fabric-education-section"
  style="
    --fabric-edu-bg: {{ bg_color }};
    --fabric-edu-color: {{ text_color }};
    --fabric-edu-card-bg: {{ card_bg }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="fabric-education-container">
    <div class="fabric-education-header">
      {% if section.settings.overline != blank %}
        <span class="fabric-education-overline">{{ section.settings.overline }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="fabric-education-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="fabric-education-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="fabric-education-grid">
      <!-- Pillar 1: Breathable -->
      <div class="fabric-pillar-card">
        <div class="fabric-pillar-icon-box">
          <svg class="fabric-pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.8 5.7C10.7 2.5 6.7 3.4 5.2 6.5c-1.3 2.7-.4 6 2.3 7.5"></path>
            <path d="M17.5 7.5c2.3 2.3 2.5 6 .4 8.5-2.2 2.6-6.3 3-9.1.8"></path>
            <path d="M8 18c2 2 5.5 2 7.5 0s2-5.5 0-7.5"></path>
          </svg>
        </div>
        <h3 class="fabric-pillar-title">{{ section.settings.card_1_title }}</h3>
        <p class="fabric-pillar-text">{{ section.settings.card_1_text }}</p>
      </div>

      <!-- Pillar 2: Durable -->
      <div class="fabric-pillar-card">
        <div class="fabric-pillar-icon-box">
          <svg class="fabric-pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <h3 class="fabric-pillar-title">{{ section.settings.card_2_title }}</h3>
        <p class="fabric-pillar-text">{{ section.settings.card_2_text }}</p>
      </div>

      <!-- Pillar 3: Natural Fibre -->
      <div class="fabric-pillar-card">
        <div class="fabric-pillar-icon-box">
          <svg class="fabric-pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <h3 class="fabric-pillar-title">{{ section.settings.card_3_title }}</h3>
        <p class="fabric-pillar-text">{{ section.settings.card_3_text }}</p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fabric-education-section {
    background-color: var(--fabric-edu-bg);
    color: var(--fabric-edu-color);
    width: 100%;
    position: relative;
  }

  .fabric-education-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  .fabric-education-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px auto;
  }

  .fabric-education-overline {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8C827A;
    margin-bottom: 12px;
    display: inline-block;
  }

  .fabric-education-heading {
    font-family: var(--font-heading--family), 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.2rem, 3.4vw, 2.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--fabric-edu-color);
    margin: 0 0 14px 0;
  }

  .fabric-education-subheading {
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: #635E59;
    line-height: 1.6;
    margin: 0;
  }

  .fabric-education-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .fabric-pillar-card {
    background: var(--fabric-edu-card-bg);
    border: 1px solid #EAE6DF;
    border-radius: 16px;
    padding: 36px 28px;
    text-align: left;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fabric-pillar-card:hover {
    transform: translateY(-4px);
    border-color: #D6D0C5;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.04);
  }

  .fabric-pillar-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #F4F1EA;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: #2D2A26;
  }

  .fabric-pillar-icon {
    width: 24px;
    height: 24px;
  }

  .fabric-pillar-title {
    font-family: var(--font-heading--family), 'Cormorant Garamond', Georgia, serif;
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.3;
    color: #1C1C1C;
    margin: 0 0 12px 0;
  }

  .fabric-pillar-text {
    font-family: var(--font-body--family), 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #55504A;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .fabric-education-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 540px;
      margin: 0 auto;
    }
    .fabric-education-header {
      margin-bottom: 36px;
    }
    .fabric-pillar-card {
      padding: 28px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fabric Education",
  "tag": "section",
  "class": "section-fabric-education",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "FABRIC INNOVATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Linen?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nature's most intelligent fibre, designed for effortless warmth and tropical comfort."
    },
    {
      "type": "header",
      "content": "Pillar 1: Breathable"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Card 1 Title",
      "default": "Naturally Breathable"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Card 1 Text",
      "default": "Hollow linen fibres allow continuous airflow, regulating your body temperature so you stay naturally cooler in the sun."
    },
    {
      "type": "header",
      "content": "Pillar 2: Durable"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Card 2 Title",
      "default": "Durable & Ever-Softening"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Card 2 Text",
      "default": "Three times stronger than cotton. Linen resists fraying and actually grows softer, more supple, and more luxurious with every wash."
    },
    {
      "type": "header",
      "content": "Pillar 3: Natural Fibre"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Card 3 Title",
      "default": "100% Pure Natural Flax"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Card 3 Text",
      "default": "Crafted from European flax with gentle environmental impact. Hypoallergenic, antibacterial, and completely kind to sensitive skin."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Fabric Education"
    }
  ]
}
{% endschema %}
