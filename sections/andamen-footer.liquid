<footer id="andamen-footer-{{ section.id }}" class="andamen-footer">

  <div class="andamen-footer__grid">

    <!-- CONTACT -->
    <div class="andamen-footer__column contact-column">

      <div class="footer-heading">
        {{ section.settings.contact_heading }}
      </div>

      {% if section.settings.whatsapp != blank %}
        <a
          href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}"
          class="footer-contact"
          target="_blank"
          rel="noopener"
        >
          <span class="footer-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M20 11.5a8.5 8.5 0 0 1-12.9 7.2L4 20l1.3-3A8.5 8.5 0 1 1 20 11.5Z"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="M9.1 8.2c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.7c-.1.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.7-.6c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5v.5c0 .3-.1.5-.3.7-.4.4-1 .6-1.6.5-1.1-.2-2.4-.9-3.6-2-1.2-1-2.2-2.3-2.8-3.5-.4-.8-.6-1.6-.4-2.1.1-.1.2-.3.4-.5Z"
                stroke="currentColor"
                stroke-width="1.2"
              />
            </svg>
          </span>

          <span>
            <strong>Whatsapp Us</strong>
            <small>{{ section.settings.contact_hours }}</small>
          </span>
        </a>
      {% endif %}


      {% if section.settings.phone != blank %}
        <a
          href="tel:{{ section.settings.phone | remove: ' ' }}"
          class="footer-contact"
        >
          <span class="footer-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M6.5 3.8 9 3l2 4.4-1.8 1.5a15.2 15.2 0 0 0 5.9 5.9l1.5-1.8 4.4 2-.8 2.5c-.3 1-1.3 1.6-2.3 1.5C10.6 18.3 5.7 13.4 5 6.1c-.1-1 .5-2 1.5-2.3Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <span>
            <strong>Call Us</strong>
            <small>{{ section.settings.phone }}</small>
            <small>{{ section.settings.contact_hours }}</small>
          </span>
        </a>
      {% endif %}


      {% if section.settings.email != blank %}
        <a
          href="mailto:{{ section.settings.email }}"
          class="footer-contact"
        >
          <span class="footer-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <rect
                x="3.2"
                y="5.5"
                width="17.6"
                height="13"
                rx="1"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="m4 7 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>
          </span>

          <span>
            <strong>Email Us</strong>
            <small>{{ section.settings.contact_hours }}</small>
          </span>
        </a>
      {% endif %}


      <div class="footer-heading social-heading">
        {{ section.settings.social_heading }}
      </div>


      <div class="footer-socials">

        {% if section.settings.facebook != blank %}
          <a
            href="{{ section.settings.facebook }}"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="M13.6 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.5-1.5h1.7V4c-.3 0-1.3-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.1H8v3h2.6v8h3Z"
              />
            </svg>
          </a>
        {% endif %}


        {% if section.settings.instagram != blank %}
          <a
            href="{{ section.settings.instagram }}"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none">
              <rect
                x="4"
                y="4"
                width="16"
                height="16"
                rx="4"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <circle
                cx="12"
                cy="12"
                r="3.5"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <circle
                cx="17.2"
                cy="6.8"
                r="1"
                fill="currentColor"
              />
            </svg>
          </a>
        {% endif %}


        {% if section.settings.linkedin != blank %}
          <a
            href="{{ section.settings.linkedin }}"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="M6 8.5A1.5 1.5 0 1 0 6 5a1.5 1.5 0 0 0 0 3.5ZM4.7 19h2.6v-8.2H4.7V19ZM9 10.8V19h2.6v-4.5c0-1.2.2-2.4 1.8-2.4 1.5 0 1.5 1.4 1.5 2.5V19h2.6v-5c0-2.5-.5-4.4-3.4-4.4-1.4 0-2.3.8-2.7 1.4h-.1v-1.2H9Z"
              />
            </svg>
          </a>
        {% endif %}

      </div>

    </div>


    <!-- SHOP -->
    <div class="footer-menu">

      <div class="footer-heading">
        {{ section.settings.shop_heading }}
      </div>

      {% if section.settings.shop_menu != blank %}
        <ul>
          {% for link in section.settings.shop_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>


    <!-- INFO -->
    <div class="footer-menu">

      <div class="footer-heading">
        {{ section.settings.info_heading }}
      </div>

      {% if section.settings.info_menu != blank %}
        <ul>
          {% for link in section.settings.info_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>


    <!-- MANAGE -->
    <div class="footer-menu">

      <div class="footer-heading">
        {{ section.settings.manage_heading }}
      </div>

      {% if section.settings.manage_menu != blank %}
        <ul>
          {% for link in section.settings.manage_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>


    <!-- CLUB ANDAMEN -->
    <div class="footer-membership">

      <h2>
        {{ section.settings.membership_heading }}
      </h2>

      <div class="membership-description">
        {{ section.settings.membership_description }}
      </div>

      {% if section.settings.membership_link != blank %}

        <a
          href="{{ section.settings.membership_link }}"
          class="membership-button"
        >
          <span>
            {{ section.settings.membership_button }}
          </span>

          <span class="membership-arrow">
            →
          </span>
        </a>

      {% endif %}

    </div>

  </div>


  <!-- COPYRIGHT -->

  <div class="footer-bottom">

    <div>
      {{ section.settings.copyright }}
    </div>

  </div>

</footer>


<style>

  #andamen-footer-{{ section.id }} {

    --footer-bg: {{ section.settings.footer_background }};
    --footer-panel: {{ section.settings.membership_background }};
    --footer-text: {{ section.settings.footer_text }};
    --footer-muted: {{ section.settings.footer_muted }};
    --footer-border: {{ section.settings.footer_border }};

    background: var(--footer-bg);
    color: var(--footer-text);

    width: 100%;

    font-family: inherit;

  }


  /* ==============================================
     MAIN GRID
  ============================================== */

  #andamen-footer-{{ section.id }}
  .andamen-footer__grid {

    display: grid;

    grid-template-columns:
      1.1fr
      .72fr
      .82fr
      .82fr
      1.65fr;

    min-height: 410px;

  }


  /* ==============================================
     COMMON COLUMNS
  ============================================== */

  #andamen-footer-{{ section.id }}
  .contact-column,
  #andamen-footer-{{ section.id }}
  .footer-menu {

    padding: 76px 36px 55px;

  }


  #andamen-footer-{{ section.id }}
  .contact-column {

    padding-left: 5vw;

  }


  /* ==============================================
     HEADINGS
  ============================================== */

  #andamen-footer-{{ section.id }}
  .footer-heading {

    margin-bottom: 22px;

    color: var(--footer-muted);

    font-size: 13px;

    line-height: 1.2;

    letter-spacing: .2em;

    text-transform: uppercase;

  }


  /* ==============================================
     CONTACT
  ============================================== */

  #andamen-footer-{{ section.id }}
  .footer-contact {

    display: flex;

    align-items: flex-start;

    gap: 13px;

    margin-bottom: 20px;

    color: var(--footer-text);

    text-decoration: none;

  }


  #andamen-footer-{{ section.id }}
  .footer-icon {

    width: 25px;

    min-width: 25px;

    height: 25px;

  }


  #andamen-footer-{{ section.id }}
  .footer-icon svg {

    width: 25px;

    height: 25px;

    display: block;

  }


  #andamen-footer-{{ section.id }}
  .footer-contact strong {

    display: block;

    font-size: 16px;

    font-weight: 400;

    line-height: 1.4;

  }


  #andamen-footer-{{ section.id }}
  .footer-contact small {

    display: block;

    color: var(--footer-muted);

    font-size: 14px;

    line-height: 1.9;

    font-style: italic;

  }


  /* ==============================================
     SOCIAL
  ============================================== */

  #andamen-footer-{{ section.id }}
  .social-heading {

    margin-top: 43px;

    margin-bottom: 13px;

  }


  #andamen-footer-{{ section.id }}
  .footer-socials {

    display: flex;

    align-items: center;

    gap: 30px;

  }


  #andamen-footer-{{ section.id }}
  .footer-socials a {

    width: 27px;

    height: 27px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--footer-text);

  }


  #andamen-footer-{{ section.id }}
  .footer-socials svg {

    width: 26px;

    height: 26px;

  }


  /* ==============================================
     MENUS
  ============================================== */

  #andamen-footer-{{ section.id }}
  .footer-menu ul {

    list-style: none;

    padding: 0;

    margin: 0;

  }


  #andamen-footer-{{ section.id }}
  .footer-menu li {

    margin-bottom: 17px;

  }


  #andamen-footer-{{ section.id }}
  .footer-menu a {

    color: var(--footer-text);

    text-decoration: none;

    font-size: 16px;

    line-height: 1.35;

    transition: opacity .2s ease;

  }


  #andamen-footer-{{ section.id }}
  .footer-menu a:hover {

    opacity: .55;

  }


  /* ==============================================
     MEMBERSHIP PANEL
  ============================================== */

  #andamen-footer-{{ section.id }}
  .footer-membership {

    display: flex;

    flex-direction: column;

    justify-content: center;

    padding: 65px 5vw;

    background: var(--footer-panel);

  }


  #andamen-footer-{{ section.id }}
  .footer-membership h2 {

    max-width: 500px;

    margin: 0 0 27px;

    color: var(--footer-text);

    font-size: clamp(28px, 2.1vw, 40px);

    line-height: 1.28;

    font-weight: 300;

    letter-spacing: -.025em;

  }


  #andamen-footer-{{ section.id }}
  .membership-description {

    max-width: 520px;

    margin-bottom: 24px;

    color: var(--footer-text);

    font-size: 17px;

    line-height: 1.55;

  }


  #andamen-footer-{{ section.id }}
  .membership-description p {

    margin: 0;

  }


  #andamen-footer-{{ section.id }}
  .membership-button {

    display: flex;

    align-items: center;

    justify-content: space-between;

    width: 296px;

    min-height: 63px;

    padding: 0 22px 0 40px;

    border: 1px solid var(--footer-text);

    color: var(--footer-text);

    text-decoration: none;

    font-size: 13px;

    letter-spacing: .22em;

    text-transform: uppercase;

    transition:
      background .25s ease,
      color .25s ease;

  }


  #andamen-footer-{{ section.id }}
  .membership-button:hover {

    background: var(--footer-text);

    color: var(--footer-panel);

  }


  #andamen-footer-{{ section.id }}
  .membership-arrow {

    font-size: 20px;

    letter-spacing: 0;

  }


  /* ==============================================
     COPYRIGHT
  ============================================== */

  #andamen-footer-{{ section.id }}
  .footer-bottom {

    min-height: 92px;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 20px 30px;

    border-top: 1px solid var(--footer-border);

    color: var(--footer-muted);

    font-size: 15px;

    text-align: center;

  }


  /* ==============================================
     TABLET
  ============================================== */

  @media screen and (max-width: 1100px) {

    #andamen-footer-{{ section.id }}
    .andamen-footer__grid {

      grid-template-columns:
        1fr
        1fr
        1fr;

    }


    #andamen-footer-{{ section.id }}
    .footer-membership {

      grid-column: 1 / -1;

      min-height: 320px;

    }

  }


  /* ==============================================
     MOBILE
  ============================================== */

  @media screen and (max-width: 749px) {

    #andamen-footer-{{ section.id }}
    .andamen-footer__grid {

      display: block;

      min-height: 0;

    }


    #andamen-footer-{{ section.id }}
    .contact-column,
    #andamen-footer-{{ section.id }}
    .footer-menu {

      padding: 42px 24px 30px;

    }


    #andamen-footer-{{ section.id }}
    .contact-column {

      padding-top: 48px;

    }


    #andamen-footer-{{ section.id }}
    .footer-menu {

      border-top: 1px solid var(--footer-border);

    }


    #andamen-footer-{{ section.id }}
    .footer-membership {

      min-height: 350px;

      padding: 55px 24px;

    }


    #andamen-footer-{{ section.id }}
    .footer-membership h2 {

      font-size: 29px;

    }


    #andamen-footer-{{ section.id }}
    .membership-description {

      font-size: 15px;

    }


    #andamen-footer-{{ section.id }}
    .membership-button {

      width: 100%;

      max-width: 340px;

      min-height: 58px;

      padding-left: 24px;

    }


    #andamen-footer-{{ section.id }}
    .footer-bottom {

      min-height: 75px;

      padding: 18px 24px;

      font-size: 13px;

    }

  }

</style>


