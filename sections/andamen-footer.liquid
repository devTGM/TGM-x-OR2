{% comment %}
  ON REPEAT — Premium Dark Footer

  Brand direction:
  - Deep Olive Charcoal
  - Deep Muted Green
  - Ivory
  - Warm Beige
  - Muted Olive
  - Mango typography

  Fully responsive Shopify section.
{% endcomment %}

<footer
  id="on-repeat-footer-{{ section.id }}"
  class="on-repeat-footer"
  style="
    --or-footer-bg: {{ section.settings.footer_bg }};
    --or-footer-panel: {{ section.settings.panel_bg }};
    --or-footer-accent: {{ section.settings.accent_color }};
    --or-footer-text: {{ section.settings.text_color }};
    --or-footer-muted: {{ section.settings.muted_color }};
    --or-footer-border: {{ section.settings.border_color }};
    --or-footer-button-bg: {{ section.settings.button_bg }};
    --or-footer-button-text: {{ section.settings.button_text }};
  "
>

  <div class="or-footer-main">

    <!-- =====================================================
         CONTACT
         ===================================================== -->

    <div class="or-footer-column or-footer-contact">

      {% if section.settings.contact_heading != blank %}
        <h3 class="or-footer-heading">
          {{ section.settings.contact_heading }}
        </h3>
      {% endif %}


      {% if section.settings.whatsapp != blank %}

        <a
          href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}"
          class="or-contact-item"
          target="_blank"
          rel="noopener"
        >

          <span class="or-contact-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.55 0 .23 5.31.23 11.84c0 2.09.55 4.13 1.59 5.93L.13 24l6.37-1.67a11.83 11.83 0 0 0 5.58 1.42h.01c6.53 0 11.84-5.31 11.84-11.84 0-3.17-1.23-6.14-3.43-8.41ZM12.09 21.72h-.01a9.82 9.82 0 0 1-5.01-1.37l-.36-.21-3.78.99 1.01-3.68-.23-.38a9.82 9.82 0 0 1-1.5-5.23C2.21 6.42 6.64 2 12.09 2c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.83-9.88 9.83Zm5.4-7.37c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.53.08-.81.38-.28.3-1.06 1.03-1.06 2.51s1.09 2.91 1.24 3.11c.15.2 2.14 3.27 5.18 4.58.72.31 1.29.5 1.73.64.73.23 1.39.2 1.91.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="or-contact-copy">
            <strong>WhatsApp Us</strong>

            {% if section.settings.contact_hours != blank %}
              <small>{{ section.settings.contact_hours }}</small>
            {% endif %}
          </span>

        </a>

      {% endif %}


      {% if section.settings.phone != blank %}

        <a
          href="tel:{{ section.settings.phone | remove: ' ' }}"
          class="or-contact-item"
        >

          <span class="or-contact-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="or-contact-copy">
            <strong>Call Us</strong>
            <small>{{ section.settings.phone }}</small>

            {% if section.settings.contact_hours != blank %}
              <small>{{ section.settings.contact_hours }}</small>
            {% endif %}
          </span>

        </a>

      {% endif %}


      {% if section.settings.email != blank %}

        <a
          href="mailto:{{ section.settings.email }}"
          class="or-contact-item"
        >

          <span class="or-contact-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="or-contact-copy">
            <strong>Email Us</strong>
            <small>{{ section.settings.email }}</small>
          </span>

        </a>

      {% endif %}


      <!-- SOCIAL -->

      {% if section.settings.social_heading != blank %}
        <h3 class="or-footer-heading or-social-heading">
          {{ section.settings.social_heading }}
        </h3>
      {% endif %}


      <div class="or-social-links">

        {% if section.settings.instagram != blank %}
          <a
            href="{{ section.settings.instagram }}"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <circle
                cx="12"
                cy="12"
                r="4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <circle
                cx="17.5"
                cy="6.5"
                r="1"
                fill="currentColor"
              />
            </svg>
          </a>
        {% endif %}


        {% if section.settings.facebook != blank %}
          <a
            href="{{ section.settings.facebook }}"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24">
              <path
                d="M14 8h3V4h-3c-2.76 0-5 2.24-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.55.45-1 1-1Z"
                fill="currentColor"
              />
            </svg>
          </a>
        {% endif %}


        {% if section.settings.linkedin != blank %}
          <a
            href="{{ section.settings.linkedin }}"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24">
              <path
                d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.75 7.1 2.05 2.05 0 0 0 4.75 3ZM21 13.84c0-3.76-2-5.51-4.67-5.51-2.15 0-3.11 1.18-3.65 2v-1.83H9.18V21h3.5v-6.19c0-1.63.31-3.2 2.32-3.2 1.98 0 2.01 1.85 2.01 3.31V21H21v-7.16Z"
                fill="currentColor"
              />
            </svg>
          </a>
        {% endif %}

      </div>

    </div>


    <!-- =====================================================
         SHOP
         ===================================================== -->

    <div class="or-footer-column or-footer-menu">

      {% if section.settings.shop_heading != blank %}
        <h3 class="or-footer-heading">
          {{ section.settings.shop_heading }}
        </h3>
      {% endif %}

      {% if section.settings.shop_menu != blank %}

        <ul>
          {% for link in section.settings.shop_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>

      {% endif %}

    </div>


    <!-- =====================================================
         INFO
         ===================================================== -->

    <div class="or-footer-column or-footer-menu">

      {% if section.settings.info_heading != blank %}
        <h3 class="or-footer-heading">
          {{ section.settings.info_heading }}
        </h3>
      {% endif %}

      {% if section.settings.info_menu != blank %}

        <ul>
          {% for link in section.settings.info_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>

      {% endif %}

    </div>


    <!-- =====================================================
         MANAGE
         ===================================================== -->

    <div class="or-footer-column or-footer-menu">

      {% if section.settings.manage_heading != blank %}
        <h3 class="or-footer-heading">
          {{ section.settings.manage_heading }}
        </h3>
      {% endif %}

      {% if section.settings.manage_menu != blank %}

        <ul>
          {% for link in section.settings.manage_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>

      {% endif %}

    </div>


    <!-- =====================================================
         BRAND / NEWSLETTER PANEL
         ===================================================== -->

    <div class="or-footer-panel">

      {% if section.settings.panel_eyebrow != blank %}
        <div class="or-panel-eyebrow">
          {{ section.settings.panel_eyebrow }}
        </div>
      {% endif %}


      {% if section.settings.panel_heading != blank %}

        <h2>
          {{ section.settings.panel_heading }}
        </h2>

      {% endif %}


      {% if section.settings.panel_text != blank %}

        <div class="or-panel-description">
          {{ section.settings.panel_text }}
        </div>

      {% endif %}


      {% if section.settings.newsletter_enable %}

        {% form 'customer', class: 'or-newsletter-form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <div class="or-newsletter-field">

            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder }}"
              required
              autocomplete="email"
            >

            <button type="submit">
              {{ section.settings.subscribe_button }}
            </button>

          </div>


          {% if form.posted_successfully? %}

            <p class="or-form-message">
              {{ section.settings.success_message }}
            </p>

          {% endif %}


          {% if form.errors %}

            <div class="or-form-message">
              {{ form.errors | default_errors }}
            </div>

          {% endif %}

        {% endform %}

      {% endif %}


      {% if section.settings.panel_button_text != blank and section.settings.panel_button_link != blank %}

        <a
          href="{{ section.settings.panel_button_link }}"
          class="or-panel-button"
        >

          <span>
            {{ section.settings.panel_button_text }}
          </span>

          <span class="or-panel-arrow">
            →
          </span>

        </a>

      {% endif %}

    </div>

  </div>


  <!-- =====================================================
       BOTTOM FOOTER
       ===================================================== -->

  <div class="or-footer-bottom">

    <div class="or-footer-bottom-inner">

      <div class="or-copyright">
        {{ section.settings.copyright }}
      </div>


      {% if section.settings.show_policy_links %}

        <div class="or-legal-links">

          {% if shop.privacy_policy != blank %}
            <a href="{{ shop.privacy_policy.url }}">
              Privacy Policy
            </a>
          {% endif %}

          {% if shop.refund_policy != blank %}
            <a href="{{ shop.refund_policy.url }}">
              Refund Policy
            </a>
          {% endif %}

          {% if shop.terms_of_service != blank %}
            <a href="{{ shop.terms_of_service.url }}">
              Terms
            </a>
          {% endif %}

          {% if shop.shipping_policy != blank %}
            <a href="{{ shop.shipping_policy.url }}">
              Shipping
            </a>
          {% endif %}

        </div>

      {% endif %}

    </div>

  </div>

</footer>


<style>

  /* =========================================================
     ON REPEAT FOOTER
     ========================================================= */

  #on-repeat-footer-{{ section.id }} {

    --or-font:
      "Mango",
      "Mango Grotesk",
      "Helvetica Neue",
      Arial,
      sans-serif;

    font-family: var(--or-font);

    background: var(--or-footer-bg);

    color: var(--or-footer-text);

    width: 100%;

    overflow: hidden;

  }


  /* =========================================================
     MAIN GRID
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-main {

    display: grid;

    grid-template-columns:
      1.2fr
      0.78fr
      0.78fr
      0.78fr
      1.65fr;

    min-height: 450px;

    border-top: 1px solid var(--or-footer-border);

  }


  /* =========================================================
     COLUMNS
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-column {

    padding: 66px 32px 58px;

    border-right: 1px solid var(--or-footer-border);

  }


  #on-repeat-footer-{{ section.id }} .or-footer-contact {

    padding-left: clamp(30px, 5vw, 82px);

  }


  /* =========================================================
     HEADINGS
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-heading {

    margin: 0 0 30px;

    font-family: var(--or-font);

    font-size: 11px;

    font-weight: 500;

    line-height: 1.2;

    letter-spacing: 0.2em;

    text-transform: uppercase;

    color: var(--or-footer-muted);

  }


  /* =========================================================
     CONTACT
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-contact-item {

    display: flex;

    align-items: flex-start;

    gap: 14px;

    margin-bottom: 23px;

    color: var(--or-footer-text);

    text-decoration: none;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-contact-item:hover {

    opacity: 0.72;

    transform: translateX(3px);

  }


  #on-repeat-footer-{{ section.id }} .or-contact-icon {

    width: 20px;

    height: 20px;

    flex: 0 0 20px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-top: 1px;

    color: var(--or-footer-accent);

  }


  #on-repeat-footer-{{ section.id }} .or-contact-icon svg {

    width: 18px;

    height: 18px;

    display: block;

  }


  #on-repeat-footer-{{ section.id }} .or-contact-copy {

    display: flex;

    flex-direction: column;

    gap: 4px;

  }


  #on-repeat-footer-{{ section.id }} .or-contact-copy strong {

    font-family: var(--or-font);

    font-size: 14px;

    font-weight: 500;

    line-height: 1.4;

  }


  #on-repeat-footer-{{ section.id }} .or-contact-copy small {

    font-family: var(--or-font);

    font-size: 12px;

    font-weight: 400;

    line-height: 1.4;

    color: var(--or-footer-muted);

  }


  /* =========================================================
     SOCIAL
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-social-heading {

    margin-top: 52px;

    margin-bottom: 18px;

  }


  #on-repeat-footer-{{ section.id }} .or-social-links {

    display: flex;

    align-items: center;

    gap: 15px;

  }


  #on-repeat-footer-{{ section.id }} .or-social-links a {

    width: 30px;

    height: 30px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--or-footer-text);

    text-decoration: none;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-social-links a:hover {

    opacity: 0.65;

    transform: translateY(-2px);

  }


  #on-repeat-footer-{{ section.id }} .or-social-links svg {

    width: 18px;

    height: 18px;

    display: block;

  }


  /* =========================================================
     MENU
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-menu ul {

    list-style: none;

    padding: 0;

    margin: 0;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-menu li {

    margin: 0 0 15px;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-menu a {

    position: relative;

    display: inline-block;

    color: var(--or-footer-text);

    text-decoration: none;

    font-family: var(--or-font);

    font-size: 14px;

    font-weight: 400;

    line-height: 1.5;

    transition: opacity 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-menu a::after {

    content: "";

    position: absolute;

    left: 0;

    bottom: -4px;

    width: 0;

    height: 1px;

    background: var(--or-footer-accent);

    transition: width 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-menu a:hover {

    opacity: 0.75;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-menu a:hover::after {

    width: 100%;

  }


  /* =========================================================
     RIGHT PANEL
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-panel {

    background: var(--or-footer-panel);

    padding: 64px clamp(30px, 4vw, 68px);

    display: flex;

    flex-direction: column;

    justify-content: center;

  }


  #on-repeat-footer-{{ section.id }} .or-panel-eyebrow {

    margin-bottom: 20px;

    color: var(--or-footer-accent);

    font-size: 10px;

    font-weight: 500;

    letter-spacing: 0.2em;

    text-transform: uppercase;

  }


  #on-repeat-footer-{{ section.id }} .or-footer-panel h2 {

    margin: 0;

    max-width: 500px;

    font-family: var(--or-font);

    font-size: clamp(30px, 2.5vw, 45px);

    font-weight: 400;

    line-height: 1.12;

    letter-spacing: -0.025em;

    color: var(--or-footer-text);

  }


  #on-repeat-footer-{{ section.id }} .or-panel-description {

    max-width: 430px;

    margin-top: 21px;

    color: var(--or-footer-muted);

    font-size: 14px;

    line-height: 1.7;

  }


  /* =========================================================
     NEWSLETTER
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-newsletter-form {

    width: 100%;

    max-width: 460px;

    margin-top: 28px;

  }


  #on-repeat-footer-{{ section.id }} .or-newsletter-field {

    display: flex;

    width: 100%;

    border-bottom: 1px solid var(--or-footer-border);

  }


  #on-repeat-footer-{{ section.id }} .or-newsletter-field input {

    min-width: 0;

    flex: 1;

    height: 50px;

    padding: 0;

    border: 0;

    outline: 0;

    background: transparent;

    color: var(--or-footer-text);

    font-family: var(--or-font);

    font-size: 13px;

  }


  #on-repeat-footer-{{ section.id }} .or-newsletter-field input::placeholder {

    color: var(--or-footer-muted);

    opacity: 0.8;

  }


  #on-repeat-footer-{{ section.id }} .or-newsletter-field button {

    border: 0;

    padding: 0 4px;

    background: transparent;

    color: var(--or-footer-text);

    font-family: var(--or-font);

    font-size: 10px;

    font-weight: 500;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    cursor: pointer;

  }


  #on-repeat-footer-{{ section.id }} .or-form-message {

    margin: 12px 0 0;

    color: var(--or-footer-muted);

    font-size: 12px;

    line-height: 1.5;

  }


  /* =========================================================
     BUTTON
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-panel-button {

    width: 100%;

    max-width: 330px;

    min-height: 59px;

    margin-top: 28px;

    padding: 0 22px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    border: 1px solid var(--or-footer-accent);

    background: var(--or-footer-button-bg);

    color: var(--or-footer-button-text);

    text-decoration: none;

    font-family: var(--or-font);

    font-size: 10px;

    font-weight: 500;

    letter-spacing: 0.16em;

    text-transform: uppercase;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-panel-button:hover {

    background: transparent;

    color: var(--or-footer-text);

    border-color: var(--or-footer-text);

  }


  #on-repeat-footer-{{ section.id }} .or-panel-arrow {

    font-size: 20px;

    line-height: 1;

    transition: transform 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-panel-button:hover .or-panel-arrow {

    transform: translateX(5px);

  }


  /* =========================================================
     BOTTOM
     ========================================================= */

  #on-repeat-footer-{{ section.id }} .or-footer-bottom {

    border-top: 1px solid var(--or-footer-border);

  }


  #on-repeat-footer-{{ section.id }} .or-footer-bottom-inner {

    min-height: 82px;

    padding: 20px clamp(30px, 5vw, 82px);

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

  }


  #on-repeat-footer-{{ section.id }} .or-copyright {

    color: var(--or-footer-muted);

    font-size: 11px;

    line-height: 1.5;

  }


  #on-repeat-footer-{{ section.id }} .or-legal-links {

    display: flex;

    flex-wrap: wrap;

    justify-content: flex-end;

    gap: 22px;

  }


  #on-repeat-footer-{{ section.id }} .or-legal-links a {

    color: var(--or-footer-muted);

    text-decoration: none;

    font-size: 11px;

    transition: opacity 0.25s ease;

  }


  #on-repeat-footer-{{ section.id }} .or-legal-links a:hover {

    opacity: 0.6;

  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 1100px) {

    #on-repeat-footer-{{ section.id }} .or-footer-main {

      grid-template-columns:
        1.15fr
        0.8fr
        0.8fr;

    }


    #on-repeat-footer-{{ section.id }} .or-footer-panel {

      grid-column: 1 / -1;

      min-height: 340px;

      border-top: 1px solid var(--or-footer-border);

    }

  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #on-repeat-footer-{{ section.id }} .or-footer-main {

      display: block;

      min-height: auto;

    }


    #on-repeat-footer-{{ section.id }} .or-footer-column {

      padding: 42px 24px;

      border-right: 0;

      border-bottom: 1px solid var(--or-footer-border);

    }


    #on-repeat-footer-{{ section.id }} .or-footer-contact {

      padding-left: 24px;

    }


    #on-repeat-footer-{{ section.id }} .or-footer-heading {

      margin-bottom: 24px;

      font-size: 10px;

      letter-spacing: 0.18em;

    }


    #on-repeat-footer-{{ section.id }} .or-contact-item {

      margin-bottom: 20px;

    }


    #on-repeat-footer-{{ section.id }} .or-social-heading {

      margin-top: 40px;

    }


    #on-repeat-footer-{{ section.id }} .or-footer-menu {

      padding-top: 34px;

